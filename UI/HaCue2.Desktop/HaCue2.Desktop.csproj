<Project Sdk="Microsoft.NET.Sdk">

    <!-- Desktop head for HaCue2. A composition root and nothing else: it references its app library and
         supplies the platform bootstrap. See UI/HaCue2/HaCue2.csproj for why no framework references
         exist yet. -->

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RootNamespace>HaCue2.Desktop</RootNamespace>
        <!-- Not "HaCue2" (collides with the HaCue2 library's HaCue2.dll on case-insensitive filesystems)
             and not the "HaCue2.Desktop" project default (file managers mistake a *.Desktop binary for an
             XDG desktop entry — same rationale as HaPlay.Desktop → HaPlayer, HaViz.Desktop → HaVizBox).
             The plan's `hacue2` check CLI verb (D9, still draft) is a separate question from this
             binary's name. -->
        <AssemblyName>HaCue2Desktop</AssemblyName>
        <!-- IL2104 (trim) / IL3053 (AOT) are ILC's per-assembly *aggregate* "this assembly was not
             trim/AOT tested" warnings, raised only for third-party dependencies we cannot annotate. On
             win-x64 that is SharpGen.Runtime, which Avalonia's Win32 backend brings in: with repo-wide
             warnings-as-errors it turned the NativeAOT publish into `error IL2104` and took the whole
             artifact job down, while the same warning has always been merely visible on HaPlay.Desktop,
             which demotes the pair. Only IL2104 fires today; IL3053 is its AOT-side twin and travels with
             it. First-party libraries are IsAotCompatible, so a real regression there still surfaces as a
             *detailed* IL2xxx/IL3xxx code, which stays fatal (BUILD-03) - including the Mond IL2026 that
             HaPlay accepts and this app has no reason to. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <!-- SDL3's platform native runtimes are app-owned deployment assets: the framework libraries
             carry only the SDL3-CS binding so a packaged library never drags a native runtime in
             transitively. This head asks for an SDL3 GL context below, so it is the level that has to
             ship one — without these a publish contained no libSDL3 at all and the offscreen context
             silently fell back on every machine that had no system SDL3. Same pair as HaPlay.Desktop. -->
        <PackageReference Include="SDL3-CS.Linux"/>
        <PackageReference Include="SDL3-CS.Windows" GeneratePathProperty="true"/>
    </ItemGroup>

    <!-- FFmpeg 8.x native runtime (avcodec-62/avformat-62/…) as a NuGet native asset. win-x64 only:
         Linux takes FFmpeg from the system (or the CI-staged build). Kept at the final app level so no
         framework package carries a GPL native runtime. Without it a Windows publish had no decoder at
         all — every media cue would fail to open on the one platform that cannot fall back on a
         package manager. -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <PackageReference Include="FFmpeg.GPL"/>
    </ItemGroup>

    <!-- RID-less Windows build (IDE Debug/run): the native package only places SDL3.dll through
         runtimes/<rid>/native RID resolution, so copy it next to the app for the no-RID case. -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">
        <None Include="$(PkgSDL3-CS_Windows)\runtimes\win-x64\native\SDL3.dll" Visible="false">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>SDL3.dll</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HaCue2\HaCue2.csproj"/>
        <!-- The composition root chooses the audio backend: PortAudio and miniaudio see different
             devices on the same box, and which one a show is checked against is this layer's call. -->
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Audio.PortAudio\S.Media.Audio.PortAudio.csproj"/>
        <!-- The other local-audio backend, offered as an advanced machine setting. The two see
             different devices on the same box, so which one opens a sound card is a property of the
             rig — and a head is where that kind of choice belongs. -->
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Audio.MiniAudio\S.Media.Audio.MiniAudio.csproj"/>
        <!-- The offscreen GL context projectM renders on. A head's choice, like the audio backend:
             the engine asks for a context factory and does not care which windowing system provides
             it, and without one the frame-blit surface falls back to the compositor's own GL thread. -->
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Present.SDL3.Compositor\S.Media.Present.SDL3.Compositor.csproj"/>
    </ItemGroup>

</Project>
