<Project Sdk="Microsoft.NET.Sdk">

    <!-- Phase 5: the running show.

         Owns the ShowSession, the project audio patch bay and the program-audio target that joins
         them, and turns a HaCueProject into playback. Separate from HaCue2 (the UI) because a session
         is a long-lived, thread-affine, device-holding thing and the views must not be able to reach
         into it by accident — they see it through `Session/ShowRuntime`, exactly as they saw the
         sample before this existed.

         Separate from HaCue2.Machine too: that answers questions about the box without starting
         anything. This one opens devices. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>HaCue2.Engine</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- The route table's call counters are incremented by the server and read by the UI, so the
             increment is internal. The test suite drives it directly to prove counters are per-route
             rather than shared, which is the property a shared static would silently break. -->
        <InternalsVisibleTo Include="HaCue2.Core.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HaCue2.Core\HaCue2.Core.csproj" />
        <ProjectReference Include="..\HaCue2.Machine\HaCue2.Machine.csproj" />
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Session\S.Media.Session.csproj" />
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Routing\S.Media.Routing.csproj" />
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Decode.FFmpeg\S.Media.Decode.FFmpeg.csproj" />
        <!-- Record and stream outputs: file/URL encode sessions whose sinks the bay and the
             compositor attach to exactly like any other output. -->
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Encode.FFmpeg\S.Media.Encode.FFmpeg.csproj" />
        <!-- NDI outputs and lines: the sender exposes an IVideoOutput and an IAudioOutput, so it
             attaches exactly like a screen or an interface. -->
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.NDI\S.Media.NDI.csproj" />
        <!-- The other source families a cue can play: a capture device, a prepared YouTube asset, and
             a rendered text card. Each is a URI scheme with a decoder provider already written; the
             registry simply never had them. -->
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Audio.PortAudio\S.Media.Audio.PortAudio.csproj" />
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Source.YouTube\S.Media.Source.YouTube.csproj" />
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Source.Text\S.Media.Source.Text.csproj" />
        <!-- Action cues send OSC. MIDI out would need S.Control's device layer, which HaCue2 has not
             adopted yet — ActionSender refuses a MIDI endpoint out loud rather than pretending. -->
        <ProjectReference Include="..\..\MediaFramework\OSC\OSCLib\OSCLib.csproj" />
        <!-- Local-screen video outputs. HaPlay gets its IVideoOutputs from HaOutput/OutputManagement,
             which HaCue2 cannot reference; until that engine's HaPlay couplings are inverted, this
             opens its own windows. -->
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Present.SDL3\S.Media.Present.SDL3.csproj" />
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Present.SDL3.Compositor\S.Media.Present.SDL3.Compositor.csproj" />
        <!-- Cross-module host glue for FFmpeg/container/sidecar subtitles rendered through libass. -->
        <ProjectReference Include="..\..\MediaFramework\Interop\S.Media.Interop\S.Media.Interop.csproj" />
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Subtitles\S.Media.Subtitles.csproj" />
        <!-- Visualizer cues. A visualizer is not a clip: it has nothing to decode, so it attaches
             through the session's SetCompositionVisualizerAsync seam rather than the clip path. The
             native library is OPTIONAL at runtime — ProjectVisualizers reports a machine without it
             rather than firing onto a canvas that then stays black. -->
        <ProjectReference Include="..\..\MediaFramework\Media\S.Media.Visualizer.ProjectM\S.Media.Visualizer.ProjectM.csproj" />
        <!-- External input (register item 3). S.Control already owns MIDI/OSC device discovery,
             matching and hot-plug — the fiddly half — and is framework-clean, so HaCue2 consumes it
             rather than re-deriving a second device layer. HaControl.Input, which the plan names for
             this, lives on next-fix-enhance-round and is not on this branch. -->
        <ProjectReference Include="..\..\MediaFramework\Control\S.Control\S.Control.csproj" />
    </ItemGroup>

</Project>
