<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- These tests intentionally exercise reflection-based compatibility JSON overloads to prove legacy
             wire shapes. The shipped app uses source-generated contexts; trim/AOT warnings here do not describe
             production code and are narrowly baselined so every other clean-build warning remains visible. -->
        <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="Xunit.SkippableFact" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\MediaFramework\Control\S.Control\S.Control.csproj" />
        <ProjectReference Include="..\HaPlay\HaPlay.csproj" />
    </ItemGroup>

  <!-- FFmpeg 9.x natives (avcodec-63/avformat-63/…) for the Windows leg. Linux takes FFmpeg from the system
       or the CI-staged build; Windows has no package manager to fall back on, so without this every test in
       this project skips on win-x64 (see FFmpegNativeFactAttribute) — which is what CI was doing.
       Pinned via Directory.Packages.props, so it cannot drift from the FFmpeg.AutoGen soname the way the
       hand-rolled CI download did. Test projects build RID-less and the package places its DLLs only through
       runtimes/<rid>/native RID resolution, hence the explicit copy — the same shape the desktop heads use
       for SDL3's no-RID case. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="FFmpeg.GPL" GeneratePathProperty="true" />
    <None Include="$(PkgFFmpeg_GPL)\runtimes\win-x64\native\*.dll" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
