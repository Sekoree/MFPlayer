<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HaCue2.Controls"
             xmlns:sys="using:System"
             xmlns:v="using:HaCue2.Views"
             xmlns:vm="using:HaCue2.ViewModels"
             xmlns:m="using:HaCue2.Core.Model"
             x:Class="HaCue2.Views.VideoView"
             x:DataType="vm:VideoViewModel">

  <!-- Screens 09–10: Outputs · Compositions · Mapping · Audition.

       The tab order is the order of the WORK. An output is a piece of this machine — a screen, a
       sender, a recorder — and exists before any show is authored against it. A composition is a
       decision about the show, and choosing which outputs it feeds is where the two meet. Mapping is
       the fine adjustment between them, and there is nothing to adjust until both ends exist. -->

  <UserControl.Styles>
    <!-- Which canvas the FEEDS rail is assigning to. Every pane is open at once and each edits itself,
         so nothing else on the screen said which one the rail on the right belonged to — an operator
         could press + ASSIGN having read the name on a different pane. The app's own selection wash,
         the same one the cue list uses. -->
    <Style Selector="Border.canvas">
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.canvas.picked">
      <Setter Property="BorderBrush" Value="{DynamicResource GelGreen}" />
      <Setter Property="Background" Value="{DynamicResource CueSelectedWash}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Background="{DynamicResource BoothPanel}">
      <ListBox Grid.Column="0" Theme="{StaticResource SectionTabs}"
               Background="{DynamicResource BoothPanel}"
               ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SectionTab">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="1" BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1">
        <TextBlock Classes="mono dim3 micro" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="10,0" Text="{Binding TabHint}" />
      </Border>
    </Grid>

    <Panel>

      <!-- ══ OUTPUTS ════════════════════════════════════════════════════════════════════════
           First, because this is the pane an operator opens on a machine they have never used. It
           asks nothing about compositions: an output is created, then a composition is sent to it. -->
      <Grid IsVisible="{Binding IsOutputsPane}" ColumnDefinitions="*,360" Margin="7" ColumnSpacing="7">

        <c:PanelBox Grid.Column="0" Header="Video outputs" Hint="what this machine can put a picture on">
          <c:PanelBox.Footer>
            <Border Classes="chain">
              <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding CanAuthor}">
                <Button Classes="tight" Content="+ LOCAL…" Click="OnDialog" Tag="out:local" />
                <Button Classes="tight" Content="+ NDI…" Click="OnDialog" Tag="out:ndi" />
                <Button Classes="tight" Content="+ RECORD…" Click="OnDialog" Tag="out:record" />
                <Button Classes="tight" Content="+ STREAM…" Click="OnDialog" Tag="out:stream" />
                <Button Classes="tight" Content="RENAME…" Click="OnDialog" Tag="out:rename" />
                <Button Classes="tight" Content="REMOVE…" Click="OnDialog" Tag="out:remove" />
              </StackPanel>
            </Border>
          </c:PanelBox.Footer>
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource BoothPanel2}"
                    BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1" Padding="8,4">
              <Grid ColumnDefinitions="140,*,120,90,140" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Theme="{StaticResource ColumnHeadText}" Text="OUTPUT" />
                <TextBlock Grid.Column="1" Theme="{StaticResource ColumnHeadText}" Text="KIND" />
                <TextBlock Grid.Column="2" Theme="{StaticResource ColumnHeadText}" Text="SHOWS" />
                <TextBlock Grid.Column="3" Theme="{StaticResource ColumnHeadText}" Text="MAP" />
                <TextBlock Grid.Column="4" Theme="{StaticResource ColumnHeadText}" Text="STATE" />
              </Grid>
            </Border>
            <c:EmptyState IsVisible="{Binding HasNoOutputs}"
                          Headline="No video outputs"
                          Detail="{Binding OutputsEmptyDetail}" />
            <ListBox IsVisible="{Binding !HasNoOutputs}" Theme="{StaticResource TableRows}"
                     ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                     KeyDown="OnListKeyDown" Tag="out:remove"
                     PointerPressed="OnRowRightPressed">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Rename…" Click="OnDialog" Tag="out:rename" />
                  <MenuItem Header="Edit mapping" Click="OnEditMapping" />
                  <Separator />
                  <MenuItem Header="Remove…" Click="OnDialog" Tag="out:remove" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VideoOutputRow">
                  <Grid ColumnDefinitions="140,*,120,90,140" ColumnSpacing="8" Margin="8,5">
                    <TextBlock Grid.Column="0" Classes="mono small" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Classes="mono dim3 small ellipsis" Text="{Binding Kind}" />
                    <TextBlock Grid.Column="2" Classes="mono dim3 small ellipsis" Text="{Binding Shows}" />
                    <TextBlock Grid.Column="3" Classes="mono dim3 small" Text="{Binding Map}" />
                    <TextBlock Grid.Column="4" Classes="mono dim2 small" Text="{Binding State.Text}"
                               Classes.ok="{Binding State.IsGood}" Classes.warn="{Binding State.IsWarn}"
                               Classes.err="{Binding State.IsBad}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </c:PanelBox>

        <c:PanelBox Grid.Column="1" Header="{Binding SelectedOutputName}" Hint="selected output">
          <ScrollViewer>
            <StackPanel Margin="0,6,0,8" IsEnabled="{Binding HasOutput}">
              <!-- Read-only, and it names the pane that CHANGES it. Assignment belongs to the
                   composition, which is the end of the pair an operator is thinking about when they
                   decide where a canvas goes. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Shows">
                <TextBox Classes="ro" Text="{Binding OutputComposition}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Screen"
                                      IsVisible="{Binding IsOutputLocal}">
                <ComboBox ItemsSource="{Binding Screens}" SelectedIndex="{Binding OutputScreenIndex}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Mode"
                                      IsVisible="{Binding IsOutputLocal}">
                <ListBox Theme="{StaticResource Segment}" SelectedIndex="{Binding OutputFullscreenIndex}">
                  <ListBoxItem>fullscreen</ListBoxItem>
                  <ListBoxItem>windowed</ListBoxItem>
                </ListBox>
              </HeaderedContentControl>
              <!-- Only while windowed: a fullscreen output takes the screen's size, so the field
                   would be a control that does nothing. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Window size"
                                      IsVisible="{Binding IsOutputWindowed}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                  <TextBox Grid.Column="0" Text="{Binding OutputWindowSize}"
                           PlaceholderText="960×540 · empty takes the composition's size" />
                  <Button Grid.Column="1" Classes="icon" Content="▾"
                          ToolTip.Tip="Common sizes. Anything can still be typed.">
                    <Button.Flyout>
                      <Flyout>
                        <ItemsControl ItemsSource="{Binding Resolutions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                              <Button Classes="tight block" HorizontalAlignment="Stretch"
                                      Click="OnPickResolution" Tag="window" Content="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </HeaderedContentControl>
              <!-- The number a video wall is built from: mapping destinations are measured in it. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Output raster">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                  <TextBox Grid.Column="0" Text="{Binding OutputRaster}"
                           PlaceholderText="1920×1080 · empty follows the composition" />
                  <Button Grid.Column="1" Classes="icon" Content="▾"
                          ToolTip.Tip="Common sizes. Anything can still be typed.">
                    <Button.Flyout>
                      <Flyout>
                        <ItemsControl ItemsSource="{Binding Resolutions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                              <Button Classes="tight block" HorizontalAlignment="Stretch"
                                      Click="OnPickResolution" Tag="raster" Content="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </HeaderedContentControl>
              <!-- Idle images exist at both levels; the composition's wins when it has one
                   (register item 23), and black is what both fall back to. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Idle fallback">
                <TextBox Text="{Binding OutputIdleFallback}"
                         PlaceholderText="used when the composition has no idle image · black otherwise" />
              </HeaderedContentControl>
              <!-- A slate is rarely the canvas's own shape. Without a choice it was stretched, which
                   is the one option that always looks wrong on a logo. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Idle fit">
                <ComboBox ItemsSource="{Binding IdleFits}"
                          SelectedIndex="{Binding OutputIdleFitIndex}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Mapping">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <!-- A toggle, never a delete: switching to clean keeps the authored sections. -->
                  <ListBox Grid.Column="0" Theme="{StaticResource Segment}"
                           SelectedIndex="{Binding OutputMappingIndex}">
                    <ListBoxItem>on</ListBoxItem>
                    <ListBoxItem>clean</ListBoxItem>
                  </ListBox>
                  <Button Grid.Column="1" Classes="tight" Content="EDIT ›" Click="OnEditMapping" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Required">
                <CheckBox IsChecked="{Binding OutputRequired}"
                          Content="the show cannot run without this output" />
              </HeaderedContentControl>
              <ContentControl Theme="{StaticResource FieldWide}">
                <TextBlock Classes="mono dim3 small" TextWrapping="Wrap" Text="{Binding MappingNote}" />
              </ContentControl>
              <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding IsOutputLocal}">
                <Button Classes="block" Content="IDENTIFY — FLASH OUTPUT NAME ON SCREEN"
                        Click="OnIdentify" />
              </ContentControl>
              <!-- Held rather than shown in a dialog: IDENTIFY refuses for ordinary reasons, and a
                   modal for each of them is a modal nobody reads. -->
              <ContentControl Theme="{StaticResource FieldWide}"
                              IsVisible="{Binding OutputProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="mono small warn" TextWrapping="Wrap"
                           Text="{Binding OutputProblem}" />
              </ContentControl>

              <!-- Register item 30. The same editor the Audio view uses: a record output and a
                   record line hold the same block and answer the same questions. -->
              <StackPanel IsVisible="{Binding Record.IsRecording}">
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Directory"
                                        IsVisible="{Binding Record.IsFile}">
                  <TextBox Text="{Binding Record.Directory}"
                           PlaceholderText="the machine's recordings folder" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Pattern"
                                        IsVisible="{Binding Record.IsFile}">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <TextBox Grid.Column="0" Text="{Binding Record.Pattern}" />
                    <!-- {}-escaped: a value starting with "{" is otherwise read as a markup extension. -->
                    <Button Grid.Column="1" Classes="icon" Content="{}{ } ▾">
                      <Button.Flyout>
                        <Flyout>
                          <ItemsControl ItemsSource="{Binding Record.Tokens}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="m:RecordPattern+RecordToken">
                                <Button Classes="tight block" HorizontalAlignment="Stretch"
                                        Click="OnInsertToken" Tag="{Binding Token}">
                                  <StackPanel>
                                    <TextBlock Classes="mono" Text="{Binding Token}" />
                                    <TextBlock Classes="mono dim3 micro" Text="{Binding Meaning}" />
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Grid.Column="2" Classes="icon" Content="?">
                      <Button.Flyout>
                        <Flyout>
                          <TextBlock Classes="mono dim3 micro" MaxWidth="320" TextWrapping="Wrap"
                                     Text="{Binding Record.TokenHelp}" />
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="URL"
                                        IsVisible="{Binding Record.IsStream}">
                  <TextBox Text="{Binding Record.Url}" PlaceholderText="rtmp://host/app/key" />
                </HeaderedContentControl>
                <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding Record.IsFile}">
                  <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding Record.Preview}" />
                </ContentControl>
                <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding Record.HasProblem}">
                  <TextBlock Classes="mono small" Foreground="{DynamicResource GelRed}"
                             TextWrapping="Wrap" Text="{Binding Record.Problem}" />
                </ContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Mode"
                                        IsVisible="{Binding Record.IsFile}">
                  <ListBox Theme="{StaticResource Segment}" SelectedIndex="{Binding Record.ModeIndex}">
                    <ListBoxItem>continuous</ListBoxItem>
                    <ListBoxItem>content only</ListBoxItem>
                  </ListBox>
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Format">
                  <TextBox Classes="ro" Text="{Binding Record.FormatSummary}" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Arm">
                  <CheckBox IsChecked="{Binding Record.ArmWithShow}" Content="arm when the show opens" />
                </HeaderedContentControl>
                <ContentControl Theme="{StaticResource FieldWide}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <Button Grid.Column="0" Classes="primary" Content="{Binding Record.ArmLabel}"
                            Click="OnToggleRecorder" />
                    <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text="{Binding Record.Readout}" />
                  </Grid>
                </ContentControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </c:PanelBox>
      </Grid>

      <!-- ══ COMPOSITIONS ═══════════════════════════════════════════════════════════════════
           A composition owns exactly size, frame rate and idle image, plus the list of outputs it
           feeds. There is no visualizer flag: a visualizer is a cue type, and the one on the Cyc
           canvas below is simply that cue's placement (register item 21). -->
      <Grid IsVisible="{Binding IsCompositionsPane}" ColumnDefinitions="*,360" Margin="7" ColumnSpacing="7">

        <!-- One EXPANDER per composition, each carrying its own editor. A single shared editor pane
             driven by a click on a pane that gave no sign it was selectable stopped scaling at the
             second canvas — and a show with a projector and a stream has two on day one. Collapsing
             is what makes six of them manageable; the header keeps the name, size and feed count
             visible while closed, so the list still answers "what is on this rig" at a glance. -->
        <DockPanel Grid.Column="0">

          <!-- ADD / REMOVE at the foot, exactly where the outputs pane puts them. -->
          <Border DockPanel.Dock="Bottom" Classes="chain">
            <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding CanAuthor}">
              <Button Classes="tight" Content="+ ADD…" Click="OnDialog" Tag="composition" />
              <Button Classes="tight" Content="REMOVE…" Click="OnDialog" Tag="composition:remove"
                      IsEnabled="{Binding HasComposition}" />
              <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                         Text="remove takes the composition the last-touched pane belongs to" />
            </StackPanel>
          </Border>

          <ScrollViewer>
            <Panel>
              <c:EmptyState IsVisible="{Binding HasNoCompositions}"
                            Headline="No compositions"
                            Detail="A composition is a canvas cues are placed on. Add one below, then send it to an output." />
              <ItemsControl IsVisible="{Binding !HasNoCompositions}" ItemsSource="{Binding Compositions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="7" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompositionPaneViewModel">
                    <Border Classes="canvas" Classes.picked="{Binding IsSelected}">
                    <Expander IsExpanded="True" HorizontalAlignment="Stretch"
                              PointerPressed="OnSelectComposition">
                      <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="mono" FontWeight="SemiBold" Text="{Binding Name}"
                                       VerticalAlignment="Center" />
                            <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                                       Text="{Binding Hint}" />
                            <!-- Which screen the rail beside this canvas is describing, on the canvas
                                 itself: the rail names one output and six panes can be open at once. -->
                            <TextBlock Classes="mono small ok" VerticalAlignment="Center"
                                       Text="{Binding SelectionNote}" />
                          </StackPanel>
                          <!-- Kept in the header so a collapsed composition still says who receives
                               it: a canvas feeding nothing looks identical to one feeding three
                               projectors, which is the most expensive thing to discover at a get-in. -->
                          <TextBlock Grid.Column="1" Classes="mono dim3 small" VerticalAlignment="Center"
                                     Text="{Binding LayoutSummary}" />
                        </Grid>
                      </Expander.Header>

                      <StackPanel Spacing="6"
                                  IsEnabled="{Binding $parent[v:VideoView].((vm:VideoViewModel)DataContext).CanAuthor}">

                        <!-- The OUTPUT LAYOUT, and the EDITOR of it rather than a picture of one:
                             which screen covers which part of this canvas, where two overlap and
                             where nothing does, dragged here.

                             It used to be a read-only illustration, with the real editor behind an
                             EDIT › button in the rail beside it that opened a full-screen pane over
                             this one drawing the same rectangles. Two surfaces claiming to be the
                             layout, and the one an operator was looking at was the one that did
                             nothing when dragged. There is one now. -->
                        <!-- No GuidesX/GuidesY here, deliberately. They ARE this canvas's own slice
                             edges, so once it became editable every drag found a guide exactly where
                             the dragged edge already was and snapped to itself — which is a snap that
                             can never reach anything else. The canvas derives its guides from the
                             other boxes and skips the one being dragged, which is the same feature
                             done correctly. The pane's guides remain what a CUE placement snaps to. -->
                        <c:AspectBox Margin="10,8" VerticalAlignment="Top" Ratio="{Binding Aspect}">
                          <c:PlacementCanvas Boxes="{Binding OutputBoxes}"
                                             AutomationProperties.Name="Composition output layout"
                                             PreserveAspect="{Binding PreserveAspect}"
                                             SnapEnabled="{Binding SnapEnabled}"
                                             AllowOutside="True"
                                             Gesture="OnLayoutGesture"
                                             GestureCompleted="OnGestureCompleted"
                                             BoxSelected="OnLayoutOutputSelected" />
                        </c:AspectBox>

                        <WrapPanel Margin="10,0" ItemSpacing="12" LineSpacing="4">
                          <CheckBox Content="preserve aspect" IsChecked="{Binding PreserveAspect}" />
                          <CheckBox Content="snap + guides" IsChecked="{Binding SnapEnabled}" />
                          <Button Classes="tight" Content="SIZE BY RASTER" Click="OnResolutionLayout"
                                  ToolTip.Tip="Lay out every screen at its output resolution, left to right." />
                        </WrapPanel>

                        <TextBlock Margin="10,0" Classes="mono dim3 micro" TextWrapping="Wrap"
                                   Text="Drag anywhere inside to move; grab any edge or corner to resize. Overhang remains visible. Shift temporarily reverses aspect lock; Alt suspends guides." />

                        <HeaderedContentControl Theme="{StaticResource Field}" Header="Name">
                          <TextBox Text="{Binding EditName}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Theme="{StaticResource Field}" Header="Size / rate">
                          <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="4">
                            <TextBox Grid.Column="0" Text="{Binding Size}" />
                            <Button Grid.Column="1" Classes="icon" Content="▾"
                                    ToolTip.Tip="Common sizes, this machine's screens first. Anything can still be typed.">
                              <Button.Flyout>
                                <Flyout>
                                  <ItemsControl ItemsSource="{Binding Resolutions}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="sys:String">
                                        <Button Classes="tight block" HorizontalAlignment="Stretch"
                                                Click="OnPickResolution" Tag="composition" Content="{Binding}" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </Flyout>
                              </Button.Flyout>
                            </Button>
                            <TextBox Grid.Column="2" Text="{Binding Rate}" />
                          </Grid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Theme="{StaticResource Field}" Header="Idle image">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding IdleImage}" PlaceholderText="black" />
                            <Button Grid.Column="1" Classes="tight" Content="BROWSE…" Click="OnBrowseIdleImage" />
                          </Grid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Theme="{StaticResource Field}" Header="Idle fit">
                          <ComboBox ItemsSource="{Binding IdleFits}" SelectedIndex="{Binding IdleFitIndex}" />
                        </HeaderedContentControl>

                        <Border Classes="chain">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="badge"><TextBlock Text="FEEDS" /></Border>
                            <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                                       IsVisible="{Binding HasNoFeeds}"
                                       Text="no output shows this canvas — assign one on the right" />
                            <ItemsControl ItemsSource="{Binding Feeds}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CompositionFeedRow">
                                  <TextBlock Classes="mono small" VerticalAlignment="Center"
                                             Classes.ok="{Binding IsLive}" Classes.warn="{Binding !IsLive}"
                                             Text="{Binding Name}" ToolTip.Tip="{Binding State}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Expander>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
        </DockPanel>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="7">

          <!-- The name, size, rate and idle image moved onto each composition's own pane, where they
               belong: they are properties OF that canvas, and editing them through a selection meant
               the fields could describe a different composition from the one being looked at.

               What is left here is the half of the layout a drag cannot deliver. A canvas alone
               cannot hit exactly half, which is the number a two-projector wall is made of, so the
               slice a screen takes is typable as well as draggable — and a slice and the screen it
               lands on are two different sizes, which is why the raster sits beside it: half of a
               1920×2160 stacked canvas is still a 1920×1080 projector. -->
          <c:PanelBox Grid.Row="0" Header="{Binding SelectedOutputName}" Hint="selected screen">
            <Panel>
              <c:EmptyState IsVisible="{Binding !HasScreenSelected}"
                            Headline="No screen selected"
                            Detail="{Binding LayoutSummary}" />

              <StackPanel Margin="0,6,0,8" IsVisible="{Binding HasScreenSelected}">
                <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Slice x / y">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <NumericUpDown Grid.Column="0" Minimum="0" Maximum="1" Increment="0.01"
                                   FormatString="0.###" Value="{Binding SliceX}" />
                    <NumericUpDown Grid.Column="1" Minimum="0" Maximum="1" Increment="0.01"
                                   FormatString="0.###" Value="{Binding SliceY}" />
                  </Grid>
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Slice w / h">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <NumericUpDown Grid.Column="0" Minimum="0.01" Maximum="1" Increment="0.01"
                                   FormatString="0.###" Value="{Binding SliceWidth}" />
                    <NumericUpDown Grid.Column="1" Minimum="0.01" Maximum="1" Increment="0.01"
                                   FormatString="0.###" Value="{Binding SliceHeight}" />
                  </Grid>
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Output raster">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBox Grid.Column="0" Text="{Binding OutputRaster}"
                             PlaceholderText="1920×1080 · empty follows the composition" />
                    <Button Grid.Column="1" Classes="icon" Content="▾"
                            ToolTip.Tip="Common sizes. Anything can still be typed.">
                      <Button.Flyout>
                        <Flyout>
                          <ItemsControl ItemsSource="{Binding Resolutions}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="sys:String">
                                <Button Classes="tight block" HorizontalAlignment="Stretch"
                                        Click="OnPickResolution" Tag="raster" Content="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </HeaderedContentControl>
                <ContentControl Theme="{StaticResource FieldWide}">
                  <Border Classes="chain">
                    <Button Classes="tight" Content="WARP THIS SCREEN ›" Click="OnEditMapping"
                            ToolTip.Tip="Mesh, blend and per-section geometry for this output." />
                  </Border>
                </ContentControl>
              </StackPanel>
            </Panel>
          </c:PanelBox>

          <!-- The assignment pane. It is on the COMPOSITION rather than in the add-output dialog
               because an operator decides where a canvas goes once the canvas exists — and being
               asked which composition a brand-new output shows, on a project that has none, was the
               first question the old flow put in front of anybody. -->
          <!-- Named rather than "this composition": the panes are all open at once, so a rail that
               said "this" left the operator to work out which one it meant. -->
          <c:PanelBox Grid.Row="1" Header="Feeds" Hint="{Binding FeedsHint}">
            <c:PanelBox.Footer>
              <StackPanel>
                <Border Classes="chain">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AssignableOutputs}"
                              SelectedIndex="{Binding AssignableIndex}"
                              PlaceholderText="an output to send this canvas to" />
                    <Button Grid.Column="1" Classes="tight" Content="+ ASSIGN" Click="OnAssign"
                            IsEnabled="{Binding CanAssignOutput}" />
                  </Grid>
                </Border>
                <TextBlock Margin="10,6,10,8" Classes="mono dim3 micro" TextWrapping="Wrap"
                           IsVisible="{Binding AssignHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding AssignHint}" />
              </StackPanel>
            </c:PanelBox.Footer>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding SelectedCompositionFeeds}" Margin="4,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompositionFeedRow">
                    <Grid ColumnDefinitions="*,84,Auto" ColumnSpacing="6" Margin="6,3">
                      <TextBlock Grid.Column="0" Classes="mono small" VerticalAlignment="Center"
                                 Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="mono dim3 small" VerticalAlignment="Center"
                                 Classes.ok="{Binding IsLive}" Classes.warn="{Binding !IsLive}"
                                 Text="{Binding State}" />
                      <Button Grid.Column="2" Classes="icon" Content="×" Click="OnUnassign"
                              Tag="{Binding OutputId}"
                              ToolTip.Tip="Stop sending this composition to that output. The output stays." />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </c:PanelBox>
        </Grid>
      </Grid>

      <!-- ══ MAPPING ════════════════════════════════════════════════════════════════════════
           Always the mapping OF ONE OUTPUT: the same Cyc is warped for Projector A and clean for the
           lobby TV. Every geometry field is a number as well as a drag — a canvas alone cannot hit
           exactly half, which is the number a two-projector blend is made of.

           No longer a tab. It sits OVER the Outputs pane, opened from the output it belongs to and
           closed again — a top-level tab asked the operator to remember which output they were
           looking at while showing them a pane that did not say. -->
      <DockPanel IsVisible="{Binding IsMappingOpen}" Margin="7"
                 Background="{DynamicResource BoothBg}">

        <Border DockPanel.Dock="Top" Classes="chain" Margin="0,0,0,7">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
            <Border Grid.Column="0" Classes="badge"><TextBlock Text="MAPPING" /></Border>
            <TextBlock Grid.Column="1" Classes="mono small" VerticalAlignment="Center"
                       Text="{Binding MappingScopeNote}" />
            <ToggleButton Grid.Column="2" Classes="tight" Content="CALIBRATION GRID"
                          IsChecked="{Binding IsCalibrationOn}" Click="OnCalibration"
                          AutomationProperties.Name="Toggle persistent output calibration grid"
                          ToolTip.Tip="Shows orientation corners, a ten-by-ten warp grid and section boundaries on this output until the mapping editor closes." />
            <Button Grid.Column="3" Classes="tight" Content="✕ CLOSE" Click="OnCloseMapping"
                    AutomationProperties.Name="Close mapping editor" />
          </Grid>
        </Border>

        <!-- The splitter, at the top and across the width: it REPLACES the sections, so it is the
             first thing you do to an output and never something you reach for mid-adjustment. -->
        <Border DockPanel.Dock="Top" Classes="chain" Margin="0,0,0,7" IsEnabled="{Binding HasOutput}">
          <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" Text="Split into" />
              <NumericUpDown Width="92" Minimum="1" Maximum="64" Increment="1" FormatString="0"
                             Value="{Binding SplitColumns}" />
              <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" Text="cols ×" />
              <NumericUpDown Width="92" Minimum="1" Maximum="64" Increment="1" FormatString="0"
                             Value="{Binding SplitRows}" />
              <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" Text="rows" />
              <Button Classes="tight" Content="SPLIT" Click="OnDialog" Tag="section:split"
                      ToolTip.Tip="Replaces every section with an even grid, one per panel — then nudge each into place. This is how you hit exactly half." />
            </StackPanel>
            <Button Classes="tight" Content="RESET" Click="OnDialog" Tag="section:reset"
                    ToolTip.Tip="Back to one section showing the whole canvas across the whole output" />
            <CheckBox Content="preserve aspect" IsChecked="{Binding PreserveMappingAspect}" />
            <CheckBox Content="snap + guides" IsChecked="{Binding SnapMapping}" />
            <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{Binding RasterNote}" />
          </WrapPanel>
        </Border>

        <Grid ColumnDefinitions="252,*,*" ColumnSpacing="7">

          <c:PanelBox Grid.Column="0" Header="Sections" Hint="list order is draw order">
            <c:PanelBox.Footer>
              <Border Classes="chain">
                <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                  <Button Classes="tight" Content="+" Click="OnDialog" Tag="section"
                          ToolTip.Tip="Add a section covering the whole frame" />
                  <Button Classes="tight" Content="COPY" Click="OnDialog" Tag="section:copy" />
                  <Button Classes="tight" Content="–" Click="OnDialog" Tag="section:delete"
                          ToolTip.Tip="Remove the selected section" />
                  <Button Classes="tight" Content="↑" Click="OnDialog" Tag="section:up"
                          ToolTip.Tip="Draw earlier — further back" />
                  <Button Classes="tight" Content="↓" Click="OnDialog" Tag="section:down"
                          ToolTip.Tip="Draw later — further front" />
                </WrapPanel>
              </Border>
            </c:PanelBox.Footer>
            <ListBox Theme="{StaticResource TableRows}" Margin="0,4"
                     ItemsSource="{Binding Sections}" SelectedIndex="{Binding SelectedSection}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MappingSectionRow">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="5" Margin="6,2">
                    <!-- Drawn or not, which is a different question from whether it exists: switching
                         one panel of a blend off to check the one beside it is an ordinary get-in
                         move, and deleting it would lose its geometry. -->
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                              ToolTip.Tip="Draw this section" />
                    <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                               Text="{Binding Position}" />
                    <TextBox Grid.Column="2" Classes="bare" Text="{Binding Name}" />
                    <TextBlock Grid.Column="3" Classes="mono dim3 micro" VerticalAlignment="Center"
                               IsVisible="{Binding HasWarp}" Text="{Binding Warp}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </c:PanelBox>

          <c:PanelBox Grid.Column="1" Header="Source · what it samples"
                      Hint="fractions of the composition">
            <DockPanel>
              <!-- The numeric half of register item 22. Source is in FRACTIONS because it has to
                   survive the composition being resized; destination is in OUTPUT PIXELS because
                   that is the number written on the back of the projector. -->
              <Border DockPanel.Dock="Bottom" Classes="chain" IsEnabled="{Binding HasSection}">
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="5" RowSpacing="4" Margin="2">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Src X" />
                  <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="-1" Maximum="2" Increment="0.01"
                                 FormatString="0.###" Value="{Binding SourceX}" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Src Y" />
                  <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="-1" Maximum="2" Increment="0.01"
                                 FormatString="0.###" Value="{Binding SourceY}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Src W" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0.001" Maximum="2" Increment="0.01"
                                 FormatString="0.###" Value="{Binding SourceWidth}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Src H" />
                  <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="0.001" Maximum="2" Increment="0.01"
                                 FormatString="0.###" Value="{Binding SourceHeight}" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Rot °" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="-360" Maximum="360" Increment="0.5"
                                 FormatString="0.##" Value="{Binding RotationDegrees}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Opacity" />
                  <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="1" Increment="0.05"
                                 FormatString="0.##" Value="{Binding Opacity}" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Bright" />
                  <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="2" Increment="0.05"
                                 FormatString="0.##" Value="{Binding Brightness}"
                                 ToolTip.Tip="Panel brightness matching — 1.00 is the projector's own" />
                  <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Classes="mono dim3 micro"
                             VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="drag on the canvas · type for exact values" />
                </Grid>
              </Border>
              <c:AspectBox Margin="10,8" VerticalAlignment="Top" Ratio="{Binding MappingSourceAspect}">
                <c:PlacementCanvas Boxes="{Binding MappingSource}"
                                   PreserveAspect="{Binding PreserveMappingAspect}"
                                   SnapEnabled="{Binding SnapMapping}"
                                   AutomationProperties.Name="Mapping source sections"
                                   Gesture="OnMappingSourceGesture"
                                   GestureCompleted="OnGestureCompleted"
                                   BoxSelected="OnSectionSelected" />
              </c:AspectBox>
            </DockPanel>
          </c:PanelBox>

          <c:PanelBox Grid.Column="2" Header="{Binding SectionHeader}"
                      Hint="where it lands · pixels of the output raster">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Classes="chain" IsEnabled="{Binding HasSection}">
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="5" RowSpacing="4" Margin="2">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Dest X" />
                  <NumericUpDown Grid.Row="0" Grid.Column="1" Increment="1" FormatString="0.#"
                                 Value="{Binding DestX}" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Dest Y" />
                  <NumericUpDown Grid.Row="0" Grid.Column="3" Increment="1" FormatString="0.#"
                                 Value="{Binding DestY}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Dest W" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Increment="1" FormatString="0.#"
                                 Value="{Binding DestWidth}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Dest H" />
                  <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="1" Increment="1" FormatString="0.#"
                                 Value="{Binding DestHeight}" />

                  <!-- Mesh cols and rows independently, rather than the old off · 3×3 · 5×5 picker:
                       panels are not square, and a blend across a flat cyc wants 5×2. -->
                  <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Mesh warp"
                            IsChecked="{Binding MeshEnabled}"
                            ToolTip.Tip="Bend this section through a control-point grid for a non-flat surface. GL output path only." />
                  <TextBlock Grid.Row="2" Grid.Column="2" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Cols" IsVisible="{Binding MeshEnabled}" />
                  <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="2" Maximum="16" Increment="1"
                                 FormatString="0" Value="{Binding MeshColumns}"
                                 IsVisible="{Binding MeshEnabled}" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="mono dim3 small"
                             VerticalAlignment="Center" Text="Rows" IsVisible="{Binding MeshEnabled}" />
                  <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="2" Maximum="16" Increment="1"
                                 FormatString="0" Value="{Binding MeshRows}"
                                 IsVisible="{Binding MeshEnabled}" />
                  <Button Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Classes="tight"
                          Content="RESET MESH" Click="OnDialog" Tag="mesh:reset"
                          IsVisible="{Binding MeshEnabled}"
                          ToolTip.Tip="Back to the flat identity grid, keeping its size" />

                  <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Spacing="4"
                              IsVisible="{Binding HasWarp}">
                    <c:WarpMeshCanvas Height="190" MinWidth="260"
                                      Columns="{Binding MeshColumns}" Rows="{Binding MeshRows}"
                                      Offsets="{Binding WarpOffsets}"
                                      SelectedIndex="{Binding SelectedWarpPoint}"
                                      PointMoved="OnWarpPointMoved"
                                      PointSelected="OnWarpPointSelected"
                                      GestureCompleted="OnWarpGestureCompleted"
                                      AutomationProperties.Name="Warp mesh editor"
                                      AutomationProperties.HelpText="Drag a control point. Arrow keys nudge; Shift plus arrow nudges coarsely." />
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="5">
                      <TextBlock Grid.Column="0" Classes="mono dim3 small" VerticalAlignment="Center"
                                 Text="Point" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                ItemsSource="{Binding WarpPoints}"
                                SelectedIndex="{Binding SelectedWarpPoint}" />
                      <TextBlock Grid.Column="2" Classes="mono dim3 small" VerticalAlignment="Center"
                                 Text="dx / dy" />
                      <Grid Grid.Column="3" ColumnDefinitions="*,*" ColumnSpacing="4">
                        <NumericUpDown Grid.Column="0" Minimum="-1" Maximum="1" Increment="0.005"
                                       FormatString="0.###" Value="{Binding WarpOffsetX}" />
                        <NumericUpDown Grid.Column="1" Minimum="-1" Maximum="1" Increment="0.005"
                                       FormatString="0.###" Value="{Binding WarpOffsetY}" />
                      </Grid>
                    </Grid>
                    <WrapPanel HorizontalAlignment="Center" ItemSpacing="4">
                      <Button Classes="icon" Content="←" Click="OnWarpNudge" Tag="left"
                              AutomationProperties.Name="Nudge warp point left" />
                      <Button Classes="icon" Content="↑" Click="OnWarpNudge" Tag="up"
                              AutomationProperties.Name="Nudge warp point up" />
                      <Button Classes="icon" Content="↓" Click="OnWarpNudge" Tag="down"
                              AutomationProperties.Name="Nudge warp point down" />
                      <Button Classes="icon" Content="→" Click="OnWarpNudge" Tag="right"
                              AutomationProperties.Name="Nudge warp point right" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>
              <c:AspectBox Margin="10,8" VerticalAlignment="Top" Ratio="{Binding MappingTargetAspect}">
                <!-- No grid on the output half: the reference here is the wall, not a nominal frame. -->
                <c:PlacementCanvas Boxes="{Binding MappingTarget}" ShowGrid="False"
                                   PreserveAspect="{Binding PreserveMappingAspect}"
                                   SnapEnabled="{Binding SnapMapping}"
                                   AutomationProperties.Name="Mapping destination sections"
                                   Gesture="OnMappingTargetGesture"
                                   GestureCompleted="OnGestureCompleted"
                                   BoxSelected="OnSectionSelected" />
              </c:AspectBox>
            </DockPanel>
          </c:PanelBox>
        </Grid>
      </DockPanel>

      <Panel IsVisible="{Binding IsAuditionPane}">
        <v:AuditionPane DataContext="{Binding Audition}" />
      </Panel>

    </Panel>
  </DockPanel>
</UserControl>
