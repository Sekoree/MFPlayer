<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HaCue2.Controls"
             xmlns:sys="using:System"
             xmlns:v="using:HaCue2.Views"
             xmlns:vm="using:HaCue2.ViewModels"
             xmlns:m="using:HaCue2.Core.Model"
             x:Class="HaCue2.Views.VideoView"
             x:DataType="vm:VideoViewModel">

  <!-- Screens 09–10: Compositions · Mapping · Outputs · Audition. -->

  <DockPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Background="{DynamicResource BoothPanel}">
      <ListBox Grid.Column="0" Theme="{StaticResource SectionTabs}"
               Background="{DynamicResource BoothPanel}"
               ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" />
      <Border Grid.Column="1" BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1">
        <TextBlock Classes="mono dim3 micro" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="10,0" Text="{Binding TabHint}" />
      </Border>
    </Grid>

    <Panel>

      <!-- ══ 09 · COMPOSITIONS ══════════════════════════════════════════════════════════════
           A composition owns exactly size, frame rate and idle image. There is no visualizer flag:
           a visualizer is a cue type, and the one on the Cyc canvas below is simply Q15.5's
           placement (register item 21). -->
      <Grid IsVisible="{Binding IsCompositionsPane}" ColumnDefinitions="*,360" Margin="7" ColumnSpacing="7">

        <!-- One pane per composition, at the composition's own aspect ratio. Two hard-coded panels
             would stop agreeing with the document the first time somebody added a third canvas. -->
        <ScrollViewer Grid.Column="0">
          <Panel>
          <c:EmptyState IsVisible="{Binding HasNoCompositions}"
                        Headline="No compositions"
                        Detail="A composition is a canvas cues are placed on. Add one on the right." />
          <ItemsControl IsVisible="{Binding !HasNoCompositions}" ItemsSource="{Binding Compositions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="7" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CompositionPaneViewModel">
                <c:PanelBox Header="{Binding Name}" Hint="{Binding Hint}">
                  <c:AspectBox Margin="10,8" VerticalAlignment="Top" Ratio="{Binding Aspect}">
                    <c:PlacementCanvas Boxes="{Binding Layers}"
                                       Gesture="OnLayerGesture"
                                       GestureCompleted="OnGestureCompleted" />
                  </c:AspectBox>
                </c:PanelBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </Panel>
        </ScrollViewer>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="7">

          <c:PanelBox Grid.Row="0" Header="Video outputs" Hint="what receives each composition">
            <c:PanelBox.Footer>
              <Border Classes="chain">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="tight" Content="+ LOCAL…" Click="OnDialog" Tag="out:local" />
                  <Button Classes="tight" Content="+ NDI…" Click="OnDialog" Tag="out:ndi" />
                  <Button Classes="tight" Content="+ RECORD…" Click="OnDialog" Tag="out:record" />
                  <Button Classes="tight" Content="+ STREAM…" Click="OnDialog" Tag="out:stream" />
                </StackPanel>
              </Border>
            </c:PanelBox.Footer>

            <DockPanel>
              <Border DockPanel.Dock="Top" Background="{DynamicResource BoothPanel2}"
                      BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1" Padding="8,4">
                <Grid ColumnDefinitions="82,*,40,62,76" ColumnSpacing="5">
                  <TextBlock Grid.Column="0" Theme="{StaticResource ColumnHeadText}" Text="OUTPUT" />
                  <TextBlock Grid.Column="1" Theme="{StaticResource ColumnHeadText}" Text="KIND" />
                  <TextBlock Grid.Column="2" Theme="{StaticResource ColumnHeadText}" Text="SHOWS" />
                  <TextBlock Grid.Column="3" Theme="{StaticResource ColumnHeadText}" Text="MAP" />
                  <TextBlock Grid.Column="4" Theme="{StaticResource ColumnHeadText}" Text="STATE" />
                </Grid>
              </Border>
              <ListBox Theme="{StaticResource TableRows}"
                       ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:VideoOutputRow">
                    <Grid ColumnDefinitions="82,*,40,62,76" ColumnSpacing="5" Margin="8,4">
                      <TextBlock Grid.Column="0" Classes="mono small" Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="mono dim3 small ellipsis" Text="{Binding Kind}" />
                      <TextBlock Grid.Column="2" Classes="mono dim3 small" Text="{Binding Shows}" />
                      <TextBlock Grid.Column="3" Classes="mono dim3 small" Text="{Binding Map}" />
                      <TextBlock Grid.Column="4" Classes="mono dim2 small" Text="{Binding State.Text}"
                                 Classes.ok="{Binding State.IsGood}" Classes.err="{Binding State.IsBad}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </c:PanelBox>

          <c:PanelBox Grid.Row="1" Header="{Binding SelectedOutputName}" Hint="selected output">
            <ScrollViewer>
              <StackPanel Margin="0,6,0,8">
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Composition">
                  <ComboBox ItemsSource="{Binding CompositionNames}"
                            SelectedIndex="{Binding OutputCompositionIndex}" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Screen">
                  <ComboBox ItemsSource="{Binding Screens}" SelectedIndex="{Binding OutputScreenIndex}" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Mode">
                  <ListBox Theme="{StaticResource Segment}" SelectedIndex="{Binding OutputFullscreenIndex}">
                    <ListBoxItem>fullscreen</ListBoxItem>
                    <ListBoxItem>windowed</ListBoxItem>
                  </ListBox>
                </HeaderedContentControl>
                <!-- Only while windowed: a fullscreen output takes the screen's size, so the field
                     would be a control that does nothing. -->
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Window size"
                                        IsVisible="{Binding IsOutputWindowed}">
                  <TextBox Text="{Binding OutputWindowSize}"
                           PlaceholderText="960×540 · empty takes the composition's size" />
                </HeaderedContentControl>
                <!-- Idle images exist at both levels; the composition's wins when it has one
                     (register item 23). -->
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Idle fallback">
                  <TextBox Text="{Binding OutputIdleFallback}"
                           PlaceholderText="used when the composition has no idle image" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Mapping">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <!-- A toggle, never a delete: switching to clean keeps the authored sections. -->
                    <ListBox Grid.Column="0" Theme="{StaticResource Segment}"
                             SelectedIndex="{Binding OutputMappingIndex}">
                      <ListBoxItem>on</ListBoxItem>
                      <ListBoxItem>clean</ListBoxItem>
                    </ListBox>
                    <Button Grid.Column="1" Classes="tight" Content="EDIT ›" Click="OnEditMapping" />
                  </Grid>
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Required">
                  <CheckBox IsChecked="{Binding OutputRequired}"
                            Content="the show cannot run without this output" />
                </HeaderedContentControl>
                <ContentControl Theme="{StaticResource FieldWide}">
                  <TextBlock Classes="mono dim3 small" TextWrapping="Wrap" Text="{Binding MappingNote}" />
                </ContentControl>
                <ContentControl Theme="{StaticResource FieldWide}">
                  <Button Classes="block" Content="IDENTIFY — FLASH OUTPUT NAME ON SCREEN"
                          Click="OnIdentify" />
                </ContentControl>
                <!-- Held rather than shown in a dialog: IDENTIFY refuses for ordinary reasons, and a
                     modal for each of them is a modal nobody reads. -->
                <ContentControl Theme="{StaticResource FieldWide}"
                                IsVisible="{Binding OutputProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Classes="mono small warn" TextWrapping="Wrap"
                             Text="{Binding OutputProblem}" />
                </ContentControl>

                <!-- Register item 30. The same editor the Audio view uses: a record output and a
                     record line hold the same block and answer the same questions. -->
                <StackPanel IsVisible="{Binding Record.IsRecording}">
                  <HeaderedContentControl Theme="{StaticResource Field}" Header="Directory"
                                          IsVisible="{Binding Record.IsFile}">
                    <TextBox Text="{Binding Record.Directory}"
                             PlaceholderText="the machine's recordings folder" />
                  </HeaderedContentControl>
                  <HeaderedContentControl Theme="{StaticResource Field}" Header="Pattern"
                                          IsVisible="{Binding Record.IsFile}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                      <TextBox Grid.Column="0" Text="{Binding Record.Pattern}" />
                      <!-- {}-escaped: a value starting with "{" is otherwise read as a markup extension. -->
                      <Button Grid.Column="1" Classes="icon" Content="{}{ } ▾">
                        <Button.Flyout>
                          <Flyout>
                            <ItemsControl ItemsSource="{Binding Record.Tokens}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:RecordPattern+RecordToken">
                                  <Button Classes="tight block" HorizontalAlignment="Stretch"
                                          Click="OnInsertToken" Tag="{Binding Token}">
                                    <StackPanel>
                                      <TextBlock Classes="mono" Text="{Binding Token}" />
                                      <TextBlock Classes="mono dim3 micro" Text="{Binding Meaning}" />
                                    </StackPanel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                      <Button Grid.Column="2" Classes="icon" Content="?">
                        <Button.Flyout>
                          <Flyout>
                            <TextBlock Classes="mono dim3 micro" MaxWidth="320" TextWrapping="Wrap"
                                       Text="{Binding Record.TokenHelp}" />
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </Grid>
                  </HeaderedContentControl>
                  <HeaderedContentControl Theme="{StaticResource Field}" Header="URL"
                                          IsVisible="{Binding Record.IsStream}">
                    <TextBox Text="{Binding Record.Url}" PlaceholderText="rtmp://host/app/key" />
                  </HeaderedContentControl>
                  <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding Record.IsFile}">
                    <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding Record.Preview}" />
                  </ContentControl>
                  <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding Record.HasProblem}">
                    <TextBlock Classes="mono small" Foreground="{DynamicResource GelRed}"
                               TextWrapping="Wrap" Text="{Binding Record.Problem}" />
                  </ContentControl>
                  <HeaderedContentControl Theme="{StaticResource Field}" Header="Mode"
                                          IsVisible="{Binding Record.IsFile}">
                    <ListBox Theme="{StaticResource Segment}" SelectedIndex="{Binding Record.ModeIndex}">
                      <ListBoxItem>continuous</ListBoxItem>
                      <ListBoxItem>content only</ListBoxItem>
                    </ListBox>
                  </HeaderedContentControl>
                  <HeaderedContentControl Theme="{StaticResource Field}" Header="Format">
                    <TextBox Classes="ro" Text="{Binding Record.FormatSummary}" />
                  </HeaderedContentControl>
                  <HeaderedContentControl Theme="{StaticResource Field}" Header="Arm">
                    <CheckBox IsChecked="{Binding Record.ArmWithShow}" Content="arm when the show opens" />
                  </HeaderedContentControl>
                  <ContentControl Theme="{StaticResource FieldWide}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                      <Button Grid.Column="0" Classes="primary" Content="{Binding Record.ArmLabel}"
                              Click="OnToggleRecorder" />
                      <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                                 TextWrapping="Wrap" Text="{Binding Record.Readout}" />
                    </Grid>
                  </ContentControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </c:PanelBox>

          <c:PanelBox Grid.Row="2" Header="{Binding CompositionHeader}" Hint="selected composition">
            <StackPanel Margin="0,6,0,8">
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Size / rate">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Classes="short" Text="{Binding CompositionSize}" />
                  <TextBox Grid.Column="1" Text="{Binding CompositionRate}" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Idle image">
                <TextBox Text="{Binding CompositionIdleImage}" PlaceholderText="black" />
              </HeaderedContentControl>
              <ContentControl Theme="{StaticResource FieldWide}">
                <Button Classes="block" Content="+ ADD COMPOSITION…" Click="OnDialog" Tag="composition" />
              </ContentControl>
            </StackPanel>
          </c:PanelBox>
        </Grid>
      </Grid>

      <!-- ══ 10 · MAPPING ═══════════════════════════════════════════════════════════════════
           Always the mapping OF ONE OUTPUT, which is why the header carries an output picker: the
           same Cyc is warped for Projector A and clean for the lobby TV. -->
      <Grid IsVisible="{Binding IsMappingPane}" ColumnDefinitions="252,*,*" Margin="7" ColumnSpacing="7">

        <c:PanelBox Grid.Column="0" Header="Sections">
          <ScrollViewer>
            <StackPanel Margin="0,6,0,8">
              <ItemsControl ItemsSource="{Binding Sections}" Margin="10,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <TextBlock Classes="mono" FontSize="10.5" Margin="0,3" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Classes="chain" Margin="0,6,0,0">
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                  <Button Classes="tight" Content="+ ADD" Click="OnDialog" Tag="section" />
                  <Button Classes="tight" Content="DUPLICATE" Click="OnDialog" Tag="section:copy" />
                  <Button Classes="tight" Content="DELETE" Click="OnDialog" Tag="section:delete" />
                </WrapPanel>
              </Border>

              <ContentControl Theme="{StaticResource Subhead}" Content="{Binding SectionHeader}" />

              <!-- The numeric half of register item 22. The canvases move the same eight numbers;
                   these are how you hit exactly 50 %, which is what an edge blend is made of. -->
              <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Source x / y" IsEnabled="{Binding HasSection}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Text="{Binding SourceXValue}" LostFocus="OnSectionFieldCommitted" />
                  <TextBox Grid.Column="1" Text="{Binding SourceYValue}" LostFocus="OnSectionFieldCommitted" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Source w / h" IsEnabled="{Binding HasSection}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Text="{Binding SourceWidthValue}" LostFocus="OnSectionFieldCommitted" />
                  <TextBox Grid.Column="1" Text="{Binding SourceHeightValue}" LostFocus="OnSectionFieldCommitted" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Output x / y" IsEnabled="{Binding HasSection}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Text="{Binding TargetXValue}" LostFocus="OnSectionFieldCommitted" />
                  <TextBox Grid.Column="1" Text="{Binding TargetYValue}" LostFocus="OnSectionFieldCommitted" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Output w / h" IsEnabled="{Binding HasSection}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Text="{Binding TargetWidthValue}" LostFocus="OnSectionFieldCommitted" />
                  <TextBox Grid.Column="1" Text="{Binding TargetHeightValue}" LostFocus="OnSectionFieldCommitted" />
                </Grid>
              </HeaderedContentControl>

              <HeaderedContentControl Theme="{StaticResource Field}" Header="Rotation" IsEnabled="{Binding HasSection}">
                <TextBox Classes="short" Text="{Binding RotationValue}" LostFocus="OnSectionFieldCommitted" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Opacity" IsEnabled="{Binding HasSection}">
                <TextBox Classes="short" Text="{Binding OpacityValue}" LostFocus="OnSectionFieldCommitted" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Brightness" IsEnabled="{Binding HasSection}">
                <TextBox Classes="short" Text="{Binding BrightnessValue}" LostFocus="OnSectionFieldCommitted" />
              </HeaderedContentControl>
              <!-- Mesh warp first; corner-pin stays reserved in the model (register item 22). -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Warp" IsEnabled="{Binding HasSection}">
                <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding WarpModes}"
                         SelectedIndex="{Binding WarpIndex}" />
              </HeaderedContentControl>
              <StackPanel IsVisible="{Binding HasWarp}">
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Mesh point">
                  <ComboBox ItemsSource="{Binding WarpPoints}" SelectedIndex="{Binding SelectedWarpPoint}" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Offset x / y">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <TextBox Grid.Column="0" Text="{Binding WarpOffsetX}" LostFocus="OnSectionFieldCommitted" />
                    <TextBox Grid.Column="1" Text="{Binding WarpOffsetY}" LostFocus="OnSectionFieldCommitted" />
                  </Grid>
                </HeaderedContentControl>
                <ContentControl Theme="{StaticResource FieldWide}">
                  <WrapPanel HorizontalAlignment="Center" ItemSpacing="4">
                    <Button Classes="icon" Content="←" Click="OnWarpNudge" Tag="left" />
                    <Button Classes="icon" Content="↑" Click="OnWarpNudge" Tag="up" />
                    <Button Classes="icon" Content="↓" Click="OnWarpNudge" Tag="down" />
                    <Button Classes="icon" Content="→" Click="OnWarpNudge" Tag="right" />
                  </WrapPanel>
                </ContentControl>
              </StackPanel>
              <ContentControl Theme="{StaticResource FieldWide}">
                <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap"
                           Text="drag with the mouse · numeric x/y/w/h · arrow-key nudge of the selected box" />
              </ContentControl>
            </StackPanel>
          </ScrollViewer>
        </c:PanelBox>

        <c:PanelBox Grid.Column="1" Header="Source · Cyc" Hint="what each section samples">
          <c:PanelBox.Footer>
            <Border Classes="chain">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="badge"><TextBlock Text="OVERLAP" /></Border>
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                           Text="sections 1+2 overlap 4 % for edge blend" />
              </StackPanel>
            </Border>
          </c:PanelBox.Footer>
          <c:AspectBox Margin="10,8" VerticalAlignment="Top">
            <c:PlacementCanvas Boxes="{Binding MappingSource}"
                               Gesture="OnMappingSourceGesture"
                               GestureCompleted="OnGestureCompleted"
                               BoxSelected="OnSectionSelected" />
          </c:AspectBox>
        </c:PanelBox>

        <c:PanelBox Grid.Column="2" Header="Output · Projector A" Hint="where it lands · warp handles live">
          <c:PanelBox.Footer>
            <Border Classes="chain">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge good"><TextBlock Text="ON DEVICE" /></Border>
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="edits render straight to the projector — the canvas here is a mirror, the wall is the truth" />
              </DockPanel>
            </Border>
          </c:PanelBox.Footer>
          <c:AspectBox Margin="10,8" VerticalAlignment="Top">
            <!-- No grid on the output half: the reference here is the wall, not a nominal frame. -->
            <c:PlacementCanvas Boxes="{Binding MappingTarget}" ShowGrid="False"
                               Gesture="OnMappingTargetGesture"
                               GestureCompleted="OnGestureCompleted"
                               BoxSelected="OnSectionSelected" />
          </c:AspectBox>
        </c:PanelBox>
      </Grid>

      <!-- ══ OUTPUTS (the same table, given the whole width) ════════════════════════════════ -->
      <Grid IsVisible="{Binding IsOutputsPane}" Margin="7">
        <c:PanelBox Header="Video outputs" Hint="composition · mapping · state, per output">
          <!-- The add buttons live HERE as well as beside the canvases. This is the pane called
               OUTPUTS; an operator who comes looking for "add an output" comes here first, and finding
               no way to add one reads as the feature being missing. -->
          <c:PanelBox.Footer>
            <Border Classes="chain">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="tight" Content="+ LOCAL…" Click="OnDialog" Tag="out:local" />
                <Button Classes="tight" Content="+ NDI…" Click="OnDialog" Tag="out:ndi" />
                <Button Classes="tight" Content="+ RECORD…" Click="OnDialog" Tag="out:record" />
                <Button Classes="tight" Content="+ STREAM…" Click="OnDialog" Tag="out:stream" />
                <Button Classes="tight" Content="+ COMPOSITION…" Click="OnDialog" Tag="composition" />
              </StackPanel>
            </Border>
          </c:PanelBox.Footer>
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource BoothPanel2}"
                    BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1" Padding="8,4">
              <Grid ColumnDefinitions="140,*,120,140,140" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Theme="{StaticResource ColumnHeadText}" Text="OUTPUT" />
                <TextBlock Grid.Column="1" Theme="{StaticResource ColumnHeadText}" Text="KIND" />
                <TextBlock Grid.Column="2" Theme="{StaticResource ColumnHeadText}" Text="SHOWS" />
                <TextBlock Grid.Column="3" Theme="{StaticResource ColumnHeadText}" Text="MAP" />
                <TextBlock Grid.Column="4" Theme="{StaticResource ColumnHeadText}" Text="STATE" />
              </Grid>
            </Border>
            <!-- The ORDER matters and nothing else says it: an output shows a composition, so there
                 has to be one before an output can point at anything. -->
            <c:EmptyState IsVisible="{Binding HasNoOutputs}"
                          Headline="No video outputs"
                          Detail="{Binding OutputsEmptyDetail}" />
            <ListBox IsVisible="{Binding !HasNoOutputs}" Theme="{StaticResource TableRows}"
                     ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VideoOutputRow">
                  <Grid ColumnDefinitions="140,*,120,140,140" ColumnSpacing="8" Margin="8,5">
                    <TextBlock Grid.Column="0" Classes="mono small" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Classes="mono dim3 small ellipsis" Text="{Binding Kind}" />
                    <TextBlock Grid.Column="2" Classes="mono dim3 small" Text="{Binding Shows}" />
                    <TextBlock Grid.Column="3" Classes="mono dim3 small" Text="{Binding Map}" />
                    <TextBlock Grid.Column="4" Classes="mono dim2 small" Text="{Binding State.Text}"
                               Classes.ok="{Binding State.IsGood}" Classes.err="{Binding State.IsBad}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </c:PanelBox>
      </Grid>

      <Panel IsVisible="{Binding IsAuditionPane}">
        <v:AuditionPane DataContext="{Binding Audition}" />
      </Panel>

    </Panel>
  </DockPanel>
</UserControl>
