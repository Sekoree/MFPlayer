<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:HaCue2.Controls"
        xmlns:v="using:HaCue2.Views"
        xmlns:vm="using:HaCue2.ViewModels"
        xmlns:res="using:HaCue2.Resources"
        x:Class="HaCue2.Views.ShellWindow"
        x:DataType="vm:ShellViewModel"
        x:CompileBindings="True"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BoothBg}"
        Foreground="{DynamicResource BoothInk}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- The one window (register item 1): four views in the title bar, a Settings window and a
       Diagnostics window beside it, and no permanent output strip - the Output info drawer overlays
       the content on demand and the status bar carries a one-token summary at all times. -->

  <Window.DataTemplates>
    <DataTemplate DataType="vm:CuesViewModel"><v:CuesView /></DataTemplate>
    <DataTemplate DataType="vm:AudioViewModel"><v:AudioView /></DataTemplate>
    <DataTemplate DataType="vm:VideoViewModel"><v:VideoView /></DataTemplate>
    <DataTemplate DataType="vm:TargetsViewModel"><v:TargetsView /></DataTemplate>
  </Window.DataTemplates>

  <DockPanel>

    <!-- ── title bar ──────────────────────────────────────────────────────────────────────── -->
    <Border Classes="titlebar" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <!-- FILE, first and leftmost, where every application on every desktop puts it. It exists as
             much for the answer to "where is this saved" - the menu names the path - as for the verbs:
             a save that only ever happened via a hotkey gave an operator nothing to look at. -->
        <Button Grid.Column="0" Classes="tight" Content="{x:Static res:Strings.ShellFileMenu}" Margin="0,0,6,0"
                AutomationProperties.Name="{x:Static res:Strings.ShellFileMenuName}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{x:Static res:Strings.ShellFileNewProject}" Click="OnFileNew" InputGesture="Ctrl+N" />
              <MenuItem Header="{x:Static res:Strings.ShellFileOpenProject}" Click="OnFileOpen" InputGesture="Ctrl+O" />
              <MenuItem Header="{x:Static res:Strings.ShellFileOpenRecent}" ItemsSource="{Binding Recents}">
                <MenuItem.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecentProjectRow">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </MenuItem.ItemTemplate>
                <MenuItem.Styles>
                  <Style Selector="MenuItem > MenuItem">
                    <Setter Property="Command"
                            Value="{Binding $parent[v:ShellWindow].((vm:ShellViewModel)DataContext).OpenRecentProjectCommand}" />
                    <Setter Property="CommandParameter" Value="{Binding}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
              <Separator />
              <MenuItem Header="{Binding SaveLabel}" Click="OnFileSave" InputGesture="Ctrl+S" />
              <MenuItem Header="{x:Static res:Strings.ShellFileSaveAs}" Click="OnFileSaveAs" InputGesture="Ctrl+Shift+S" />
              <Separator />
              <!-- A second PROCESS, not a second window: two shells in one process would open the
                   same audio devices and fight over them. -->
              <MenuItem Header="{x:Static res:Strings.ShellFileNewWindow}" Click="OnFileNewWindow" />
              <Separator />
              <MenuItem Header="{x:Static res:Strings.ShellFileCloseProject}" Click="OnFileClose" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <!-- F-09: the project identity is BOUNDED - a long filename must never push the safety
             controls (mode, LOCK, view switching) out of a 900 px window. The full path stays one
             hover away in the tooltip. -->
        <TextBlock Grid.Column="1" x:Name="ProjectIdentity"
                   Classes="mono dim2" FontSize="11" VerticalAlignment="Center"
                   Text="{Binding ProjectFile}" Margin="0,0,6,0"
                   MaxWidth="220" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding ProjectLocation}" />

        <ListBox Grid.Column="2"
                 Theme="{StaticResource ViewTabs}"
                 ItemsSource="{Binding Views}"
                 SelectedItem="{Binding SelectedView}"
                 AutomationProperties.Name="{x:Static res:Strings.ShellMainViewName}" />

        <!-- The mode chip is a readout, not a control: it says which mode you are in, and Lock beside
             it is the only way to change that. -->
        <Border Grid.Column="4" Classes="chip" Classes.edit="{Binding !IsLocked}"
                Classes.warn="{Binding IsLocked}">
          <TextBlock Text="{Binding ModeLabel}" />
        </Border>

        <!-- Register item 2: opt-in latch, authoring locked, GO untouched, never the launch state.
             The copy says exactly what the journal enforces: notes stay editable under lock (the one
             deliberate exception), so "read-only document" was a promise the app did not keep. -->
        <ToggleButton Grid.Column="5" Theme="{StaticResource ChipToggle}" Classes="latch-warn"
                      IsChecked="{Binding IsLocked}" Content="{x:Static res:Strings.ShellLock}"
                      ToolTip.Tip="{x:Static res:Strings.ShellLockTooltip}" />

        <Button Grid.Column="6" x:Name="SettingsButton"
                Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.ShellSettings}" Click="OnSettings" />
        <!-- Exactly one Diagnostics button in the whole app, and it is here. -->
        <Button Grid.Column="7" x:Name="DiagnosticsButton"
                Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.ShellDiagnostics}" Click="OnDiagnostics" />
        <!-- F-09 compact overflow: below the width threshold the two lower-priority chips fold in
             here, so mode/LOCK/view switching keep their room. Never holds Lock or the mode chip -
             safety state stays directly visible at every supported size. -->
        <Button Grid.Column="8" x:Name="TitleOverflowButton" IsVisible="False"
                Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.ShellMore}"
                AutomationProperties.Name="{x:Static res:Strings.ShellMoreName}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{x:Static res:Strings.ShellMoreSettings}" Click="OnSettings" />
              <MenuItem Header="{x:Static res:Strings.ShellMoreDiagnostics}" Click="OnDiagnostics" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- ── status bar ─────────────────────────────────────────────────────────────────────── -->
    <Border Classes="statusbar" DockPanel.Dock="Bottom">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="15">
        <ToggleButton Grid.Column="0" Theme="{StaticResource ChipToggle}"
                      IsChecked="{Binding IsOutputInfoOpen}"
                      Content="{x:Static res:Strings.ShellOutputInfo}"
                      ToolTip.Tip="{x:Static res:Strings.ShellOutputInfoTooltip}" />
        <TextBlock Grid.Column="1" Classes="mono ok small" VerticalAlignment="Center"
                   Text="{Binding OutputSummary}" />
        <!-- The issue count is the doorway to Project status. Red is reserved for ERRORS; a
             warnings-only show wears amber, and a clean one sits quiet. -->
        <Button Grid.Column="2" Theme="{StaticResource LinkButton}"
                Classes.warnOnly="{Binding IssuesAreWarningsOnly}"
                Classes.allQuiet="{Binding !HasIssues}"
                Content="{Binding IssueSummary}" Click="OnProjectStatus">
          <Button.Styles>
            <Style Selector="Button"><Setter Property="Foreground" Value="{DynamicResource GelRed}" /></Style>
            <Style Selector="Button.warnOnly"><Setter Property="Foreground" Value="{DynamicResource GelAmber}" /></Style>
            <Style Selector="Button.allQuiet"><Setter Property="Foreground" Value="{DynamicResource BoothInk3}" /></Style>
          </Button.Styles>
        </Button>
        <!-- The rig is not running what the document says. Visible from EVERY tab because the edit
             that lights it is often made on the VIDEO tab (an A/V sender's audio half), where the
             Audio pane's own apply button cannot be seen at all - review finding B1. -->
        <Button Grid.Column="3" Theme="{StaticResource LinkButton}"
                Foreground="{DynamicResource GelAmber}"
                IsVisible="{Binding Audio.NeedsAudioRestart}"
                Content="{x:Static res:Strings.ShellAudioNotApplied}"
                ToolTip.Tip="{x:Static res:Strings.ShellAudioNotAppliedTooltip}"
                Click="OnApplyAudio" />
        <!-- The undo toast names the DOMAIN as well as the edit ("undo: patch - Fold L → Out 3 gain"):
             with one journal across every view, ⌘Z can otherwise change a screen nobody is looking at. -->
        <TextBlock Grid.Column="4" Classes="mono dim2 small" VerticalAlignment="Center"
                   MaxWidth="230" TextTrimming="CharacterEllipsis"
                   Text="{Binding YouTubeDownloadSummary}" />
        <TextBlock Grid.Column="5" Classes="mono dim3 small" VerticalAlignment="Center"
                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding CanUndo}" Text="{Binding UndoSummary}" />
        <TextBlock Grid.Column="6" Classes="mono dim3 small" VerticalAlignment="Center"
                   Text="{Binding UnsavedSummary}" />
        <TextBlock Grid.Column="7" Classes="mono ok small" VerticalAlignment="Center"
                   Text="{Binding SavedSummary}" />
      </Grid>
    </Border>

    <!-- ── content + the Output info drawer ───────────────────────────────────────────────── -->
    <!-- The drawer is the LAST child of a Grid cell shared with the content, so it slides over the
         active panel instead of pushing it: content never shifts when it opens (screen 02b, Decided). -->
    <Grid>
      <ContentControl Content="{Binding CurrentPane}" />

      <Border VerticalAlignment="Bottom"
              Background="{DynamicResource BoothPanel}"
              BorderBrush="{DynamicResource BoothRule2}"
              BorderThickness="0,1,0,0"
              IsVisible="{Binding IsOutputInfoOpen}">
        <Grid ColumnDefinitions="Auto,Auto,*" DataContext="{Binding OutputInfo}"
              x:DataType="vm:OutputInfoViewModel">

          <!-- Program -->
          <Border Grid.Column="0" BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,1,0"
                  Padding="11,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="caps" Text="{x:Static res:Strings.ShellProgramCaption}" VerticalAlignment="Center">
                <TextBlock.RenderTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.RenderTransform>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Meters}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProgramMeter">
                    <StackPanel Spacing="4" Width="22" HorizontalAlignment="Center">
                      <c:LevelMeter HorizontalAlignment="Center" PointerPressed="OnProgramMeterPressed"
                                    Level="{Binding Level}" Peak="{Binding Peak}"
                                    IsClipping="{Binding IsClipping}" />
                      <TextBlock Classes="caps" HorizontalAlignment="Center"
                                 Classes.err="{Binding IsClipping}" Text="{Binding Caption}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Lines -->
          <Border Grid.Column="1" BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,1,0"
                  Padding="11,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="caps" Text="{x:Static res:Strings.OutInfoLines}" VerticalAlignment="Center">
                <TextBlock.RenderTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.RenderTransform>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OutputLineChip">
                    <Border Classes="lchip"
                            Classes.ok="{Binding IsOk}"
                            Classes.warn="{Binding IsWarn}"
                            Classes.err="{Binding IsError}">
                      <StackPanel Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Ellipse Classes="led"
                                   Classes.ok="{Binding IsOk}"
                                   Classes.warn="{Binding IsWarn}"
                                   Classes.err="{Binding IsError}" />
                          <TextBlock Classes="mono" FontSize="{DynamicResource FontSizeMono}"
                                     Text="{Binding Name}" />
                          <TextBlock Classes="mono dim3" FontSize="{DynamicResource FontSizeNano}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding HasSuffix}" Text="{Binding Suffix}" />
                        </StackPanel>
                        <TextBlock Classes="mono dim3" FontSize="{DynamicResource FontSizeNano}"
                                   Classes.warn="{Binding IsWarn}" Classes.err="{Binding IsError}"
                                   Text="{Binding Detail}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Bay -->
          <Border Grid.Column="2" Padding="11,6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Classes="caps" Text="{x:Static res:Strings.OutInfoBay}" VerticalAlignment="Center">
                <TextBlock.RenderTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.RenderTransform>
              </TextBlock>
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Classes="mono dim2 small" Text="{Binding BaySummary}" />
                <TextBlock Classes="mono dim3 small" Text="{Binding BayClock}" />
              </StackPanel>
              <Button Grid.Column="3" Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.PlacePopOut}"
                      Click="OnPopOutDrawer" />
              <Button Grid.Column="4" Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.ShellHide}"
                      Click="OnHideDrawer" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
