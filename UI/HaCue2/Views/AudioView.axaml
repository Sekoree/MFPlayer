<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:HaCue2.Resources"
             xmlns:c="using:HaCue2.Controls"
             xmlns:sys="using:System"
             xmlns:v="using:HaCue2.Views"
             xmlns:vm="using:HaCue2.ViewModels"
             xmlns:m="using:HaCue2.Core.Model"
             x:Class="HaCue2.Views.AudioView"
             x:DataType="vm:AudioViewModel"
             x:CompileBindings="True">

  <!-- Screens 06–08b: Logical outputs · Patch · Devices · Audition.

       The headline feature is the first pane. A logical output is a named channel that exists whether
       or not any hardware does; cues send to these and nothing else, and the show file never contains
       a device name. That is the venue-swap seam - the show keeps "Lobby", each venue patches it. -->

  <DockPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*"
          Background="{DynamicResource BoothPanel}">
      <ListBox Grid.Column="0" Theme="{StaticResource SectionTabs}"
               Background="{DynamicResource BoothPanel}"
               ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SectionTab">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="1" BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1">
        <TextBlock Classes="mono dim3 micro" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="10,0" Text="{Binding TabHint}" />
      </Border>
    </Grid>

    <Panel>

      <!-- ══ 06 · LOGICAL OUTPUTS ═══════════════════════════════════════════════════════════ -->
      <Grid IsVisible="{Binding IsOutputsPane}" ColumnDefinitions="*,348" Margin="7" ColumnSpacing="7">

        <c:PanelBox Grid.Column="0" Header="{x:Static res:Strings.AudLogicalOutputs}" Hint="the only destinations cues can see">
          <c:PanelBox.Footer>
            <Border Classes="chain">
              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="6"
                    IsEnabled="{Binding CanAuthor}">
                <Button Grid.Column="0" Classes="tight" Content="{x:Static res:Strings.AudAdd}" Click="OnDialog" Tag="output" />
                <Button Grid.Column="1" Classes="tight" Content="{x:Static res:Strings.AudAddStereoPair}" Click="OnDialog" Tag="pair" />
                <Button Grid.Column="2" Classes="tight" Content="{x:Static res:Strings.AudNewGroup}" Click="OnDialog" Tag="group" />
                <Button Grid.Column="3" Classes="tight" Content="{x:Static res:Strings.AudRename}" Click="OnDialog" Tag="rename" />
                <Button Grid.Column="4" Classes="tight" Content="{x:Static res:Strings.AudReorder}" Click="OnDialog" Tag="reorder" />
                <!-- Register item 11: no refuse-while-fed gate. Deleting strips the sends from every
                     cue as ONE undoable edit, which is the only version of this that an operator can
                     safely reverse. The footer said so for months with no button behind it - the
                     cascade existed in ProjectEdits and nothing in the app called it. -->
                <Button Grid.Column="5" Classes="tight" Content="{x:Static res:Strings.AudRemove}" Click="OnDialog" Tag="output:remove"
                        IsEnabled="{Binding HasSelectedOutput}" />
                <TextBlock Grid.Column="6" Classes="mono dim3 small" HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{x:Static res:Strings.AudDeleteCleansUpItsCue}" />
              </Grid>
            </Border>
          </c:PanelBox.Footer>

          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource BoothPanel2}"
                    BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1" Padding="8,4">
              <Grid ColumnDefinitions="120,90,70,*,90" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.AudName}" />
                <TextBlock Grid.Column="1" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.AudGroup}" />
                <TextBlock Grid.Column="2" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.AudFedBy}" />
                <TextBlock Grid.Column="3" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.AudPatchedTo}" />
                <TextBlock Grid.Column="4" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.AudMeter}" />
              </Grid>
            </Border>

            <ListBox Theme="{StaticResource TableRows}"
                     ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                     KeyDown="OnOutputsKeyDown" PointerPressed="OnRowRightPressed">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{x:Static res:Strings.AudRename2}" Click="OnDialog" Tag="rename" />
                  <MenuItem Header="{x:Static res:Strings.AudMoveInBusOrder}" Click="OnDialog" Tag="reorder" />
                  <MenuItem Header="{x:Static res:Strings.AudPatchToDeviceChannels}" Click="OnDialog" Tag="patch"
                            IsEnabled="{Binding CanPatchToDevice}" />
                  <Separator />
                  <MenuItem Header="{x:Static res:Strings.AudGroupWithTheSelection}" Click="OnDialog" Tag="group" />
                  <MenuItem Header="{x:Static res:Strings.AudUngroup}" Click="OnDialog" Tag="group:remove"
                            IsEnabled="{Binding HasGroupToRemove}" />
                  <Separator />
                  <MenuItem Header="{x:Static res:Strings.AudRemove2}" Click="OnDialog" Tag="output:remove" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogicalOutputRow">
                  <Grid ColumnDefinitions="120,90,70,*,90" ColumnSpacing="8" Margin="8,4">
                    <TextBlock Grid.Column="0" Classes="mono small" Text="{Binding Name}"
                               Classes.warn="{Binding FedBy.IsWarn}" Classes.err="{Binding PatchedTo.IsBad}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                      <TextBlock Classes="mono dim3 small" Text="{Binding Group}" />
                      <!-- 🔗 marks Output-Group membership: editing one member's cell moves the others
                           by the same delta (register item 9). -->
                      <TextBlock Classes="mono dim3 micro" VerticalAlignment="Center"
                                 IsVisible="{Binding HasGroup}" Text="🔗" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="mono dim2 small" Text="{Binding FedBy.Text}"
                               Classes.warn="{Binding FedBy.IsWarn}" />
                    <TextBlock Grid.Column="3" Classes="mono dim3 small ellipsis" Text="{Binding PatchedTo.Text}"
                               Classes.warn="{Binding PatchedTo.IsWarn}" Classes.err="{Binding PatchedTo.IsBad}" />
                    <TextBlock Grid.Column="4" Classes="mono ok small" Text="{Binding MeterGlyphs}"
                               Classes.err="{Binding IsMeterHot}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </c:PanelBox>

        <c:PanelBox Grid.Column="1" Header="{Binding SelectedOutputName}"
                    Hint="{Binding SelectedOutputHint}">
          <c:PanelBox.Footer>
            <Border Classes="chain">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge good"><TextBlock Text="{x:Static res:Strings.AudPortable}" /></Border>
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{x:Static res:Strings.AudThisIsTheVenueSwap}" />
              </DockPanel>
            </Border>
          </c:PanelBox.Footer>

          <ScrollViewer>
            <StackPanel Margin="0,6,0,8" IsEnabled="{Binding CanAuthor}">
              <!-- A real rename. This was bound to a get-only property, so it took typing and threw
                   it away - the only working rename was the footer button. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudName2}">
                <TextBox Text="{Binding OutputName}" IsEnabled="{Binding HasSelectedOutput}" />
              </HeaderedContentControl>
              <!-- With the permanent strip gone, this flag picks what appears in the Output info
                   drawer's compact row and in the status-bar health token. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudMeterInSummary}">
                <ListBox Theme="{StaticResource Segment}" SelectedIndex="{Binding MeterInSummaryIndex}">
                  <ListBoxItem>yes</ListBoxItem>
                  <ListBoxItem>no</ListBoxItem>
                </ListBox>
              </HeaderedContentControl>

              <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.AudFedBy2}" />
              <ItemsControl ItemsSource="{Binding Senders}" Margin="10,2">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <TextBlock Classes="mono dim2" FontSize="{DynamicResource FontSizeMono}"
                               Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.AudPatchedTo2}" />
              <!-- Through the view-model, never a literal: this used to hardcode "Lobby" whichever
                   output was selected, which misdirected exactly the no-sound diagnosis it exists for. -->
              <TextBlock Margin="10,4,10,8" FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap"
                         Classes="err" IsVisible="{Binding IsSelectedOutputUnpatched}"
                         Text="{Binding UnpatchedWarning}" />
              <ContentControl Theme="{StaticResource FieldWide}">
                <Button Classes="primary block" Content="{x:Static res:Strings.AudPatchPickDeviceChannels}" Click="OnDialog"
                        Tag="patch" IsEnabled="{Binding CanPatchToDevice}" />
              </ContentControl>
              <!-- A new project has logical outputs and no LINES on purpose, which used to make this
                   button open nothing and say nothing. -->
              <ContentControl Theme="{StaticResource FieldWide}"
                              IsVisible="{Binding PatchHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding PatchHint}" />
              </ContentControl>
            </StackPanel>
          </ScrollViewer>
        </c:PanelBox>
      </Grid>

      <!-- ══ 07 · PATCH ═════════════════════════════════════════════════════════════════════ -->
      <Grid IsVisible="{Binding IsPatchPane}" ColumnDefinitions="*,260" Margin="7" ColumnSpacing="7">

        <c:PanelBox Grid.Column="0" Header="{x:Static res:Strings.AudPatch}" Hint="cell = gain dB · empty = not routed · live">
          <c:PanelBox.Footer>
            <Border Classes="chain">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                <Border Grid.Column="0" Classes="badge"><TextBlock Text="{x:Static res:Strings.AudPresets}" /></Border>
                <TextBlock Grid.Column="1" Classes="mono dim3 small" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Static res:Strings.AudStereoIdentityFanOutTo}" />
                <Border Grid.Column="2" Classes="badge bad"><TextBlock Text="{x:Static res:Strings.AudUnresolved}" /></Border>
                <!-- An absent line keeps its cells and routes silent. Dropping the patch would lose
                     show data the moment someone unplugs a box. -->
                <TextBlock Grid.Column="3" Classes="mono dim2 small" VerticalAlignment="Center"
                           Text="{x:Static res:Strings.AudWedgeAbsentCellsKeptRouted}" />
              </Grid>
            </Border>
          </c:PanelBox.Footer>

          <!-- The bottom padding is for the horizontal scrollbar, which is an overlay and would
               otherwise sit on the last row of cells. -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto" Padding="9,7,9,16">
            <!-- Register item 13: click toggles at unity, drag adjusts gain, right-click mutes. -->
            <c:MatrixView Columns="{Binding PatchColumns}" Rows="{Binding PatchRows}"
                          AutomationProperties.Name="Audio patch matrix"
                          AutomationProperties.HelpText="{x:Static res:Strings.AudClickRoutesAtUnityDrag}"
                          IsEnabled="{Binding CanAuthor}"
                          RowHeaderWidth="118"
                          Gesture="OnPatchGesture"
                          PointerReleased="OnPatchGestureEnded"
                          ToolTip.Tip="{x:Static res:Strings.AudClickRoutesAtUnityDrag2}" />
          </ScrollViewer>
        </c:PanelBox>

        <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="7">

          <c:PanelBox Grid.Row="0" Header="{x:Static res:Strings.AudSnapshots}" Hint="partial recalls">
            <c:PanelBox.Footer>
              <StackPanel>
                <Border Classes="chain">
                  <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding CanAuthor}">
                    <Button Classes="tight" Content="{x:Static res:Strings.AudSave}" Click="OnDialog" Tag="snapshot" />
                    <Button Classes="tight" Content="{x:Static res:Strings.AudRecall}" Click="OnRecall"
                            IsEnabled="{Binding HasSnapshot}" />
                    <Button Classes="tight" Content="{x:Static res:Strings.AudUpdate}" Click="OnUpdateSnapshot"
                            IsEnabled="{Binding HasSnapshot}" />
                    <Button Classes="tight" Content="{x:Static res:Strings.AudRemove}" Click="OnDialog" Tag="snapshot:remove"
                            IsEnabled="{Binding HasSnapshot}" />
                  </StackPanel>
                </Border>
                <TextBlock Margin="10,6,10,2" FontSize="10.5" Classes="dim3" TextWrapping="Wrap"
                           Text="{x:Static res:Strings.AudASnapshotStoresOnlyThe}" />
                <!-- Recall is not undoable (it is an operator action on the patch, not a document
                     edit), so what it did has to be said out loud. -->
                <TextBlock Margin="10,0,10,9" FontSize="10.5" Classes="mono dim2"
                           TextWrapping="Wrap" Text="{Binding RecallNote}" />
              </StackPanel>
            </c:PanelBox.Footer>

            <ListBox Theme="{StaticResource TableRows}" Margin="4,6"
                     ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
                     KeyDown="OnSnapshotsKeyDown" PointerPressed="OnRowRightPressed">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{x:Static res:Strings.AudRecall2}" Click="OnRecall" />
                  <MenuItem Header="{x:Static res:Strings.AudUpdateFromTheLivePatch}" Click="OnUpdateSnapshot" />
                  <Separator />
                  <MenuItem Header="{x:Static res:Strings.AudRemove2}" Click="OnDialog" Tag="snapshot:remove" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SnapshotRow">
                  <TextBlock Classes="mono" FontSize="10.5" Margin="6,3" Text="{Binding Text}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </c:PanelBox>

          <c:PanelBox Grid.Row="1" Header="{x:Static res:Strings.AudSelectedLine}">
            <StackPanel Margin="0,6,0,8">
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudLine}">
                <TextBox Classes="ro" Text="{Binding SelectedOutputLines}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudCarries}">
                <TextBox Classes="ro" Text="{Binding SelectedOutputCarries}" />
              </HeaderedContentControl>
              <!-- Always allowed: it rewrites the MONITOR line's own patch row, so it never reaches
                   the program mix and never appears in the Active list (register item 13). -->
              <ContentControl Theme="{StaticResource FieldWide}">
                <Button Classes="block" Content="{Binding SoloLabel}" Click="OnSolo" />
              </ContentControl>
              <ContentControl Theme="{StaticResource FieldWide}"
                              IsVisible="{Binding SoloProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="mono small warn" TextWrapping="Wrap" Text="{Binding SoloProblem}" />
              </ContentControl>
            </StackPanel>
          </c:PanelBox>
        </Grid>
      </Grid>

      <!-- ══ 08 · DEVICES ═══════════════════════════════════════════════════════════════════ -->
      <Grid IsVisible="{Binding IsDevicesPane}" ColumnDefinitions="*,330" Margin="7" ColumnSpacing="7">

        <c:PanelBox Grid.Column="0" Header="{x:Static res:Strings.AudAudioLines}" Hint="machine-side · adding/removing is an edit">
          <c:PanelBox.Footer>
            <Border Classes="chain">
              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="6"
                    IsEnabled="{Binding CanAuthor}">
                <Button Grid.Column="0" Classes="tight" Content="{x:Static res:Strings.AudLocalAudio}" Click="OnDialog" Tag="line:device" />
                <Button Grid.Column="1" Classes="tight" Content="{x:Static res:Strings.AudNdiAudio}" Click="OnDialog" Tag="line:ndi" />
                <Button Grid.Column="2" Classes="tight" Content="{x:Static res:Strings.AudRecord}" Click="OnDialog" Tag="line:record" />
                <Button Grid.Column="3" Classes="tight" Content="{x:Static res:Strings.AudStream}" Click="OnDialog" Tag="line:stream" />
                <Button Grid.Column="5" Classes="tight" Content="{x:Static res:Strings.AudRelinkAbsent}" Click="OnDialog" Tag="relink" />
              </Grid>
            </Border>
          </c:PanelBox.Footer>

          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource BoothPanel2}"
                    BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1" Padding="8,4">
              <Grid ColumnDefinitions="90,*,40,110,150,110" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.AudLine2}" />
                <TextBlock Grid.Column="1" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.AudKind}" />
                <TextBlock Grid.Column="2" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.AudCh}" />
                <TextBlock Grid.Column="3" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.DiagColRate}" />
                <TextBlock Grid.Column="4" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.DiagColState}" />
                <TextBlock Grid.Column="5" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.AudCarries2}" />
              </Grid>
            </Border>

            <c:EmptyState IsVisible="{Binding HasNoLines}"
                          Headline="No audio lines"
                          Detail="Add one above. A line is a device this show sends to; logical outputs are patched onto its channels." />
            <ListBox IsVisible="{Binding !HasNoLines}" Theme="{StaticResource TableRows}"
                     ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                     KeyDown="OnLinesKeyDown" PointerPressed="OnRowRightPressed">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{x:Static res:Strings.AudRename2}" Click="OnDialog" Tag="line:rename" />
                  <MenuItem Header="{x:Static res:Strings.AudRelinkAbsentLines}" Click="OnDialog" Tag="relink" />
                  <Separator />
                  <MenuItem Header="{x:Static res:Strings.AudRemove2}" Click="OnDialog" Tag="line:remove" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AudioLineRow">
                  <Grid ColumnDefinitions="90,*,40,110,150,110" ColumnSpacing="8" Margin="8,4">
                    <TextBlock Grid.Column="0" Classes="mono small" Text="{Binding Name}"
                               Classes.err="{Binding State.IsBad}" />
                    <TextBlock Grid.Column="1" Classes="mono dim3 small ellipsis" Text="{Binding Kind}" />
                    <TextBlock Grid.Column="2" Classes="mono dim2 small" Text="{Binding Channels}" />
                    <TextBlock Grid.Column="3" Classes="mono dim2 small" Text="{Binding Rate.Text}"
                               Classes.warn="{Binding Rate.IsWarn}" />
                    <TextBlock Grid.Column="4" Classes="mono dim2 small" Text="{Binding State.Text}"
                               Classes.ok="{Binding State.IsGood}" Classes.warn="{Binding State.IsWarn}"
                               Classes.err="{Binding State.IsBad}" />
                    <TextBlock Grid.Column="5" Classes="mono dim3 small" Text="{Binding Carries}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </c:PanelBox>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="7">

          <c:PanelBox Grid.Row="0" Header="{x:Static res:Strings.AudProjectMix}">
            <StackPanel Margin="0,6,0,8" IsEnabled="{Binding CanAuthor}">
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudMixRate}">
                <ComboBox ItemsSource="{Binding MixRates}" SelectedIndex="{Binding MixRateIndex}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudClockMaster}">
                <ComboBox ItemsSource="{Binding ClockMasters}" SelectedIndex="{Binding ClockMasterIndex}" />
              </HeaderedContentControl>
              <TextBlock Margin="10,4,10,4" FontSize="10.5" Classes="dim3" TextWrapping="Wrap"
                         Text="{x:Static res:Strings.AudTheClockMasterMustRun}" />
              <!-- Register item 14: never a silent rebuild. The button only lights up when the running
                   bay actually differs from the document, so it says something rather than sitting
                   there inviting a restart nobody needs. -->
              <ContentControl Theme="{StaticResource FieldWide}">
                <Button Classes="block" Content="{x:Static res:Strings.AudApplyRestartAudio}"
                        IsEnabled="{Binding NeedsAudioRestart}" Click="OnRestartAudio" />
              </ContentControl>
            </StackPanel>
          </c:PanelBox>

          <c:PanelBox Grid.Row="1" Header="{Binding SelectedLineName}" Hint="selected line">
            <StackPanel Margin="0,6,0,8">
              <!-- Hidden rather than disabled for an interface line: a directory and a filename
                   pattern are not dimmed-out properties of a sound card, they are meaningless for one. -->
              <StackPanel IsVisible="{Binding Record.IsRecording}">
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudDirectory}"
                                        IsVisible="{Binding Record.IsFile}">
                  <TextBox Text="{Binding Record.Directory}" PlaceholderText="{x:Static res:Strings.AudTheMachineSRecordingsFolder}" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudPattern}"
                                        IsVisible="{Binding Record.IsFile}">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <TextBox Grid.Column="0" Text="{Binding Record.Pattern}" />
                    <!-- Register item 30: insert-token dropdown plus a "?" listing every token with a
                         rendered example - the tokens are unguessable otherwise. -->
                    <!-- {}-escaped: a value starting with "{" is otherwise read as a markup extension. -->
                    <Button Grid.Column="1" Classes="icon" Content="{}{ } ▾">
                      <Button.Flyout>
                        <Flyout>
                          <ItemsControl ItemsSource="{Binding Record.Tokens}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="m:RecordPattern+RecordToken">
                                <Button Classes="tight block" HorizontalAlignment="Stretch"
                                        Click="OnInsertToken" Tag="{Binding Token}">
                                  <StackPanel>
                                    <TextBlock Classes="mono" Text="{Binding Token}" />
                                    <TextBlock Classes="mono dim3 micro" Text="{Binding Meaning}" />
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Grid.Column="2" Classes="icon" Content="?">
                      <Button.Flyout>
                        <Flyout>
                          <TextBlock Classes="mono dim3 micro" MaxWidth="320" TextWrapping="Wrap"
                                     Text="{Binding Record.TokenHelp}" />
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudUrl}"
                                        IsVisible="{Binding Record.IsStream}">
                  <TextBox Text="{Binding Record.Url}" PlaceholderText="{x:Static res:Strings.AudRtmpHostAppKey}" />
                </HeaderedContentControl>
                <!-- Rendered by the same expander that names the file, so the preview cannot promise a
                     name the recorder would not write. -->
                <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding Record.IsFile}">
                  <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding Record.Preview}" />
                </ContentControl>
                <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding Record.HasProblem}">
                  <TextBlock Classes="mono small" Foreground="{DynamicResource GelRed}"
                             TextWrapping="Wrap" Text="{Binding Record.Problem}" />
                </ContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudMode}"
                                        IsVisible="{Binding Record.IsFile}">
                  <ListBox Theme="{StaticResource Segment}" SelectedIndex="{Binding Record.ModeIndex}">
                    <ListBoxItem>continuous</ListBoxItem>
                    <ListBoxItem>content only</ListBoxItem>
                  </ListBox>
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudFormat}">
                  <TextBox Classes="ro" Text="{Binding Record.FormatSummary}" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudArm}">
                  <CheckBox IsChecked="{Binding Record.ArmWithShow}" Content="{x:Static res:Strings.AudArmWhenTheShowOpens}" />
                </HeaderedContentControl>
                <ContentControl Theme="{StaticResource FieldWide}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <Button Grid.Column="0" Classes="primary" Content="{Binding Record.ArmLabel}"
                            Click="OnToggleRecorder" />
                    <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text="{Binding Record.Readout}" />
                  </Grid>
                </ContentControl>
              </StackPanel>

              <TextBlock IsVisible="{Binding !Record.IsRecording}" Classes="mono dim3 small" TextWrapping="Wrap"
                         Margin="0,4,0,0"
                         Text="{x:Static res:Strings.AudRecordingSettingsAppearHereFor}" />
            </StackPanel>
          </c:PanelBox>
        </Grid>
      </Grid>

      <!-- ══ 08b · AUDITION ═════════════════════════════════════════════════════════════════ -->
      <!-- One rig, one pane, duplicated verbatim in the Video view - an audition rig is a single
           thing (an audio device plus a video surface) and splitting its two halves across two views
           would make it look like two. -->
      <Panel IsVisible="{Binding IsAuditionPane}">
        <v:AuditionPane DataContext="{Binding Audition}" />
      </Panel>

    </Panel>
  </DockPanel>
</UserControl>
