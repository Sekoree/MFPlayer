<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HaCue2.Controls"
             xmlns:sys="using:System"
             xmlns:vm="using:HaCue2.ViewModels"
             x:Class="HaCue2.Views.InspectorPane"
             x:DataType="vm:InspectorViewModel">

  <!-- Screens 02 and 04. The tab SET follows the cue kind and the chosen tab is remembered per kind;
       "Note" (singular) is on every kind. Selecting a cue never flips the right panel to this pane,
       and with nothing selected it shows the no-selection state rather than the last cue. -->

  <Panel>

    <!-- no-selection state -->
    <TextBlock IsVisible="{Binding !HasSelection}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Classes="mono dim3 small" Text="select a cue to edit" />

    <DockPanel IsVisible="{Binding HasSelection}">

      <ListBox DockPanel.Dock="Top"
               Theme="{StaticResource SectionTabs}"
               ItemsSource="{Binding Tabs}"
               SelectedItem="{Binding SelectedTab}" />

      <Border DockPanel.Dock="Top" Classes="chain flush"
              IsVisible="{Binding IsMultiSelection}">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge">
            <TextBlock Text="MULTI" />
          </Border>
          <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="{Binding MultiSelectionNote}" />
        </DockPanel>
      </Border>

      <ScrollViewer>
        <Panel>

          <!-- ══ GENERAL ═══════════════════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsGeneralPane}" Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Number">
              <TextBox Text="{Binding NumberValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Label">
              <TextBox Text="{Binding LabelValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Trigger">
              <ListBox Theme="{StaticResource Segment}" SelectedIndex="{Binding TriggerIndex}">
                <ListBoxItem>manual</ListBoxItem>
                <ListBoxItem>follow</ListBoxItem>
                <ListBoxItem>continue</ListBoxItem>
              </ListBox>
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Pre / post wait">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding PreWaitValue}" LostFocus="OnFieldCommitted" />
                <TextBox Grid.Column="1" Text="{Binding PostWaitValue}" LostFocus="OnFieldCommitted" />
              </Grid>
            </HeaderedContentControl>
            <!-- A band on the row, addressed by palette index rather than by colour so it restyles
                 with the theme and a travelling show carries no hex codes. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Colour">
              <ComboBox ItemsSource="{Binding ColorTags}" SelectedIndex="{Binding ColorTagIndex}"
                        ToolTip.Tip="A band at the left of this cue's row. The fastest thing to find in a long list." />
            </HeaderedContentControl>
            <!-- A disabled cue stays visible and is skipped by GO and by auto-follow — deleting a cue
                 to drop it for one performance is how shows lose cues. -->
            <CheckBox Margin="10,6,10,0" IsChecked="{Binding IsEnabled}"
                      Content="Enabled — GO and auto-follow include this cue" />
          </StackPanel>

          <!-- ══ AUDIO ═════════════════════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsAudioPane}" Margin="0,6,0,8">
            <!-- A concert capture routinely carries several audio tracks — a stereo mix, an isolated
                 vocal, a room pair. Which one this cue plays is an authoring decision, and the sends
                 below are the channels OF THAT TRACK. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Track"
                                    IsEnabled="{Binding AudioTrack.HasMedia}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox Grid.Column="0" ItemsSource="{Binding AudioTrack.Options}"
                          SelectedIndex="{Binding AudioTrack.SelectedIndex}" />
                <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                           Text="{Binding AudioTrack.Hint}" />
              </Grid>
            </HeaderedContentControl>
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding AudioTrack.HasMoved}">
              <Border Classes="chain">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Classes="badge bad"><TextBlock Text="TRACK MOVED" /></Border>
                  <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding AudioTrack.MovedNote}" />
                </StackPanel>
              </Border>
            </ContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Level">
              <TextBox Classes="short" Text="{Binding LevelValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Fade in">
              <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding FadeValue}" LostFocus="OnFieldCommitted" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FadeInCurve.Curves}"
                          SelectedIndex="{Binding FadeInCurve.SelectedIndex}"
                          ItemTemplate="{StaticResource CurveItemTemplate}"
                          SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
                <Button Grid.Column="2" Classes="icon" Content="✎" Click="OnEditCurve" Tag="fadeIn"
                        ToolTip.Tip="Custom curve editor — drag points, smooth/hold segments, dB ⇄ linear" />
              </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Fade out">
              <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding FadeOutValue}" LostFocus="OnFieldCommitted" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FadeOutCurve.Curves}"
                          SelectedIndex="{Binding FadeOutCurve.SelectedIndex}"
                          ItemTemplate="{StaticResource CurveItemTemplate}"
                          SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
                <Button Grid.Column="2" Classes="icon" Content="✎" Click="OnEditCurve" Tag="fadeOut" />
              </Grid>
            </HeaderedContentControl>

            <!-- The trim window. "end" rather than 0.0 for an untrimmed out-point: zero means play
                 through in the model, and a field reading 0.0 would look like a cue that plays
                 nothing. Both values reach the engine only once the file has been probed — the
                 out-point is stored absolute and the document wants it counted back from the end. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Trim in / out">
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding TrimInValue}" LostFocus="OnFieldCommitted" />
                <TextBox Grid.Column="1" Text="{Binding TrimOutValue}" LostFocus="OnFieldCommitted" />
                <!-- Two boxes are enough for a sting and hopeless for "half an hour off a concert",
                     which is what the editor is for. -->
                <Button Grid.Column="2" Classes="tight" Content="✎" Click="OnEditClip"
                        IsEnabled="{Binding CanEditClip}" />
              </Grid>
            </HeaderedContentControl>
            <ContentControl Theme="{StaticResource FieldWide}">
              <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding TrimHint}" />
            </ContentControl>
            <CheckBox Margin="10,2,10,4" IsChecked="{Binding LoopValue}"
                      Content="Loop until stopped" />

            <!-- Every cue simply STOPPED before this existed. Freeze is what a title card wants; fade
                 out gives a cue its own out-ramp without a fade cue aimed at it. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="At end">
              <ComboBox ItemsSource="{Binding EndBehaviours}" SelectedIndex="{Binding EndBehaviourIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Loop overlap"
                                    IsVisible="{Binding IsLooping}">
              <NumericUpDown Minimum="0" Maximum="30000" Increment="100" FormatString="0"
                             Value="{Binding LoopCrossfadeValue}"
                             ToolTip.Tip="Milliseconds of overlap when the loop wraps. A seamless loop is made of this; zero is a hard cut." />
            </HeaderedContentControl>
            <!-- Phrased as the positive: a checkbox called "disable", ticked to mean "do not", is one
                 an operator has to read twice under pressure. -->
            <CheckBox Margin="10,2,10,4" IsChecked="{Binding PreRollValue}"
                      Content="Pre-roll — open this cue's media before it fires"
                      ToolTip.Tip="On by default. Turn it off for a clip that costs more to hold open than it saves, or whose open starts something early." />

            <ContentControl Theme="{StaticResource Subhead}" Content="Sends → logical outputs" />
            <!-- The bottom padding is for the horizontal scrollbar: it is an overlay, so without room
                 of its own it sits on top of the last row of cells and hides the gain there. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Margin="10,2,10,0" Padding="0,0,0,12">
              <!-- The same gesture vocabulary as the patch: an operator who learns it on one matrix
                   must find it true on the other. -->
              <c:MatrixView Columns="{Binding SendColumns}" Rows="{Binding SendRows}"
                            RowHeaderWidth="44"
                            Gesture="OnSendGesture"
                            PointerReleased="OnSendGestureEnded"
                            ToolTip.Tip="Click routes at unity · drag adjusts gain · right-click mutes." />
            </ScrollViewer>

            <Border Classes="chain flush">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="badge"><TextBlock Text="PRESETS" /></Border>
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                           Text="stereo → Main · mono from L · swap · clear" />
              </StackPanel>
            </Border>

            <!-- The effective route for the picked cell, read from the middle: this is the answer to
                 "why is this silent" and to "why is it coming out twice". -->
            <Border Classes="chain">
              <StackPanel Spacing="4">
                <TextBlock Classes="mono dim3 small" IsVisible="{Binding !HasRoute}"
                           Text="this channel reaches nothing — no send, or nothing patched under it" />
                <ItemsControl ItemsSource="{Binding RouteChain}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RouteHop">
                      <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="4" Margin="0,2">
                        <Border Classes="node src"><TextBlock Text="{Binding Source}" /></Border>
                        <TextBlock Classes="mono dim3" VerticalAlignment="Center" Text="→" />
                        <Border Classes="node log"><TextBlock Text="{Binding Logical}" /></Border>
                        <TextBlock Classes="mono dim3" VerticalAlignment="Center" Text="→" />
                        <Border Classes="node phy"><TextBlock Text="{Binding Line}" /></Border>
                        <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                                   Text="{Binding Gain}" />
                        <Border Classes="badge bad" IsVisible="{Binding IsMuted}">
                          <TextBlock Text="MUTED" />
                        </Border>
                      </WrapPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ══ VIDEO ═════════════════════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsVideoPane}" Margin="0,6,0,8">
            <!-- A cue with no placement is not on any canvas. Saying so beats four fields and an
                 empty frame, which read as a layer sized to nothing. -->
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding !HasPlacement}">
              <Border Classes="chain">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Classes="badge"><TextBlock Text="NOT PLACED" /></Border>
                  <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="this cue is on no composition — add it to one to give it a canvas" />
                </StackPanel>
              </Border>
            </ContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Place on"
                                    IsVisible="{Binding !HasPlacement}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox Grid.Column="0" ItemsSource="{Binding PlacementCompositions}"
                          SelectedIndex="{Binding PlacementTarget}" />
                <Button Grid.Column="1" Classes="tight" Content="PLACE" Click="OnPlace" />
              </Grid>
            </HeaderedContentControl>

            <!-- Cover art is a still image and it is placeable: an audio cue can put the album art on
                 a canvas for the length of the track. Saying so before somebody places it is the
                 difference between "why is it not moving" and a deliberate choice. -->
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding IsCoverArtOnly}">
              <Border Classes="chain">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Classes="badge"><TextBlock Text="STILL IMAGE" /></Border>
                  <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding CoverArtNote}" />
                </StackPanel>
              </Border>
            </ContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Video track"
                                    IsEnabled="{Binding VideoTrack.HasMedia}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox Grid.Column="0" ItemsSource="{Binding VideoTrack.Options}"
                          SelectedIndex="{Binding VideoTrack.SelectedIndex}" />
                <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                           Text="{Binding VideoTrack.Hint}" />
              </Grid>
            </HeaderedContentControl>
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding VideoTrack.HasMoved}">
              <Border Classes="chain">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Classes="badge bad"><TextBlock Text="TRACK MOVED" /></Border>
                  <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding VideoTrack.MovedNote}" />
                </StackPanel>
              </Border>
            </ContentControl>

            <!-- Subtitles are a LIST: a show routinely uses an embedded track for one language and a
                 hand-corrected sidecar for another. Never on by default. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Subtitles">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Classes="ro" IsReadOnly="True" Text="{Binding SubtitleSummary}" />
                <Button Grid.Column="1" Classes="tight" Content="CHOOSE…" Click="OnChooseSubtitles"
                        IsEnabled="{Binding CanChooseSubtitles}" />
              </Grid>
            </HeaderedContentControl>

            <StackPanel IsVisible="{Binding HasPlacement}">
              <!-- A cue can be on several canvases at once — a mirror to a second wall, or two regions
                   of one. The engine fans ONE decoded source to all of them, so this costs nothing
                   beyond the compositing; playing the file twice would double the decode and let the
                   copies drift. The picker only appears when there is more than one to choose. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Placement"
                                      IsVisible="{Binding HasSeveralPlacements}">
                <ComboBox ItemsSource="{Binding PlacementNames}"
                          SelectedIndex="{Binding SelectedPlacement}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Composition">
                <ComboBox ItemsSource="{Binding PlacementCompositions}"
                          SelectedIndex="{Binding PlacementCompositionIndex}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Layer">
                <TextBox Classes="short" Text="{Binding LayerValue}" LostFocus="OnFieldCommitted" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Fit">
                <ComboBox ItemsSource="{Binding FitModes}" SelectedIndex="{Binding FitIndex}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Opacity">
                <NumericUpDown Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##"
                               Value="{Binding PlacementOpacity}" />
              </HeaderedContentControl>

              <!-- The destination rectangle as NUMBERS. A drag cannot hit exactly half, and half is
                   what a split screen is made of. -->
              <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Dest x / y">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <NumericUpDown Grid.Column="0" Minimum="-1" Maximum="2" Increment="0.01"
                                 FormatString="0.###" Value="{Binding PlacementX}" />
                  <NumericUpDown Grid.Column="1" Minimum="-1" Maximum="2" Increment="0.01"
                                 FormatString="0.###" Value="{Binding PlacementY}" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Dest w / h">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <NumericUpDown Grid.Column="0" Minimum="0.001" Maximum="2" Increment="0.01"
                                 FormatString="0.###" Value="{Binding PlacementWidth}" />
                  <NumericUpDown Grid.Column="1" Minimum="0.001" Maximum="2" Increment="0.01"
                                 FormatString="0.###" Value="{Binding PlacementHeight}" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Rotation">
                <NumericUpDown Minimum="-360" Maximum="360" Increment="1" FormatString="0.##"
                               Value="{Binding PlacementRotation}"
                               ToolTip.Tip="Clockwise, about the rectangle's centre. A rotated layer overflows its rectangle rather than being trimmed to it." />
              </HeaderedContentControl>

              <ContentControl Theme="{StaticResource FieldWide}">
                <WrapPanel ItemSpacing="4" LineSpacing="4">
                  <Button Classes="tight" Content="FULL" Click="OnLayout" Tag="full" />
                  <Button Classes="tight" Content="◧" Click="OnLayout" Tag="left" ToolTip.Tip="Left half" />
                  <Button Classes="tight" Content="◨" Click="OnLayout" Tag="right" ToolTip.Tip="Right half" />
                  <Button Classes="tight" Content="⬒" Click="OnLayout" Tag="top" ToolTip.Tip="Top half" />
                  <Button Classes="tight" Content="⬓" Click="OnLayout" Tag="bottom" ToolTip.Tip="Bottom half" />
                  <Button Classes="tight" Content="◰" Click="OnLayout" Tag="tl" ToolTip.Tip="Top left" />
                  <Button Classes="tight" Content="◳" Click="OnLayout" Tag="tr" ToolTip.Tip="Top right" />
                  <Button Classes="tight" Content="◱" Click="OnLayout" Tag="bl" ToolTip.Tip="Bottom left" />
                  <Button Classes="tight" Content="◲" Click="OnLayout" Tag="br" ToolTip.Tip="Bottom right" />
                </WrapPanel>
              </ContentControl>

              <!-- The CROP, which is a different question from the destination: which part of the
                   picture to use, not where to put it. Baked-in letterbox bars come off here. -->
              <ContentControl Theme="{StaticResource Subhead}" Content="Source crop" />
              <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Left / top">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <NumericUpDown Grid.Column="0" Minimum="0" Maximum="0.49" Increment="0.01"
                                 FormatString="0.###" Value="{Binding CropLeft}" />
                  <NumericUpDown Grid.Column="1" Minimum="0" Maximum="0.49" Increment="0.01"
                                 FormatString="0.###" Value="{Binding CropTop}" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Right / bottom">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <NumericUpDown Grid.Column="0" Minimum="0" Maximum="0.49" Increment="0.01"
                                 FormatString="0.###" Value="{Binding CropRight}" />
                  <NumericUpDown Grid.Column="1" Minimum="0" Maximum="0.49" Increment="0.01"
                                 FormatString="0.###" Value="{Binding CropBottom}" />
                </Grid>
              </HeaderedContentControl>
              <ContentControl Theme="{StaticResource FieldWide}">
                <WrapPanel ItemSpacing="4" LineSpacing="4">
                  <Button Classes="tight" Content="NO CROP" Click="OnCrop" Tag="none" />
                  <Button Classes="tight" Content="CENTRE ½ WIDE" Click="OnCrop" Tag="wide" />
                  <Button Classes="tight" Content="CENTRE ½ TALL" Click="OnCrop" Tag="tall" />
                  <Button Classes="tight" Content="CENTRE BOX" Click="OnCrop" Tag="centre" />
                </WrapPanel>
              </ContentControl>

              <!-- Both effects follow the app's rule: OFF IS NOT DELETE. The settings survive the
                   toggle, so checking a shot against an unkeyed one costs nothing to undo. -->
              <ContentControl Theme="{StaticResource Subhead}" Content="Chroma key" />
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Key">
                <CheckBox IsChecked="{Binding ChromaKeyOn}" Content="key this layer" />
              </HeaderedContentControl>
              <StackPanel IsVisible="{Binding HasChromaKey}">
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Colour">
                  <TextBox Text="{Binding ChromaColour}" PlaceholderText="#00FF00" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Similar / soft">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <NumericUpDown Grid.Column="0" Minimum="0" Maximum="1" Increment="0.02"
                                   FormatString="0.##" Value="{Binding ChromaSimilarity}" />
                    <NumericUpDown Grid.Column="1" Minimum="0" Maximum="1" Increment="0.02"
                                   FormatString="0.##" Value="{Binding ChromaSmoothness}" />
                  </Grid>
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="Spill">
                  <NumericUpDown Minimum="0" Maximum="1" Increment="0.02" FormatString="0.##"
                                 Value="{Binding ChromaSpill}"
                                 ToolTip.Tip="How much of the key colour is pulled out of what remains — the green fringe." />
                </HeaderedContentControl>
              </StackPanel>

              <ContentControl Theme="{StaticResource Subhead}" Content="Colour" />
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Adjust">
                <CheckBox IsChecked="{Binding ColorAdjustOn}" Content="brightness and contrast" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Bright / contrast"
                                      IsVisible="{Binding ColorAdjustOn}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <NumericUpDown Grid.Column="0" Minimum="-1" Maximum="1" Increment="0.05"
                                 FormatString="0.##" Value="{Binding LayerBrightness}" />
                  <NumericUpDown Grid.Column="1" Minimum="0" Maximum="4" Increment="0.05"
                                 FormatString="0.##" Value="{Binding LayerContrast}" />
                </Grid>
              </HeaderedContentControl>

              <c:AspectBox Margin="10,6" VerticalAlignment="Top">
                <c:PlacementCanvas Boxes="{Binding Placements}"
                                   Gesture="OnPlacementGesture"
                                   GestureCompleted="OnPlacementGestureCompleted" />
              </c:AspectBox>

              <!-- The canvas is a second editor for the same cue data, under the same undo journal —
                   rough here, precise in the Video view. -->
              <Border Classes="chain">
                <DockPanel LastChildFill="True">
                  <Button DockPanel.Dock="Right" Classes="tight" Content="REMOVE" Click="OnRemovePlacement" />
                  <Button DockPanel.Dock="Right" Classes="tight" Margin="0,0,6,0"
                          Content="+ ANOTHER" Click="OnPlace"
                          ToolTip.Tip="Show this cue on another composition — one decode, several canvases." />
                  <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge">
                    <TextBlock Text="PLACEMENT" />
                  </Border>
                  <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                             Text="drag here for rough · Video view for precision" />
                </DockPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- ══ EFFECTS — lanes, hidden until added (register item 18) ═════════════════════ -->
          <StackPanel IsVisible="{Binding IsEffectsPane}" Margin="0,6,0,8">
            <!-- Hidden until added (register item 18): a cue with no automation shows none, rather
                 than four empty lanes implying it has some. -->
            <TextBlock Margin="10,4" Classes="mono dim3 small" IsVisible="{Binding !HasEffectLanes}"
                       Text="no lanes on this cue" />

            <ItemsControl ItemsSource="{Binding EffectLanes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EffectLaneRow">
                  <Border Padding="10,5" BorderBrush="{DynamicResource BoothRuleSoft}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Classes="mono small" Text="{Binding Kind}" />
                        <TextBlock Classes="mono dim3 micro" Text="{Binding Detail}" />
                      </StackPanel>
                      <!-- The SAME editor a fade curve uses: a lane and a curve are one sorted list of
                           normalized points, which is why the plan asks for one editor. -->
                      <Button Grid.Column="1" Classes="icon" Content="✎" Click="OnEditLane"
                              Tag="{Binding Index}" ToolTip.Tip="Edit this lane's points" />
                      <Button Grid.Column="2" Classes="icon" Content="⚙" Click="OnConfigureLane"
                              IsVisible="{Binding IsOutbound}" Tag="{Binding Index}"
                              ToolTip.Tip="Choose endpoint and address" />
                      <Button Grid.Column="3" Classes="icon" Content="×" Click="OnRemoveLane"
                              Tag="{Binding Index}" ToolTip.Tip="Remove this lane" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ContentControl Theme="{StaticResource FieldWide}" Margin="0,6,0,0">
              <Button Classes="block" Content="+ ADD EFFECT LANE ▾" IsEnabled="{Binding CanCarryLanes}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="Volume" Click="OnAddLane" Tag="0" />
                    <MenuItem Header="Opacity" Click="OnAddLane" Tag="1" />
                    <Separator />
                    <MenuItem Header="OSC ramp" Click="OnAddLane" Tag="2" />
                    <MenuItem Header="MIDI ramp" Click="OnAddLane" Tag="3" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </ContentControl>
            <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                       Text="One lane per kind. Volume and opacity reach the engine; outbound ramps are authored but not yet sent. A child's lane overrides the group's same-kind lane." />
          </StackPanel>

          <!-- ══ NOTE — one tab on every kind; stays writable under Lock ════════════════════ -->
          <DockPanel IsVisible="{Binding IsNotePane}" Margin="10,8">
            <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160"
                     Text="{Binding NoteValue}"
                     LostFocus="OnFieldCommitted"
                     PlaceholderText="Notes stay writable under Lock."
                     VerticalContentAlignment="Top" />
          </DockPanel>

          <!-- ══ PREVIEW ═══════════════════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsPreviewPane}" Margin="0,8,0,8">
            <ContentControl Theme="{StaticResource FieldWide}">
              <Button Classes="primary block" Content="PREVIEW ON AUDITION OUTPUTS" Click="OnPreview" />
            </ContentControl>
            <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                       Text="Plays into the audition rig — the monitor path. It never touches the patch or the program bus, and never appears in the Active list." />
          </StackPanel>

          <!-- ══ GROUP — playlist crossfades (register item 17) ═════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsGroupPane}" Margin="0,6,0,8">
            <!-- All of this was hard-coded markup: fire mode was pinned to "playlist", so a timeline
                 group described itself as one. Bound to the cue now. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Fire mode">
              <ComboBox ItemsSource="{Binding FireModes}" SelectedIndex="{Binding FireModeIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Children">
              <TextBox Classes="ro" IsReadOnly="True" Text="{Binding ChildCount}" />
            </HeaderedContentControl>

            <!-- A timeline group has authored offsets, so it opens the sheet instead of shuffling. -->
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding IsTimelineGroup}">
              <Button Classes="block" Content="OPEN TIMELINE ›" Click="OnOpenTimeline" />
            </ContentControl>

            <StackPanel IsVisible="{Binding IsPlaylistGroup}">
              <CheckBox Margin="10,3" IsChecked="{Binding ShuffleValue}"
                        Content="Shuffle" />
              <CheckBox Margin="10,3" IsChecked="{Binding ReshuffleValue}"
                        Content="Reshuffle each pass" />
              <!-- Only while shuffling: an in-order playlist repeats by construction, and a checkbox
                   that does nothing is worse than one that is not there. -->
              <CheckBox Margin="10,3" IsChecked="{Binding AvoidRepeatValue}"
                        IsVisible="{Binding ShuffleValue}"
                        Content="Never repeat across a pass boundary"
                        ToolTip.Tip="Without this a shuffled bed can play the same item twice in a row when a pass wraps — which reads as a fault rather than as chance." />

              <HeaderedContentControl Theme="{StaticResource Field}" Header="Passes">
                <NumericUpDown Minimum="0" Maximum="999" Increment="1" FormatString="0"
                               Value="{Binding LoopCountValue}"
                               ToolTip.Tip="How many times through the list. 0 is forever. What happens AFTER the last pass is the At end setting below." />
              </HeaderedContentControl>

              <ContentControl Theme="{StaticResource Subhead}" Content="Crossfade between items" />
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Default">
                <TextBox Classes="short" Text="{Binding CrossfadeValue}" LostFocus="OnFieldCommitted" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="Curve">
                <ComboBox ItemsSource="{Binding CrossfadeCurve.Curves}"
                          SelectedIndex="{Binding CrossfadeCurve.SelectedIndex}"
                          ItemTemplate="{StaticResource CurveItemTemplate}"
                          SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
              </HeaderedContentControl>
            </StackPanel>

            <HeaderedContentControl Theme="{StaticResource Field}" Header="At end">
              <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding AtEndOptions}"
                       SelectedIndex="{Binding AtEndIndex}" />
            </HeaderedContentControl>
            <TextBlock Margin="10,6" Classes="mono dim3 small"
                       Text="per-transition overrides: set on a child's General tab · 2 set" />
          </StackPanel>

          <!-- ══ PATCH — snapshot recall AND inline level changes (register item 12) ════════ -->
          <StackPanel IsVisible="{Binding IsPatchPane}" Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Recall">
              <ComboBox ItemsSource="{Binding PatchSnapshots}"
                        SelectedIndex="{Binding PatchSnapshotIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Fade">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding PatchFadeValue}" LostFocus="OnFieldCommitted" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding PatchCurve.Curves}"
                          SelectedIndex="{Binding PatchCurve.SelectedIndex}"
                          ItemTemplate="{StaticResource CurveItemTemplate}"
                          SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
              </Grid>
            </HeaderedContentControl>

            <ContentControl Theme="{StaticResource Subhead}" Content="Also change" />
            <!-- The cue's OWN level changes. This pane used to show two fixed rows whatever the cue
                 carried, so one with three changes showed two and one with none still showed two. -->
            <TextBlock Margin="10,2" Classes="mono dim3 small" IsVisible="{Binding !HasPatchLevelChanges}"
                       Text="no inline level changes" />
            <ItemsControl ItemsSource="{Binding PatchLevelChanges}" Margin="10,2">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Classes="mono dim2 small" Margin="0,2" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ContentControl Theme="{StaticResource FieldWide}">
              <Button Classes="quiet" Content="+ add level change…" Click="OnAddLevelChange" />
            </ContentControl>

            <!-- A patch cue changes the console and leaves it changed: stopping it undoes nothing. -->
            <Border Classes="chain">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge"><TextBlock Text="PERSISTENT" /></Border>
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="applies to the patch and stays — stopping this cue undoes nothing" />
              </DockPanel>
            </Border>
            <TextBlock Margin="10,6" Classes="mono warn small" TextWrapping="Wrap"
                       IsVisible="{Binding PatchHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding PatchHint}" />
          </StackPanel>

          <!-- ══ FADE — targets, duration, curve, fade-everything ══════════════════════════ -->
          <StackPanel IsVisible="{Binding IsFadePane}" Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="To level">
              <TextBox Classes="short" Text="{Binding FadeToLevelValue}" LostFocus="OnFieldCommitted"
                       ToolTip.Tip="A level in dB, or “-inf” / “off” for silence." />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Duration">
              <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding FadeDurationValue}" LostFocus="OnFieldCommitted" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FadeCurve.Curves}"
                          SelectedIndex="{Binding FadeCurve.SelectedIndex}"
                          ItemTemplate="{StaticResource CurveItemTemplate}"
                          SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
                <Button Grid.Column="2" Classes="icon" Content="✎" Click="OnEditCurve" Tag="fade" />
              </Grid>
            </HeaderedContentControl>
            <CheckBox Margin="10,4" IsChecked="{Binding FadeEverythingValue}"
                      Content="Fade everything currently sounding" />
            <CheckBox Margin="10,4" IsChecked="{Binding FadeStopsTargetsValue}"
                      Content="Stop the targets when the fade completes" />

            <ContentControl Theme="{StaticResource Subhead}" Content="Logical outputs" />
            <ItemsControl ItemsSource="{Binding FadeTargets}" Margin="10,2">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TargetToggle">
                  <CheckBox Margin="0,1" IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                       Text="{Binding FadeTargetHint}" />
          </StackPanel>

          <!-- ══ JUMP — targets, random pick, fire-on-jump ═════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsJumpPane}" Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Jump to">
              <ComboBox ItemsSource="{Binding JumpTargets}" SelectedIndex="{Binding JumpTargetIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Condition">
              <ComboBox ItemsSource="{Binding JumpConditions}"
                        SelectedIndex="{Binding JumpConditionIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Jump visits"
                                    IsVisible="{Binding IsCountedJump}">
              <TextBox Classes="short" Text="{Binding JumpCountValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <CheckBox Margin="10,4" IsChecked="{Binding JumpPickAtRandomValue}"
                      Content="Pick at random from a list of targets" />
            <CheckBox Margin="10,4" IsChecked="{Binding JumpFiresOnArrivalValue}"
                      Content="Fire the target cue on arrival" />
            <!-- A jump that lands somewhere no longer in the show is one of the checks Project status
                 runs; the editor says so rather than letting it become a get-in surprise. -->
            <TextBlock Margin="10,6" Classes="mono warn small" TextWrapping="Wrap"
                       IsVisible="{Binding JumpHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding JumpHint}" />
          </StackPanel>

          <!-- ══ TEXT — words on a canvas ══════════════════════════════════════════════════
               The document stores WORDS, not a picture: portable, diffable, and translatable. The
               app draws them into its media cache when the show is compiled, so a card carried to
               another booth is redrawn there with whatever faces that machine has. -->
          <StackPanel IsVisible="{Binding IsTextPane}" Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Words">
              <TextBox Text="{Binding CardText}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="90" VerticalContentAlignment="Top"
                       PlaceholderText="the words on the card" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Face">
              <TextBox Text="{Binding CardFont}"
                       PlaceholderText="the app's own — matched by name, like a device hint"
                       ToolTip.Tip="A hint. A booth machine that does not have this face falls back to a readable one rather than refusing to draw." />
            </HeaderedContentControl>
            <!-- A FRACTION of the frame, not points: a card authored at 72 pt on a 1280×720 canvas
                 is unreadable on a 4 K one. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Size">
              <NumericUpDown Minimum="0.01" Maximum="1" Increment="0.01" FormatString="0.###"
                             Value="{Binding CardSize}"
                             ToolTip.Tip="Cap height as a fraction of the frame height, so the card survives a canvas resize." />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Weight">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <CheckBox Grid.Column="0" IsChecked="{Binding CardBold}" Content="bold" />
                <CheckBox Grid.Column="1" IsChecked="{Binding CardItalic}" Content="italic" />
              </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Ink / ground">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding CardInk}" PlaceholderText="#FFFFFF" />
                <TextBox Grid.Column="1" Text="{Binding CardGround}" PlaceholderText="transparent" />
              </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Align">
              <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding CardAligns}"
                       SelectedIndex="{Binding CardAlignIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Anchor">
              <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding CardAnchors}"
                       SelectedIndex="{Binding CardAnchorIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Fade in / out">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <NumericUpDown Grid.Column="0" Minimum="0" Maximum="60000" Increment="100"
                               FormatString="0" Value="{Binding CardFadeIn}" />
                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="60000" Increment="100"
                               FormatString="0" Value="{Binding CardFadeOut}" />
              </Grid>
            </HeaderedContentControl>
            <ContentControl Theme="{StaticResource FieldWide}">
              <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding CardHint}" />
            </ContentControl>
          </StackPanel>

          <!-- ══ VISUALIZER — the ONLY home of visualizer settings (register item 21) ═══════ -->
          <StackPanel IsVisible="{Binding IsVisualizerPane}" Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Preset pack">
              <TextBox Text="{Binding VisualizerPresetPackValue}" LostFocus="OnFieldCommitted"
                       PlaceholderText="a preset directory under the projectM pack root" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Hold each">
              <TextBox Classes="short" Text="{Binding VisualizerHoldValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Blend">
              <TextBox Classes="short" Text="{Binding VisualizerBlendValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Audio feed">
              <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                         Text="program bus · upstream of per-line inserts" />
            </HeaderedContentControl>
            <CheckBox Margin="10,4" IsChecked="{Binding VisualizerLocksPresetValue}"
                      Content="Lock to this preset (no auto-advance)" />
            <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                       Text="Placement lives on the Video tab — a visualizer is a cue, and its canvas presence is an ordinary layer." />
            <TextBlock Margin="10,2,10,6" Classes="mono warn small" TextWrapping="Wrap"
                       Text="{Binding VisualizerHint}" />
          </StackPanel>

          <!-- ══ ACTION — endpoint, address, arguments ═════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsActionPane}" Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Endpoint">
              <ComboBox ItemsSource="{Binding ActionEndpoints}"
                        SelectedIndex="{Binding ActionEndpointIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Address">
              <TextBox Text="{Binding ActionAddressValue}" LostFocus="OnFieldCommitted"
                       PlaceholderText="/eos/cue/2/fire" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="Arguments">
              <TextBox Text="{Binding ActionArgumentsValue}" LostFocus="OnFieldCommitted"
                       PlaceholderText="whitespace-separated" />
            </HeaderedContentControl>
            <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                       Text="{Binding ActionHint}" />
          </StackPanel>

        </Panel>
      </ScrollViewer>
    </DockPanel>
  </Panel>
</UserControl>
