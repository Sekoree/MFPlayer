<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:HaCue2.Resources"
             xmlns:c="using:HaCue2.Controls"
             xmlns:sys="using:System"
             xmlns:vm="using:HaCue2.ViewModels"
             xmlns:v="using:HaCue2.Views"
             x:Class="HaCue2.Views.InspectorPane"
             x:DataType="vm:InspectorViewModel"
             x:CompileBindings="True">

  <!-- Screens 02 and 04. The tab SET follows the cue kind and the chosen tab is remembered per kind;
       "Note" (singular) is on every kind. Selecting a cue never flips the right panel to this pane,
       and with nothing selected it shows the no-selection state rather than the last cue. -->

  <Panel>

    <!-- no-selection state -->
    <TextBlock IsVisible="{Binding !HasSelection}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Classes="mono dim3 small" Text="{x:Static res:Strings.InspSelectACueToEdit}" />

    <DockPanel IsVisible="{Binding HasSelection}">

      <ListBox DockPanel.Dock="Top"
               Theme="{StaticResource SectionTabs}"
               ItemsSource="{Binding Tabs}"
               SelectedItem="{Binding SelectedTab}" />

      <Border DockPanel.Dock="Top" Classes="chain flush"
              IsVisible="{Binding IsMultiSelection}">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge">
            <TextBlock Text="{x:Static res:Strings.InspMulti}" />
          </Border>
          <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="{Binding MultiSelectionNote}" />
        </DockPanel>
      </Border>

      <ScrollViewer>
        <Panel>

          <!-- ══ GENERAL ═══════════════════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsGeneralPane}" IsEnabled="{Binding CanAuthor}"
                      Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspNumber}">
              <TextBox Text="{Binding NumberValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspLabel}">
              <TextBox Text="{Binding LabelValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspTrigger}">
              <ListBox Theme="{StaticResource Segment}" SelectedIndex="{Binding TriggerIndex}">
                <ListBoxItem>manual</ListBoxItem>
                <ListBoxItem>follow</ListBoxItem>
                <ListBoxItem>continue</ListBoxItem>
              </ListBox>
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspPrePostWait}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding PreWaitValue}" LostFocus="OnFieldCommitted" />
                <TextBox Grid.Column="1" Text="{Binding PostWaitValue}" LostFocus="OnFieldCommitted" />
              </Grid>
            </HeaderedContentControl>
            <!-- A band on the row, addressed by palette index rather than by colour so it restyles
                 with the theme and a travelling show carries no hex codes. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspColour}">
              <ComboBox ItemsSource="{Binding ColorTags}" SelectedIndex="{Binding ColorTagIndex}"
                        ToolTip.Tip="{x:Static res:Strings.InspABandAtTheLeft}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspAtMediaEnd}"
                                    IsVisible="{Binding HasMediaCue}">
              <ComboBox ItemsSource="{Binding EndTargetOptions}" SelectedIndex="{Binding EndTargetIndex}"
                        ToolTip.Tip="{x:Static res:Strings.InspAnExplicitTargetOverridesOrdinary}" />
            </HeaderedContentControl>
            <!-- A source cue's media is a URI, not a file, so there is no path to read here and no
                 file picker that could change it. Named rather than shown raw: the URI is mostly
                 punctuation, and what identifies the cue is the camera or the device. -->
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding IsSourceCue}">
              <Border Classes="chain">
                <DockPanel LastChildFill="True">
                  <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge">
                    <TextBlock Text="{x:Static res:Strings.InspSource}" />
                  </Border>
                  <TextBlock Classes="mono dim2 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding SourceNote}" />
                </DockPanel>
              </Border>
            </ContentControl>
            <!-- A disabled cue stays visible and is skipped by GO and by auto-follow - deleting a cue
                 to drop it for one performance is how shows lose cues. -->
            <CheckBox Margin="10,6,10,0" IsChecked="{Binding IsEnabled}"
                      Content="{x:Static res:Strings.InspEnabledGoAndAutoFollow}" />

            <!-- Finite-media playback is part of the cue's general identity. A silent video still has
                 an in-point and an out-point, but those controls do not warrant a separate tab. Live
                 sources omit this whole section because they have no stable beginning or end. -->
            <StackPanel IsVisible="{Binding CanTrimMedia}">
              <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.ClipEdClip}" />
              <!-- "end" rather than 0.0 for an untrimmed out-point: zero means play through in the
                   model, and a field reading 0.0 looks like a cue that plays nothing. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspTrimInOut}">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Text="{Binding TrimInValue}" LostFocus="OnFieldCommitted"
                           PlaceholderText="{x:Static res:Strings.InspIn}" AutomationProperties.Name="Trim in" />
                  <TextBox Grid.Column="1" Text="{Binding TrimOutValue}" LostFocus="OnFieldCommitted"
                           PlaceholderText="{x:Static res:Strings.InspEnd}" AutomationProperties.Name="Trim out" />
                  <!-- Two boxes are enough for a sting and hopeless for finding a cut in a concert;
                       the waveform editor is the precise version for an ordinary local file. -->
                  <Button Grid.Column="2" Classes="tight" Content="{x:Static res:Strings.InspEdit}" Click="OnEditClip"
                          IsEnabled="{Binding CanEditClip}"
                          AutomationProperties.Name="Open clip trimming editor"
                          ToolTip.Tip="{Binding ClipEditorHint}" />
                </Grid>
              </HeaderedContentControl>
              <ContentControl Theme="{StaticResource FieldWide}">
                <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding TrimHint}" />
              </ContentControl>

              <CheckBox Margin="10,2,10,4" IsChecked="{Binding LoopValue}"
                        Content="{x:Static res:Strings.InspLoopUntilStopped}" />

              <!-- Every cue simply STOPPED before this existed. Freeze is what a title card wants; fade
                   out gives a cue its own out-ramp without a fade cue aimed at it. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspAtEnd}">
                <ComboBox ItemsSource="{Binding EndBehaviours}" SelectedIndex="{Binding EndBehaviourIndex}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspLoopOverlap}"
                                      IsVisible="{Binding IsLooping}">
                <NumericUpDown Minimum="0" Maximum="30000" Increment="100" FormatString="0"
                               Value="{Binding LoopCrossfadeValue}"
                               ToolTip.Tip="{x:Static res:Strings.InspMillisecondsOfOverlapWhenThe}" />
              </HeaderedContentControl>
              <CheckBox Margin="10,2,10,4" IsChecked="{Binding PreRollValue}"
                        Content="{x:Static res:Strings.InspPreRollOpenThisCue}"
                        ToolTip.Tip="{x:Static res:Strings.InspOnByDefaultTurnIt}" />
            </StackPanel>
          </StackPanel>

          <!-- ══ AUDIO ═════════════════════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsAudioPane}" IsEnabled="{Binding CanAuthor}"
                      Margin="0,6,0,8">
            <!-- A concert capture routinely carries several audio tracks - a stereo mix, an isolated
                 vocal, a room pair. Which one this cue plays is an authoring decision, and the sends
                 below are the channels OF THAT TRACK. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspTrack}"
                                    IsEnabled="{Binding AudioTrack.HasMedia}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox Grid.Column="0" ItemsSource="{Binding AudioTrack.Options}"
                          SelectedIndex="{Binding AudioTrack.SelectedIndex}" />
                <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                           Text="{Binding AudioTrack.Hint}" />
              </Grid>
            </HeaderedContentControl>
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding AudioTrack.HasMoved}">
              <Border Classes="chain">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Classes="badge bad"><TextBlock Text="{x:Static res:Strings.InspTrackMoved}" /></Border>
                  <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding AudioTrack.MovedNote}" />
                </StackPanel>
              </Border>
            </ContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudnLevel}">
              <TextBox Classes="short" Text="{Binding LevelValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <TextBlock Classes="small dim2" TextWrapping="Wrap" Margin="0,0,0,6"
                       IsVisible="{Binding LevelIsAutomated}"
                       Text="{Binding LevelAutomationNote}" />
            <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.InspCueInserts}" />
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspGain}">
              <CheckBox IsChecked="{Binding AudioGainOn}" Content="{x:Static res:Strings.InspGainInsert}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspInsertGain}"
                                    IsVisible="{Binding HasAudioGain}">
              <NumericUpDown Minimum="-96" Maximum="12" Increment="0.5" FormatString="0.0"
                             Value="{Binding AudioGainDb}" />
            </HeaderedContentControl>
            <Button Classes="block" Content="{x:Static res:Strings.InspAutomateInsertGain}"
                    IsVisible="{Binding HasAudioGain}" IsEnabled="{Binding CanAddAudioGainLane}"
                    Click="OnAddLane" Tag="audio.effect.parameter.gain.v1.gainDb" />
            <CheckBox Margin="10,2,10,4" IsChecked="{Binding SendToVisualizerValue}"
                      Content="{x:Static res:Strings.InspSendToSelectiveVisualizerFeeds}" />
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspFadeIn}">
              <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding FadeValue}" LostFocus="OnFieldCommitted" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CurveChoices}"
                          SelectedIndex="{Binding FadeInCurveIndex, Mode=TwoWay}"
                          ItemTemplate="{StaticResource CurveItemTemplate}"
                          SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
                <Button Grid.Column="2" Classes="icon" Content="✎" Click="OnEditCurve" Tag="fadeIn"
                        ToolTip.Tip="{x:Static res:Strings.InspCustomCurveEditorDragPoints}" />
              </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspFadeOut}">
              <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding FadeOutValue}" LostFocus="OnFieldCommitted" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CurveChoices}"
                          SelectedIndex="{Binding FadeOutCurveIndex, Mode=TwoWay}"
                          ItemTemplate="{StaticResource CurveItemTemplate}"
                          SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
                <Button Grid.Column="2" Classes="icon" Content="✎" Click="OnEditCurve" Tag="fadeOut" />
              </Grid>
            </HeaderedContentControl>

            <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.InspSendsLogicalOutputs}" />
            <!-- Both axes have a viewport. The matrix can be taller than the remaining inspector and
                 Avalonia's overlay bars grow under the pointer, so a 40 px bottom gutter keeps the
                 final send row clear even while the horizontal bar is active. -->
            <ScrollViewer Name="CueSendMatrixViewport"
                          AutomationProperties.Name="Cue send matrix viewport"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          MaxHeight="360"
                          Margin="10,2,10,6">
              <!-- Padding belongs to the CONTENT, not the ScrollViewer. ScrollViewer padding is
                   removed from the child's arrange slot and used to crush this 68 px matrix to its
                   28 px header; content padding becomes part of the scroll extent instead. -->
              <Border Name="CueSendMatrixContent" Padding="0,0,20,40">
                <!-- The same gesture vocabulary as the patch: an operator who learns it on one matrix
                     must find it true on the other. -->
                <c:MatrixView Columns="{Binding Audio.SendColumns}" Rows="{Binding Audio.SendRows}"
                              AutomationProperties.Name="Cue audio send matrix"
                              RowHeaderWidth="44"
                              Gesture="OnSendGesture"
                              PointerReleased="OnSendGestureEnded"
                              ToolTip.Tip="{x:Static res:Strings.InspClickRoutesAtUnityDrag}" />
              </Border>
            </ScrollViewer>

            <!-- The four routings almost every cue wants, which the matrix above can only do one
                 careful click at a time. They apply to the WHOLE selection, so a stem group goes to
                 Main in one gesture and one undo. -->
            <Border Classes="chain flush">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="badge"><TextBlock Text="{x:Static res:Strings.AudPresets}" /></Border>
                <Button Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.InspStereoMain}"
                        Click="OnSendPreset" Tag="stereo"
                        IsEnabled="{Binding Audio.HasSendPresetTarget}"
                        ToolTip.Tip="{x:Static res:Strings.InspSource1And2To}" />
                <Button Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.InspMonoFromL}"
                        Click="OnSendPreset" Tag="monoL"
                        IsEnabled="{Binding Audio.HasSendPresetTarget}"
                        ToolTip.Tip="{x:Static res:Strings.InspSource1ToBothSides}" />
                <Button Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.InspSwap}"
                        Click="OnSendPreset" Tag="swap"
                        IsEnabled="{Binding Audio.HasSendPresetTarget}"
                        ToolTip.Tip="{x:Static res:Strings.InspExchangeTheTwoSourceChannels}" />
                <Button Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.InspClear}"
                        Click="OnSendPreset" Tag="clear"
                        ToolTip.Tip="{x:Static res:Strings.InspRemoveEverySendOnThis}" />
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                           Text="{Binding Audio.SendPresetTarget}" />
              </StackPanel>
            </Border>

            <!-- The effective route for the picked cell, read from the middle: this is the answer to
                 "why is this silent" and to "why is it coming out twice". -->
            <Border Classes="chain">
              <StackPanel Spacing="4">
                <TextBlock Classes="mono dim3 small" IsVisible="{Binding !Audio.HasRoute}"
                           Text="{x:Static res:Strings.InspThisChannelReachesNothingNo}" />
                <ItemsControl ItemsSource="{Binding Audio.RouteChain}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RouteHop">
                      <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="4" Margin="0,2">
                        <Border Classes="node src"><TextBlock Text="{Binding Source}" /></Border>
                        <TextBlock Classes="mono dim3" VerticalAlignment="Center" Text="→" />
                        <Border Classes="node log"><TextBlock Text="{Binding Logical}" /></Border>
                        <TextBlock Classes="mono dim3" VerticalAlignment="Center" Text="→" />
                        <Border Classes="node phy"><TextBlock Text="{Binding Line}" /></Border>
                        <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                                   Text="{Binding Gain}" />
                        <Border Classes="badge bad" IsVisible="{Binding IsMuted}">
                          <TextBlock Text="{x:Static res:Strings.InspMuted}" />
                        </Border>
                      </WrapPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ══ VIDEO ═════════════════════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsVideoPane}" IsEnabled="{Binding CanAuthor}"
                      Margin="0,6,0,8">
            <!-- A cue with no placement is not on any canvas. Saying so beats four fields and an
                 empty frame, which read as a layer sized to nothing. -->
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding !HasPlacement}">
              <Border Classes="chain">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Classes="badge"><TextBlock Text="{x:Static res:Strings.InspNotPlaced}" /></Border>
                  <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{x:Static res:Strings.InspThisCueIsOnNo}" />
                </StackPanel>
              </Border>
            </ContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspPlaceOn}"
                                    IsVisible="{Binding !HasPlacement}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox Grid.Column="0" ItemsSource="{Binding PlacementCompositions}"
                          SelectedIndex="{Binding PlacementTarget}" />
                <Button Grid.Column="1" Classes="tight" Content="{x:Static res:Strings.InspPlace}" Click="OnPlace" />
              </Grid>
            </HeaderedContentControl>

            <!-- Cover art is a still image and it is placeable: an audio cue can put the album art on
                 a canvas for the length of the track. Saying so before somebody places it is the
                 difference between "why is it not moving" and a deliberate choice. -->
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding IsCoverArtOnly}">
              <Border Classes="chain">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Classes="badge"><TextBlock Text="{x:Static res:Strings.InspStillImage}" /></Border>
                  <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding CoverArtNote}" />
                </StackPanel>
              </Border>
            </ContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspVideoTrack}"
                                    IsEnabled="{Binding VideoTrack.HasMedia}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox Grid.Column="0" ItemsSource="{Binding VideoTrack.Options}"
                          SelectedIndex="{Binding VideoTrack.SelectedIndex}" />
                <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                           Text="{Binding VideoTrack.Hint}" />
              </Grid>
            </HeaderedContentControl>
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding VideoTrack.HasMoved}">
              <Border Classes="chain">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Classes="badge bad"><TextBlock Text="{x:Static res:Strings.InspTrackMoved}" /></Border>
                  <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding VideoTrack.MovedNote}" />
                </StackPanel>
              </Border>
            </ContentControl>

            <!-- Subtitles are a LIST: a show routinely uses an embedded track for one language and a
                 hand-corrected sidecar for another. Never on by default. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspSubtitles}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Classes="ro" IsReadOnly="True" Text="{Binding SubtitleSummary}" />
                <Button Grid.Column="1" Classes="tight" Content="{x:Static res:Strings.InspChoose}" Click="OnChooseSubtitles"
                        IsEnabled="{Binding CanChooseSubtitles}" />
              </Grid>
            </HeaderedContentControl>

            <!-- Every placement is a real expander. Its closed header still identifies the canvas,
                 layer and geometry; opening it selects that placement and reveals its complete editor. -->
            <ItemsControl ItemsSource="{Binding PlacementHeaders}" Margin="10,2,10,4"
                          IsVisible="{Binding HasPlacement}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlacementHeader">
                  <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            IsExpanded="{Binding IsOpen, Mode=OneWay}"
                            Expanding="OnPlacementExpanding"
                            Tag="{Binding Index}">
                    <Expander.Header>
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="7">
                        <Border Grid.Row="0" Grid.Column="0" Classes="badge">
                          <TextBlock Text="{Binding Layer}" />
                        </Border>
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="cuelabel"
                                   VerticalAlignment="Center" Text="{Binding Composition}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono dim3 micro"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Summary}" />
                      </Grid>
                    </Expander.Header>
                    <v:PlacementEditorPane
                        DataContext="{Binding $parent[v:InspectorPane].((vm:InspectorViewModel)DataContext)}" />
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Adding is separate from any one row: the target is explicit and remains reachable
                 even when every placement is collapsed. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspAnotherPlacement}"
                                    IsVisible="{Binding HasPlacement}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox Grid.Column="0" ItemsSource="{Binding PlacementCompositions}"
                          SelectedIndex="{Binding PlacementTarget}" />
                <Button Grid.Column="1" Classes="tight" Content="{x:Static res:Strings.InspAdd}" Click="OnPlace"
                        ToolTip.Tip="{x:Static res:Strings.InspShowThisCueOnAnother}" />
              </Grid>
            </HeaderedContentControl>
          </StackPanel>

          <!-- ══ AUTOMATION - property tracks, hidden until added (register item 18) ═══════ -->
          <StackPanel IsVisible="{Binding IsEffectsPane}" IsEnabled="{Binding CanAuthor}"
                      Margin="0,6,0,8">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding IsAutomationCue}">
              <HeaderedContentControl Grid.Column="0" Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspDurationS}">
                <TextBox Text="{Binding AutomationDuration}" />
              </HeaderedContentControl>
              <HeaderedContentControl Grid.Column="1" Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspAtCompletion}">
                <CheckBox Margin="10,7" Content="{x:Static res:Strings.InspRestoreAuthoredValues}"
                          IsChecked="{Binding AutomationRestoreBase, Mode=TwoWay}" />
              </HeaderedContentControl>
            </Grid>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspTargetCue}"
                                    IsVisible="{Binding IsAutomationCue}">
              <ComboBox ItemsSource="{Binding AutomationTargetCues}"
                        SelectedIndex="{Binding AutomationTargetCueIndex, Mode=TwoWay}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspTargetPlacement}"
                                    IsVisible="{Binding HasMultipleAutomationTargetPlacements}">
              <ComboBox ItemsSource="{Binding AutomationTargetPlacements}"
                        SelectedIndex="{Binding AutomationTargetPlacementIndex, Mode=TwoWay}" />
            </HeaderedContentControl>
            <!-- Hidden until added (register item 18): a cue with no automation shows none, rather
                 than four empty lanes implying it has some. -->
            <TextBlock Margin="10,4" Classes="mono dim3 small" IsVisible="{Binding !HasEffectLanes}"
                       Text="{x:Static res:Strings.InspNoAutomationTracksOnThis}" />

            <ItemsControl ItemsSource="{Binding EffectLanes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EffectLaneRow">
                  <Border Padding="10,5" BorderBrush="{DynamicResource BoothRuleSoft}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Classes="mono small" Text="{Binding Kind}" />
                        <TextBlock Classes="mono dim3 micro" Text="{Binding Detail}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="icon" Content="✎" Click="OnEditLane"
                              Tag="{Binding Index}" ToolTip.Tip="{x:Static res:Strings.InspOpenTheScrollableAbsoluteTime}" />
                      <Button Grid.Column="2" Classes="icon" Content="⚙" Click="OnConfigureLane"
                              IsVisible="{Binding IsOutbound}" Tag="{Binding Index}"
                              ToolTip.Tip="{x:Static res:Strings.InspChooseEndpointAndAddress}" />
                      <Button Grid.Column="3" Classes="icon" Content="×" Click="OnRemoveLane"
                              Tag="{Binding Index}" ToolTip.Tip="{x:Static res:Strings.InspRemoveThisAutomationTrack}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ContentControl Theme="{StaticResource FieldWide}" Margin="0,6,0,0">
              <Button Classes="block" Content="{x:Static res:Strings.InspAddAutomation}" IsEnabled="{Binding CanCarryLanes}">
                <Button.Flyout>
                  <MenuFlyout>
                    <!-- Only what this cue can carry. A volume lane over a visualizer and an opacity
                         lane over a WAV both compile to automation the engine has nowhere to apply. -->
                    <MenuItem Header="{Binding VolumeLaneLabel}" Click="OnAddLane" Tag="cue.audio.volume"
                              IsVisible="{Binding CanAddVolumeLane}" />
                    <MenuItem Header="{x:Static res:Strings.TlLaneGainInsert}" Click="OnAddLane"
                              Tag="audio.effect.parameter.gain.v1.gainDb"
                              IsVisible="{Binding HasAutomationAudioGain}"
                              IsEnabled="{Binding CanAddAudioGainLane}" />
                    <MenuItem Header="{Binding OpacityLaneLabel}" Click="OnAddLane" Tag="video.placement.opacity"
                              IsVisible="{Binding CanAddOpacityLane}" />
                    <MenuItem Header="{x:Static res:Strings.TlLanePositionX}" Click="OnAddLane" Tag="video.placement.x"
                              IsVisible="{Binding CanAddPlacementXLane}" />
                    <MenuItem Header="{x:Static res:Strings.TlLanePositionY}" Click="OnAddLane" Tag="video.placement.y"
                              IsVisible="{Binding CanAddPlacementYLane}" />
                    <MenuItem Header="{x:Static res:Strings.TlLaneWidth}" Click="OnAddLane" Tag="video.placement.width"
                              IsVisible="{Binding CanAddPlacementWidthLane}" />
                    <MenuItem Header="{x:Static res:Strings.TlLaneHeight}" Click="OnAddLane" Tag="video.placement.height"
                              IsVisible="{Binding CanAddPlacementHeightLane}" />
                    <MenuItem Header="{x:Static res:Strings.TlLaneRotation}" Click="OnAddLane" Tag="video.placement.rotation"
                              IsVisible="{Binding CanAddPlacementRotationLane}" />
                    <MenuItem Header="{x:Static res:Strings.TlLaneChromaKey}" IsVisible="{Binding HasAutomationChromaKey}">
                      <MenuItem Header="{x:Static res:Strings.TlLaneSimilarity}" Click="OnAddLane" Tag="video.effect.chroma-key.similarity"
                                IsVisible="{Binding CanAddChromaSimilarityLane}" />
                      <MenuItem Header="{x:Static res:Strings.TlLaneSmoothness}" Click="OnAddLane" Tag="video.effect.chroma-key.smoothness"
                                IsVisible="{Binding CanAddChromaSmoothnessLane}" />
                      <MenuItem Header="{x:Static res:Strings.TlLaneSpillReduction}" Click="OnAddLane" Tag="video.effect.chroma-key.spill-reduction"
                                IsVisible="{Binding CanAddChromaSpillLane}" />
                    </MenuItem>
                    <MenuItem Header="{x:Static res:Strings.TlLaneColourAdjust}" IsVisible="{Binding HasAutomationColorAdjust}">
                      <MenuItem Header="{x:Static res:Strings.TlLaneBrightness}" Click="OnAddLane" Tag="video.effect.color-adjust.brightness"
                                IsVisible="{Binding CanAddColorBrightnessLane}" />
                      <MenuItem Header="{x:Static res:Strings.TlLaneContrast}" Click="OnAddLane" Tag="video.effect.color-adjust.contrast"
                                IsVisible="{Binding CanAddColorContrastLane}" />
                    </MenuItem>
                    <Separator IsVisible="{Binding CanAddOutboundLane}" />
                    <MenuItem Header="{x:Static res:Strings.TlLaneOscValue}" Click="OnAddLane" Tag="external.osc.value"
                              IsVisible="{Binding CanAddOutboundLane}" />
                    <MenuItem Header="{x:Static res:Strings.TlLaneMidiControl}" Click="OnAddLane" Tag="external.midi.control-value"
                              IsVisible="{Binding CanAddOutboundLane}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </ContentControl>
            <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.InspTracksTargetConcreteCueProperties}" />
          </StackPanel>

          <!-- ══ NOTE - one tab on every kind; stays writable under Lock ════════════════════ -->
          <DockPanel IsVisible="{Binding IsNotePane}" Margin="10,8">
            <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160"
                     Text="{Binding NoteValue}"
                     LostFocus="OnFieldCommitted"
                     PlaceholderText="{x:Static res:Strings.InspNotesStayWritableUnderLock}"
                     VerticalContentAlignment="Top" />
          </DockPanel>

          <!-- ══ PREVIEW ═══════════════════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsPreviewPane}" Margin="0,8,0,8">
            <ContentControl Theme="{StaticResource FieldWide}">
              <Button Classes="primary block" Content="{x:Static res:Strings.InspPreviewOnAuditionOutputs}" Click="OnPreview" />
            </ContentControl>
            <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.InspPlaysIntoTheAuditionRig}" />
          </StackPanel>

          <!-- ══ GROUP - playlist crossfades (register item 17) ═════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsGroupPane}" Margin="0,6,0,8">
            <!-- All of this was hard-coded markup: fire mode was pinned to "playlist", so a timeline
                 group described itself as one. Bound to the cue now. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspFireMode}"
                                    IsEnabled="{Binding CanAuthor}">
              <ComboBox ItemsSource="{Binding FireModes}" SelectedIndex="{Binding FireModeIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspChildren}">
              <TextBox Classes="ro" IsReadOnly="True" Text="{Binding ChildCount}" />
            </HeaderedContentControl>

            <!-- A timeline group has authored offsets, so it opens the sheet instead of shuffling. -->
            <ContentControl Theme="{StaticResource FieldWide}" IsVisible="{Binding IsTimelineGroup}">
              <Button Classes="block" Content="{x:Static res:Strings.InspOpenTimeline}" Click="OnOpenTimeline" />
            </ContentControl>

            <StackPanel IsVisible="{Binding IsSequencedGroup}" IsEnabled="{Binding CanAuthor}">
              <CheckBox Margin="10,3" IsChecked="{Binding ShuffleValue}"
                        Content="{x:Static res:Strings.InspShuffle}" />
              <CheckBox Margin="10,3" IsChecked="{Binding ReshuffleValue}"
                        Content="{x:Static res:Strings.InspReshuffleEachPass}" />
              <!-- Only while shuffling: an in-order playlist repeats by construction, and a checkbox
                   that does nothing is worse than one that is not there. -->
              <CheckBox Margin="10,3" IsChecked="{Binding AvoidRepeatValue}"
                        IsVisible="{Binding ShuffleValue}"
                        Content="{x:Static res:Strings.InspNeverRepeatAcrossAPass}"
                        ToolTip.Tip="{x:Static res:Strings.InspWithoutThisAShuffledBed}" />

              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspPlayCount}">
                <NumericUpDown Minimum="0" Maximum="999" Increment="1" FormatString="0"
                               Value="{Binding LoopCountValue}"
                               ToolTip.Tip="{x:Static res:Strings.InspHowManyTimesThroughThe}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspItemsPerPass}">
                <NumericUpDown Minimum="1" Maximum="999" Increment="1" FormatString="0"
                               Value="{Binding PlayCountValue}"
                               ToolTip.Tip="{x:Static res:Strings.InspLeaveBlankToPlayEvery}" />
              </HeaderedContentControl>

              <StackPanel IsVisible="{Binding IsPlaylistGroup}">
                <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.InspCrossfadeBetweenItems}" />
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspDefault}">
                  <TextBox Classes="short" Text="{Binding CrossfadeValue}" LostFocus="OnFieldCommitted" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspCurve}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding CurveChoices}"
                              SelectedIndex="{Binding CrossfadeCurveIndex, Mode=TwoWay}"
                              ItemTemplate="{StaticResource CurveItemTemplate}"
                              SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
                    <Button Grid.Column="1" Classes="icon" Content="✎" Click="OnEditCurve"
                            Tag="crossfade" ToolTip.Tip="{x:Static res:Strings.InspEditExactPointsAndShaped}" />
                  </Grid>
                </HeaderedContentControl>

                <!-- BOTH halves of the join. The picker above shows one line, which is the departure;
                     what an operator is actually judging is whether the two together hold the level
                     across the seam or leave a hole in it. Sampled from the session's own fade math,
                     so this is the crossfade rather than a drawing of one. -->
                <ContentControl Theme="{StaticResource FieldWide}">
                  <Border Classes="vidcanvas" Height="76"
                          AutomationProperties.Name="Crossfade shape">
                    <Panel Margin="6">
                      <c:CanvasGrid Columns="8" Rows="4" />
                      <c:EnvelopeGraph Points="{Binding CrossfadeOutShape}"
                                       Stroke="{DynamicResource GelCongo}" StrokeThickness="1.4" />
                      <c:EnvelopeGraph Points="{Binding CrossfadeInShape}"
                                       Stroke="{DynamicResource GelAmber}" StrokeThickness="1.4" />
                    </Panel>
                  </Border>
                </ContentControl>
                <ContentControl Theme="{StaticResource FieldWide}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Rectangle Width="18" Height="2" VerticalAlignment="Center"
                               Fill="{DynamicResource GelCongo}" />
                    <TextBlock Classes="mono dim2 small" VerticalAlignment="Center"
                               Text="{x:Static res:Strings.InspItemGoingOut}" />
                    <Rectangle Width="18" Height="2" VerticalAlignment="Center"
                               Fill="{DynamicResource GelAmber}" />
                    <TextBlock Classes="mono dim2 small" VerticalAlignment="Center"
                               Text="{x:Static res:Strings.InspItemComingIn}" />
                  </StackPanel>
                </ContentControl>
              </StackPanel>
            </StackPanel>

            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspAtEnd}"
                                    IsEnabled="{Binding CanAuthor}"
                                    IsVisible="{Binding IsSequencedGroup}">
              <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding AtEndOptions}"
                       SelectedIndex="{Binding AtEndIndex}" />
            </HeaderedContentControl>
            <TextBlock Margin="10,6" Classes="mono dim3 small"
                       Text="{x:Static res:Strings.InspPerItemFadeInOverrides}" />
          </StackPanel>

          <!-- ══ PATCH - snapshot recall AND inline level changes (register item 12) ════════ -->
          <StackPanel IsVisible="{Binding IsPatchPane}" IsEnabled="{Binding CanAuthor}"
                      Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudRecall2}">
              <ComboBox ItemsSource="{Binding PatchSnapshots}"
                        SelectedIndex="{Binding PatchSnapshotIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.CuesFade}">
              <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding PatchFadeValue}" LostFocus="OnFieldCommitted" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CurveChoices}"
                          SelectedIndex="{Binding PatchCurveIndex, Mode=TwoWay}"
                          ItemTemplate="{StaticResource CurveItemTemplate}"
                          SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
                <Button Grid.Column="2" Classes="icon" Content="✎" Click="OnEditCurve" Tag="patch"
                        ToolTip.Tip="{x:Static res:Strings.InspEditExactPointsAndShaped}" />
              </Grid>
            </HeaderedContentControl>

            <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.InspAlsoChange}" />
            <!-- The cue's OWN level changes. This pane used to show two fixed rows whatever the cue
                 carried, so one with three changes showed two and one with none still showed two. -->
            <TextBlock Margin="10,2" Classes="mono dim3 small" IsVisible="{Binding !HasPatchLevelChanges}"
                       Text="{x:Static res:Strings.InspNoInlineLevelChanges}" />
            <ItemsControl ItemsSource="{Binding PatchLevelChanges}" Margin="10,2">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Classes="mono dim2 small" Margin="0,2" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ContentControl Theme="{StaticResource FieldWide}">
              <Button Classes="quiet" Content="{x:Static res:Strings.InspAddLevelChange}" Click="OnAddLevelChange" />
            </ContentControl>

            <!-- A patch cue changes the console and leaves it changed: stopping it undoes nothing. -->
            <Border Classes="chain">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge"><TextBlock Text="{x:Static res:Strings.InspPersistent}" /></Border>
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{x:Static res:Strings.InspAppliesToThePatchAnd}" />
              </DockPanel>
            </Border>
            <TextBlock Margin="10,6" Classes="mono warn small" TextWrapping="Wrap"
                       IsVisible="{Binding PatchHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding PatchHint}" />
          </StackPanel>

          <!-- ══ FADE - targets, duration, curve, fade-everything ══════════════════════════ -->
          <StackPanel IsVisible="{Binding IsFadePane}" IsEnabled="{Binding CanAuthor}"
                      Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspToLevel}">
              <TextBox Classes="short" Text="{Binding FadeToLevelValue}" LostFocus="OnFieldCommitted"
                       ToolTip.Tip="{x:Static res:Strings.InspALevelInDbOr}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspDuration}">
              <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding FadeDurationValue}" LostFocus="OnFieldCommitted" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CurveChoices}"
                          SelectedIndex="{Binding FadeCurveIndex, Mode=TwoWay}"
                          ItemTemplate="{StaticResource CurveItemTemplate}"
                          SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
                <Button Grid.Column="2" Classes="icon" Content="✎" Click="OnEditCurve" Tag="fade" />
              </Grid>
            </HeaderedContentControl>
            <CheckBox Margin="10,4" IsChecked="{Binding FadeEverythingValue}"
                      Content="{x:Static res:Strings.InspFadeEverythingCurrentlySounding}" />
            <CheckBox Margin="10,4" IsChecked="{Binding FadeStopsTargetsValue}"
                      Content="{x:Static res:Strings.InspStopTheTargetsWhenThe}" />

            <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.AudLogicalOutputs}" />
            <ItemsControl ItemsSource="{Binding FadeTargets}" Margin="10,2">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TargetToggle">
                  <CheckBox Margin="0,1" IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                       Text="{Binding FadeTargetHint}" />
          </StackPanel>

          <!-- ══ JUMP - targets, random pick, fire-on-jump ═════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsJumpPane}" IsEnabled="{Binding CanAuthor}"
                      Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspJumpTo}">
              <ComboBox ItemsSource="{Binding JumpTargets}" SelectedIndex="{Binding JumpTargetIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspCondition}">
              <ComboBox ItemsSource="{Binding JumpConditions}"
                        SelectedIndex="{Binding JumpConditionIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspJumpVisits}"
                                    IsVisible="{Binding IsCountedJump}">
              <TextBox Classes="short" Text="{Binding JumpCountValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <CheckBox Margin="10,4" IsChecked="{Binding JumpPickAtRandomValue}"
                      Content="{x:Static res:Strings.InspPickAtRandomFromA}" />
            <CheckBox Margin="10,4" IsChecked="{Binding JumpFiresOnArrivalValue}"
                      Content="{x:Static res:Strings.InspFireTheTargetCueOn}" />
            <!-- A jump that lands somewhere no longer in the show is one of the checks Project status
                 runs; the editor says so rather than letting it become a get-in surprise. -->
            <TextBlock Margin="10,6" Classes="mono warn small" TextWrapping="Wrap"
                       IsVisible="{Binding JumpHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding JumpHint}" />
          </StackPanel>

          <!-- ══ TEXT - words on a canvas ══════════════════════════════════════════════════
               The document stores WORDS, not a picture: portable, diffable, and translatable. The
               app draws them into its media cache when the show is compiled, so a card carried to
               another booth is redrawn there with whatever faces that machine has. -->
          <StackPanel IsVisible="{Binding IsTextPane}" IsEnabled="{Binding CanAuthor}"
                      Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspWords}">
              <TextBox Text="{Binding CardText}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="90" VerticalContentAlignment="Top"
                       PlaceholderText="{x:Static res:Strings.InspTheWordsOnTheCard}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspFace}">
              <TextBox Text="{Binding CardFont}"
                       PlaceholderText="{x:Static res:Strings.InspTheAppSOwnMatched}"
                       ToolTip.Tip="{x:Static res:Strings.InspAHintABoothMachine}" />
            </HeaderedContentControl>
            <!-- A FRACTION of the frame, not points: a card authored at 72 pt on a 1280×720 canvas
                 is unreadable on a 4 K one. -->
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudnSize}">
              <NumericUpDown Minimum="0.01" Maximum="1" Increment="0.01" FormatString="0.###"
                             Value="{Binding CardSize}"
                             ToolTip.Tip="{x:Static res:Strings.InspCapHeightAsAFraction}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.InspWeight}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <CheckBox Grid.Column="0" IsChecked="{Binding CardBold}" Content="{x:Static res:Strings.InspBold}" />
                <CheckBox Grid.Column="1" IsChecked="{Binding CardItalic}" Content="{x:Static res:Strings.InspItalic}" />
              </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.InspInkGround}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding CardInk}" PlaceholderText="{x:Static res:Strings.InspFfffff}" />
                <TextBox Grid.Column="1" Text="{Binding CardGround}" PlaceholderText="{x:Static res:Strings.InspTransparent}" />
              </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspAlign}">
              <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding CardAligns}"
                       SelectedIndex="{Binding CardAlignIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspAnchor}">
              <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding CardAnchors}"
                       SelectedIndex="{Binding CardAnchorIndex}" />
            </HeaderedContentControl>
            <!-- An outline is what makes a caption readable over picture. Without one the usual fix
                 is a background band, which covers the shot the caption is describing. -->
            <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.InspOutlineColour}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <NumericUpDown Grid.Column="0" Minimum="0" Maximum="0.1" Increment="0.002"
                               FormatString="0.###" Value="{Binding CardOutline}" />
                <TextBox Grid.Column="1" Text="{Binding CardOutlineInk}" PlaceholderText="#000000" />
              </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspHold}">
              <NumericUpDown Minimum="0" Maximum="3600000" Increment="500" FormatString="0"
                             Value="{Binding CardDuration}"
                             ToolTip.Tip="{x:Static res:Strings.InspMilliseconds0HoldsTheCard}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.InspFadeInOut}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <NumericUpDown Grid.Column="0" Minimum="0" Maximum="60000" Increment="100"
                               FormatString="0" Value="{Binding CardFadeIn}" />
                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="60000" Increment="100"
                               FormatString="0" Value="{Binding CardFadeOut}" />
              </Grid>
            </HeaderedContentControl>
            <ContentControl Theme="{StaticResource FieldWide}">
              <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding CardHint}" />
            </ContentControl>
          </StackPanel>

          <!-- ══ VISUALIZER - the ONLY home of visualizer settings (register item 21) ═══════ -->
          <StackPanel IsVisible="{Binding IsVisualizerPane}" IsEnabled="{Binding CanAuthor}"
                      Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspPresetPack}">
              <TextBox Text="{Binding VisualizerPresetPackValue}" LostFocus="OnFieldCommitted"
                       PlaceholderText="{x:Static res:Strings.InspAPresetDirectoryUnderThe}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspHoldEach}">
              <TextBox Classes="short" Text="{Binding VisualizerHoldValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspBlend}">
              <TextBox Classes="short" Text="{Binding VisualizerBlendValue}" LostFocus="OnFieldCommitted" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspAudioFeed}">
              <StackPanel>
                <CheckBox IsChecked="{Binding VisualizerFeedAllValue}"
                          Content="{x:Static res:Strings.InspAllSoundingMedia}" />
                <TextBox IsVisible="{Binding !VisualizerFeedAllValue}"
                         Text="{Binding VisualizerFeedCueNumbers}" LostFocus="OnFieldCommitted"
                         PlaceholderText="{x:Static res:Strings.InspCueNumbersEG12}" />
                <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap"
                           Text="{Binding VisualizerFeedHint}" />
              </StackPanel>
            </HeaderedContentControl>
            <CheckBox Margin="10,4" IsChecked="{Binding VisualizerLocksPresetValue}"
                      Content="{x:Static res:Strings.InspLockToThisPresetNo}" />
            <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.InspPlacementLivesOnTheVideo}" />
            <TextBlock Margin="10,2,10,6" Classes="mono warn small" TextWrapping="Wrap"
                       Text="{Binding VisualizerHint}" />
          </StackPanel>

          <!-- ══ ACTION - endpoint, address, arguments ═════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsActionPane}" IsEnabled="{Binding CanAuthor}"
                      Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspEndpoint}">
              <ComboBox ItemsSource="{Binding ActionEndpoints}"
                        SelectedIndex="{Binding ActionEndpointIndex}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspAddress}">
              <TextBox Text="{Binding ActionAddressValue}" LostFocus="OnFieldCommitted"
                       PlaceholderText="{x:Static res:Strings.InspEosCue2Fire}" />
            </HeaderedContentControl>
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspArguments}">
              <TextBox Text="{Binding ActionArgumentsValue}" LostFocus="OnFieldCommitted"
                       PlaceholderText="{x:Static res:Strings.InspWhitespaceSeparated}" />
            </HeaderedContentControl>
            <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                       Text="{Binding ActionHint}" />
          </StackPanel>

        </Panel>
      </ScrollViewer>
    </DockPanel>
  </Panel>
</UserControl>
