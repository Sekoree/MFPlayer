<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:HaCue2.Views"
        xmlns:vm="using:HaCue2.ViewModels"
        x:Class="HaCue2.Views.TimelineWindow"
        x:DataType="vm:TimelineViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        Width="1100" Height="420"
        Background="{DynamicResource BoothBg}"
        Foreground="{DynamicResource BoothInk}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- The sheet, undocked. The SAME view-model as the docked one, so an edit in either is already in
       the other — there is one timeline and two ways to look at it (register item 18). -->

  <v:TimelineSheet />
</Window>
