<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:HaCue2.Resources"
             xmlns:c="using:HaCue2.Controls"
             xmlns:vm="using:HaCue2.ViewModels"
             x:Class="HaCue2.Views.AuditionPane"
             x:DataType="vm:AuditionViewModel"
             x:CompileBindings="True">

  <!-- Screen 08b, shown identically in the Audio and Video views. Audition enters the bay as a
       MONITOR input: it never touches the patch or the program bus, which is what makes previewing
       a cue mid-show safe and why "solo this line to audition" is always allowed. -->

  <Grid ColumnDefinitions="*,*" Margin="7" ColumnSpacing="7">

    <c:PanelBox Grid.Column="0" Header="{x:Static res:Strings.AudnAuditionAudio}" VerticalAlignment="Top">
      <StackPanel Margin="0,6,0,8">
        <!-- Lines, not raw devices (D8): the rig is an output like any other, so it takes that
             line's own channel count and travels with the show. -->
        <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudLine}">
          <ComboBox ItemsSource="{Binding Devices}" SelectedIndex="{Binding DeviceIndex}" />
        </HeaderedContentControl>
        <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.TlLaneWidth}">
          <TextBox Classes="ro" Text="{Binding Width}" />
        </HeaderedContentControl>
        <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudnLevel}">
          <TextBox Classes="short" Text="{Binding Level}" LostFocus="OnFieldCommitted" />
        </HeaderedContentControl>
        <CheckBox Margin="10,4" IsChecked="{Binding DuckWhenProgramSounds}"
                  Content="{x:Static res:Strings.AudnDuckAuditionWhenProgramIs}" />
        <TextBlock Margin="10,4,10,4" FontSize="10.5" Classes="dim3" TextWrapping="Wrap"
                   Text="{x:Static res:Strings.AudnAuditionEntersTheBayAs}" />
      </StackPanel>
    </c:PanelBox>

    <c:PanelBox Grid.Column="1" Header="{x:Static res:Strings.AudnAuditionVideo}" VerticalAlignment="Top">
      <c:PanelBox.Footer>
        <Border Classes="chain">
          <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge"><TextBlock Text="{x:Static res:Strings.AudnCueMenu}" /></Border>
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.AudnRightClickAnyCuePreview}" />
              </DockPanel>
        </Border>
      </c:PanelBox.Footer>

      <StackPanel Margin="0,6,0,8">
        <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudnSurface}">
          <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding Surfaces}"
                   SelectedIndex="{Binding SurfaceIndex}" />
        </HeaderedContentControl>
        <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudnSize}">
          <TextBox Classes="ro" Text="{Binding Size}" />
        </HeaderedContentControl>
        <!-- The audition canvas is COMPOSED, not a raw decode: it accepts the extra GL thread so a
             preview shows placement, fit and mapping exactly as they will appear on the wall. -->
        <TextBlock Margin="10,4" FontSize="10.5" Classes="dim3" TextWrapping="Wrap"
                   Text="{x:Static res:Strings.AudnThePreviewRendersThroughIts}" />
      </StackPanel>
    </c:PanelBox>
  </Grid>
</UserControl>
