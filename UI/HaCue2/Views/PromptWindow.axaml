<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:HaCue2.Controls"
        xmlns:vm="using:HaCue2.ViewModels"
        x:Class="HaCue2.Views.PromptWindow"
        x:DataType="vm:PromptViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BoothBg}"
        Foreground="{DynamicResource BoothInk}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- The one modal shape in the app. Every "…" button that just needs a couple of values and a verb
       opens this; anything with a real editing surface of its own (the curve editor, the subtitle
       picker) gets its own window instead. -->

  <c:PanelBox Header="{Binding Title}" Hint="{Binding Hint}" Margin="7">
    <DockPanel>

      <Border DockPanel.Dock="Bottom" Classes="chain">
        <DockPanel LastChildFill="False">
          <Button DockPanel.Dock="Right" Classes="primary" Content="{Binding Confirm}" Click="OnConfirm" />
          <!-- The third answer, between confirm and cancel: closing with unsaved edits is save /
               discard / go back, and two buttons make one of those three unreachable. -->
          <Button DockPanel.Dock="Right" Classes="tight" Margin="0,0,6,0"
                  IsVisible="{Binding HasAlternative}"
                  Content="{Binding Alternative}" Click="OnAlternative" />
          <Button DockPanel.Dock="Right" Classes="tight" Margin="0,0,6,0"
                  Content="CANCEL" Click="OnCancel" />
        </DockPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Fields}" Margin="0,6,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PromptField">
            <StackPanel>
              <!-- Disabled rather than hidden when another field makes this one meaningless: a dialog
                   that changes shape as you fill it in is harder to read than one that greys a line. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{Binding Label}"
                                      IsEnabled="{Binding IsEnabled}">
                <Panel>
                  <TextBox IsVisible="{Binding IsText}" Text="{Binding Value}" />
                  <ComboBox IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" />
                  <CheckBox IsVisible="{Binding IsToggle}" IsChecked="{Binding IsOn}" />
                  <!-- Nearly always one of a handful, occasionally none of them: the presets are a
                       shortcut and never a fence. -->
                  <Grid IsVisible="{Binding IsSuggestion}" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBox Grid.Column="0" Text="{Binding Value}" />
                    <Button Grid.Column="1" Classes="icon" Content="▾"
                            ToolTip.Tip="Common values. Anything can still be typed.">
                      <Button.Flyout>
                        <Flyout>
                          <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <!-- The field itself, carried on the Tag: the item's own data context
                                     is the suggestion string, and the flyout is not in the field's
                                     visual tree to walk up from. -->
                                <Button Classes="tight block" HorizontalAlignment="Stretch"
                                        Click="OnPickSuggestion" Content="{Binding}"
                                        Tag="{Binding $parent[ItemsControl].DataContext}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <!-- Still typable beside the button: pasting a path is faster than clicking to it,
                       and one that does not exist yet cannot be picked at all. -->
                  <Grid IsVisible="{Binding IsPath}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0" Text="{Binding Value}" />
                    <Button Grid.Column="1" Classes="tight" Content="BROWSE…" Click="OnBrowse"
                            Tag="{Binding}" />
                  </Grid>
                </Panel>
              </HeaderedContentControl>
              <TextBlock Classes="mono dim3 micro" Margin="115,0,10,4" TextWrapping="Wrap"
                         IsVisible="{Binding HasHint}" Text="{Binding Hint}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>
  </c:PanelBox>
</Window>
