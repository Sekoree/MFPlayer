<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:HaCue2.Resources"
             xmlns:c="using:HaCue2.Controls"
             xmlns:vm="using:HaCue2.ViewModels"
             x:Class="HaCue2.Views.PlacementEditorPane"
             x:DataType="vm:InspectorViewModel"
             x:CompileBindings="True"
             AutomationProperties.Name="Video placement editor">

  <!-- One placement's complete editor. InspectorPane places this inside each placement expander;
       all instances bind to the inspector's selected placement, and only the open one is realised. -->
  <StackPanel Margin="0,4,0,2">
    <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.PlaceComposition}">
      <ComboBox ItemsSource="{Binding Video.PlacementCompositions}"
                SelectedIndex="{Binding Video.PlacementCompositionIndex}" />
    </HeaderedContentControl>
    <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.PlaceLayer}">
      <TextBox Classes="short" Text="{Binding Video.LayerValue}" LostFocus="OnFieldCommitted" />
    </HeaderedContentControl>
    <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.PlaceFit}">
      <ComboBox ItemsSource="{Binding Video.FitModes}" SelectedIndex="{Binding Video.FitIndex}" />
    </HeaderedContentControl>
    <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.TlLaneOpacity}">
      <NumericUpDown Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##"
                     Value="{Binding Video.PlacementOpacity}" />
    </HeaderedContentControl>

    <!-- The destination rectangle as NUMBERS. A drag cannot hit exactly half, and half is what a
         split screen is made of. -->
    <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.PlaceDestXY}">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
        <NumericUpDown Grid.Column="0" Minimum="-1" Maximum="2" Increment="0.01"
                       FormatString="0.###" Value="{Binding Video.PlacementX}" />
        <NumericUpDown Grid.Column="1" Minimum="-1" Maximum="2" Increment="0.01"
                       FormatString="0.###" Value="{Binding Video.PlacementY}" />
      </Grid>
    </HeaderedContentControl>
    <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.PlaceDestWH}">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
        <NumericUpDown Grid.Column="0" Minimum="0.001" Maximum="2" Increment="0.01"
                       FormatString="0.###" Value="{Binding Video.PlacementWidth}" />
        <NumericUpDown Grid.Column="1" Minimum="0.001" Maximum="2" Increment="0.01"
                       FormatString="0.###" Value="{Binding Video.PlacementHeight}" />
      </Grid>
    </HeaderedContentControl>
    <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.TlLaneRotation}">
      <NumericUpDown Minimum="-360" Maximum="360" Increment="1" FormatString="0.##"
                     Value="{Binding Video.PlacementRotation}"
                     ToolTip.Tip="{x:Static res:Strings.PlaceClockwiseAboutTheRectangleS}" />
    </HeaderedContentControl>

    <ContentControl Theme="{StaticResource FieldWide}">
      <WrapPanel ItemSpacing="4" LineSpacing="4">
        <Button Classes="tight" Content="{x:Static res:Strings.PlaceFull}" Click="OnLayout" Tag="full" AutomationProperties.Name="Place full frame" />
        <Button Classes="tight" Content="◧" Click="OnLayout" Tag="left" ToolTip.Tip="{x:Static res:Strings.PlaceLeftHalf}" AutomationProperties.Name="Place in left half" />
        <Button Classes="tight" Content="◨" Click="OnLayout" Tag="right" ToolTip.Tip="{x:Static res:Strings.PlaceRightHalf}" AutomationProperties.Name="Place in right half" />
        <Button Classes="tight" Content="⬒" Click="OnLayout" Tag="top" ToolTip.Tip="{x:Static res:Strings.PlaceTopHalf}" AutomationProperties.Name="Place in top half" />
        <Button Classes="tight" Content="⬓" Click="OnLayout" Tag="bottom" ToolTip.Tip="{x:Static res:Strings.PlaceBottomHalf}" AutomationProperties.Name="Place in bottom half" />
        <Button Classes="tight" Content="◰" Click="OnLayout" Tag="tl" ToolTip.Tip="{x:Static res:Strings.PlaceTopLeft}" AutomationProperties.Name="Place in top left" />
        <Button Classes="tight" Content="◳" Click="OnLayout" Tag="tr" ToolTip.Tip="{x:Static res:Strings.PlaceTopRight}" AutomationProperties.Name="Place in top right" />
        <Button Classes="tight" Content="◱" Click="OnLayout" Tag="bl" ToolTip.Tip="{x:Static res:Strings.PlaceBottomLeft}" AutomationProperties.Name="Place in bottom left" />
        <Button Classes="tight" Content="◲" Click="OnLayout" Tag="br" ToolTip.Tip="{x:Static res:Strings.PlaceBottomRight}" AutomationProperties.Name="Place in bottom right" />
      </WrapPanel>
    </ContentControl>

    <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.PlaceResize}">
      <WrapPanel ItemSpacing="12" LineSpacing="4">
        <CheckBox Content="{x:Static res:Strings.PlacePreserveAspect}" IsChecked="{Binding Video.PreservePlacementAspect}" />
        <CheckBox Content="{x:Static res:Strings.PlaceSnapGuides}" IsChecked="{Binding Video.SnapPlacement}" />
      </WrapPanel>
    </HeaderedContentControl>

    <!-- Source crop is which part of the picture to use, not where to put it. -->
    <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.PlaceSourceCrop}" />
    <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.PlaceLeftTop}">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
        <NumericUpDown Grid.Column="0" Minimum="0" Maximum="0.49" Increment="0.01"
                       FormatString="0.###" Value="{Binding Video.CropLeft}" />
        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="0.49" Increment="0.01"
                       FormatString="0.###" Value="{Binding Video.CropTop}" />
      </Grid>
    </HeaderedContentControl>
    <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.PlaceRightBottom}">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
        <NumericUpDown Grid.Column="0" Minimum="0" Maximum="0.49" Increment="0.01"
                       FormatString="0.###" Value="{Binding Video.CropRight}" />
        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="0.49" Increment="0.01"
                       FormatString="0.###" Value="{Binding Video.CropBottom}" />
      </Grid>
    </HeaderedContentControl>
    <ContentControl Theme="{StaticResource FieldWide}">
      <WrapPanel ItemSpacing="4" LineSpacing="4">
        <Button Classes="tight" Content="{x:Static res:Strings.PlaceNoCrop}" Click="OnCrop" Tag="none" />
        <Button Classes="tight" Content="{x:Static res:Strings.PlaceCentreWide}" Click="OnCrop" Tag="wide" />
        <Button Classes="tight" Content="{x:Static res:Strings.PlaceCentreTall}" Click="OnCrop" Tag="tall" />
        <Button Classes="tight" Content="{x:Static res:Strings.PlaceCentreBox}" Click="OnCrop" Tag="centre" />
      </WrapPanel>
    </ContentControl>

    <!-- Ordered rack: identity and order live here; focused built-in editors follow below. -->
    <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.PlaceEffectRack}" />
    <ItemsControl ItemsSource="{Binding Video.EffectRackRows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:LayerEffectRackRow">
          <Grid Margin="10,2" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
            <TextBlock Grid.Column="0" Classes="mono dim3" VerticalAlignment="Center"
                       Text="{Binding Number, StringFormat='#{0}'}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" />
              <TextBlock Classes="small dim3" Text="{Binding Enabled, StringFormat='enabled: {0}'}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="tight" Content="{x:Static res:Strings.PlaceOnOff}" Tag="{Binding Id}"
                    Click="OnToggleEffect" />
            <Button Grid.Column="3" Classes="tight" Content="↑" AutomationProperties.Name="Move effect earlier" Tag="{Binding Id}"
                    IsEnabled="{Binding CanMoveUp}" Click="OnMoveEffectUp" />
            <Button Grid.Column="4" Classes="tight" Content="↓" AutomationProperties.Name="Move effect later" Tag="{Binding Id}"
                    IsEnabled="{Binding CanMoveDown}" Click="OnMoveEffectDown" />
            <Button Grid.Column="5" Classes="tight" Content="×" AutomationProperties.Name="Remove effect" Tag="{Binding Id}"
                    Click="OnRemoveEffect" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Classes="block" Content="{x:Static res:Strings.PlaceAddEffect}">
      <Button.Flyout>
        <MenuFlyout>
          <MenuItem Header="{x:Static res:Strings.TlLaneChromaKey}" Tag="chroma-key.v1" Click="OnAddEffect" />
          <MenuItem Header="{x:Static res:Strings.PlaceBrightnessContrast}" Tag="brightness-contrast.v1" Click="OnAddEffect" />
        </MenuFlyout>
      </Button.Flyout>
    </Button>

    <!-- OFF IS NOT DELETE: effect settings survive their toggles. -->
    <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.TlLaneChromaKey}" />
    <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.PlaceKey}">
      <CheckBox IsChecked="{Binding Video.ChromaKeyOn}" Content="{x:Static res:Strings.PlaceKeyThisLayer}" />
    </HeaderedContentControl>
    <StackPanel IsVisible="{Binding Video.HasChromaKey}">
      <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspColour}">
        <TextBox Text="{Binding Video.ChromaColour}" PlaceholderText="{x:Static res:Strings.PlaceN00ff00}" />
      </HeaderedContentControl>
      <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.PlaceSimilarSoft}">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
          <NumericUpDown Grid.Column="0" Minimum="0" Maximum="1" Increment="0.02"
                         FormatString="0.##" Value="{Binding Video.ChromaSimilarity}" />
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="1" Increment="0.02"
                         FormatString="0.##" Value="{Binding Video.ChromaSmoothness}" />
        </Grid>
      </HeaderedContentControl>
      <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.PlaceSpill}">
        <NumericUpDown Minimum="0" Maximum="1" Increment="0.02" FormatString="0.##"
                       Value="{Binding Video.ChromaSpill}"
                       ToolTip.Tip="{x:Static res:Strings.PlaceHowMuchOfTheKey}" />
      </HeaderedContentControl>
      <Button Classes="block" Content="{x:Static res:Strings.PlaceAutomateChroma}">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="{x:Static res:Strings.TlLaneSimilarity}" Click="OnAddAutomation" Tag="video.effect.chroma-key.similarity"
                      IsEnabled="{Binding Video.CanAddChromaSimilarityLane}" />
            <MenuItem Header="{x:Static res:Strings.TlLaneSmoothness}" Click="OnAddAutomation" Tag="video.effect.chroma-key.smoothness"
                      IsEnabled="{Binding Video.CanAddChromaSmoothnessLane}" />
            <MenuItem Header="{x:Static res:Strings.TlLaneSpillReduction}" Click="OnAddAutomation" Tag="video.effect.chroma-key.spill-reduction"
                      IsEnabled="{Binding Video.CanAddChromaSpillLane}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </StackPanel>

    <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.InspColour}" />
    <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.PlaceAdjust}">
      <CheckBox IsChecked="{Binding Video.ColorAdjustOn}" Content="{x:Static res:Strings.PlaceBrightnessAndContrast}" />
    </HeaderedContentControl>
    <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.PlaceBrightContrast}"
                            IsVisible="{Binding Video.ColorAdjustOn}">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
        <NumericUpDown Grid.Column="0" Minimum="-1" Maximum="1" Increment="0.05"
                       FormatString="0.##" Value="{Binding Video.LayerBrightness}" />
        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="4" Increment="0.05"
                       FormatString="0.##" Value="{Binding Video.LayerContrast}" />
      </Grid>
    </HeaderedContentControl>
    <Button Classes="block" Content="{x:Static res:Strings.PlaceAutomateColour}" IsVisible="{Binding Video.HasColorAdjust}">
      <Button.Flyout>
        <MenuFlyout>
          <MenuItem Header="{x:Static res:Strings.TlLaneBrightness}" Click="OnAddAutomation" Tag="video.effect.color-adjust.brightness"
                    IsEnabled="{Binding Video.CanAddColorBrightnessLane}" />
          <MenuItem Header="{x:Static res:Strings.TlLaneContrast}" Click="OnAddAutomation" Tag="video.effect.color-adjust.contrast"
                    IsEnabled="{Binding Video.CanAddColorContrastLane}" />
        </MenuFlyout>
      </Button.Flyout>
    </Button>

    <!-- The guides are seams between the screens dividing this placement's canvas. -->
    <c:AspectBox Margin="10,6" VerticalAlignment="Top" Ratio="{Binding Video.PlacementAspect}">
      <c:PlacementCanvas Boxes="{Binding Video.Placements}"
                         AutomationProperties.Name="Video placement canvas"
                         AutomationProperties.HelpText="{x:Static res:Strings.PlaceDragOrResizeThisPlacement}"
                         GuidesX="{Binding Video.PlacementGuidesX}"
                         GuidesY="{Binding Video.PlacementGuidesY}"
                         PreserveAspect="{Binding Video.PreservePlacementAspect}"
                         SnapEnabled="{Binding Video.SnapPlacement}"
                         AllowOutside="True"
                         Gesture="OnPlacementGesture"
                         GestureCompleted="OnPlacementGestureCompleted" />
    </c:AspectBox>

    <Border Classes="chain">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Classes="tight" Content="{x:Static res:Strings.CuesRemove}" Click="OnRemovePlacement" />
        <Button DockPanel.Dock="Right" Margin="0,0,5,0" Classes="tight" Content="{x:Static res:Strings.PlacePopOut}"
                Click="OnPopOut" ToolTip.Tip="{x:Static res:Strings.PlaceOpenALargePlacementCanvas}" />
        <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge">
          <TextBlock Text="{x:Static res:Strings.PlacePlacement}" />
        </Border>
        <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                   Text="{x:Static res:Strings.PlaceDragHereForRoughPop}" />
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
