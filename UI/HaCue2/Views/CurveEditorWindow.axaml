<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:HaCue2.Controls"
        xmlns:vm="using:HaCue2.ViewModels"
        x:Class="HaCue2.Views.CurveEditorWindow"
        x:DataType="vm:CurveEditorViewModel"
        Title="Fade curve"
        Width="700" Height="340"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BoothBg}"
        Foreground="{DynamicResource BoothInk}"
        FontSize="{DynamicResource FontSizeBase}">

  <c:PanelBox Header="{Binding Title}" Hint="{Binding Hint}" Margin="7">
    <DockPanel>

      <!-- The picker and the editor are the same strip: choosing "custom" is just selecting the last
           thumbnail, so there is never a mode the operator has to find. -->
      <ListBox DockPanel.Dock="Top" Theme="{StaticResource CurveOptions}" Classes="curves"
               Margin="10,4" SelectedIndex="4"
               ItemsSource="{Binding Curves}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CurveOption">
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <Path Data="{Binding Shape}" StrokeThickness="1.4" Width="44" Height="26"
                    Stretch="Uniform" />
              <TextBlock Classes="mono" FontSize="{DynamicResource FontSizeNano}"
                         HorizontalAlignment="Center" LetterSpacing="0.4" Text="{Binding Name}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid ColumnDefinitions="*,220" ColumnSpacing="7" Margin="10,2,10,10">

        <c:CurveCanvas Grid.Column="0"
                       Points="{Binding Points}"
                       Shape="{Binding Shape}"
                       Gesture="OnCurveGesture"
                       GestureCompleted="OnCurveGestureCompleted"
                       HoldToggled="OnHoldToggled" />

        <StackPanel Grid.Column="1" Spacing="4">
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Point">
            <TextBox Classes="ro" IsReadOnly="True" Text="{Binding SelectedPoint}" />
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Scale">
            <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding Scales}"
                     SelectedItem="{Binding Scale}" />
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Segment"
                                  IsEnabled="{Binding HasSelection}"
                                  IsVisible="{Binding SupportsHold}">
            <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding Segments}"
                     SelectedItem="{Binding Segment}" />
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Save as">
            <TextBox Text="{Binding PresetName}" />
          </HeaderedContentControl>
          <TextBlock Margin="10,4" Classes="mono dim3 micro" TextWrapping="Wrap"
                     Text="{Binding EditHint}" />
          <ContentControl Theme="{StaticResource FieldWide}">
            <Button Classes="primary block" Content="DONE" Click="OnDone" />
          </ContentControl>
        </StackPanel>
      </Grid>
    </DockPanel>
  </c:PanelBox>
</Window>
