<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:HaCue2.Resources"
        xmlns:c="using:HaCue2.Controls"
        xmlns:vm="using:HaCue2.ViewModels"
        x:Class="HaCue2.Views.CurveEditorWindow"
        x:DataType="vm:CurveEditorViewModel"
        x:CompileBindings="True"
        Title="{x:Static res:Strings.CurveEdFadeCurve}"
        Width="820" Height="570"
        MinWidth="620" MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BoothBg}"
        Foreground="{DynamicResource BoothInk}"
        FontSize="{DynamicResource FontSizeBase}">

  <c:PanelBox Header="{Binding Title}" Hint="{Binding Hint}" Margin="7">
    <DockPanel>

      <!-- The picker and the editor are the same strip: choosing "custom" is just selecting the last
           thumbnail, so there is never a mode the operator has to find. -->
      <ListBox DockPanel.Dock="Top" Theme="{StaticResource CurveOptions}" Classes="curves"
               Margin="10,4" SelectedIndex="{Binding SelectedCurve, Mode=TwoWay}"
               IsEnabled="{Binding CanPickLaw}"
               ItemsSource="{Binding Curves}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CurveOption">
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <Path Data="{Binding Shape}" StrokeThickness="1.4" Width="44" Height="26"
                    Stretch="Uniform" />
              <TextBlock Classes="mono" FontSize="{DynamicResource FontSizeNano}"
                         HorizontalAlignment="Center" LetterSpacing="0.4" Text="{Binding Name}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- A crossfade is ONE drawing and TWO ramps, so the editor says which line is which. Only on a
           crossfade: every other curve here genuinely has one side, and a legend for a line that is not
           drawn would be worse than none. -->
      <Border DockPanel.Dock="Bottom" Classes="chain" Margin="10,0,10,8"
              IsVisible="{Binding IsCrossfade}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Border Classes="badge"><TextBlock Text="{x:Static res:Strings.CurveEdCrossfade}" /></Border>
          <Rectangle Width="18" Height="2" VerticalAlignment="Center"
                     Fill="{DynamicResource GelCongo}" />
          <TextBlock Classes="mono dim2 small" VerticalAlignment="Center" Text="{x:Static res:Strings.CurveEdGoingOut}" />
          <Rectangle Width="18" Height="2" VerticalAlignment="Center" Opacity="0.55"
                     Fill="{DynamicResource GelAmber}" />
          <TextBlock Classes="mono dim2 small" VerticalAlignment="Center" Text="{x:Static res:Strings.CurveEdComingIn}" />
          <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="{Binding CompanionNote}" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,220" ColumnSpacing="7" Margin="10,2,10,10">

        <c:CurveCanvas Grid.Column="0"
                       AutomationProperties.Name="Curve point editor"
                       AutomationProperties.HelpText="{x:Static res:Strings.CurveEdDragPointsToShapeThe}"
                       Points="{Binding Points}"
                       Shape="{Binding Shape}"
                       CompanionShape="{Binding Companion}"
                       Tangents="{Binding Tangents}"
                       Gesture="OnCurveGesture"
                       GestureCompleted="OnCurveGestureCompleted"
                       SelectAllRequested="OnSelectAllPoints"
                       CopyRequested="OnCopyPoints"
                       PasteRequested="OnPastePoints"
                       HoldToggled="OnHoldToggled" />

        <StackPanel Grid.Column="1" Spacing="4">
          <!-- The same three verbs the timeline lane offers. Buttons as well as the canvas shortcuts,
               because the shortcuts only fire while the canvas itself holds focus. -->
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.CurveEdSelection}">
            <WrapPanel Orientation="Horizontal">
              <Button Classes="tight" Content="{x:Static res:Strings.TlSelectAll}" Click="OnSelectAllPointsClicked"
                      ToolTip.Tip="{x:Static res:Strings.CurveEdSelectEveryPointCtrlA}" />
              <Button Classes="tight" Content="{x:Static res:Strings.TlCopy}" Click="OnCopyPointsClicked"
                      ToolTip.Tip="{x:Static res:Strings.CurveEdCopyTheSelectedPointsCtrl}" />
              <Button Classes="tight" Content="{x:Static res:Strings.TlPaste}" Click="OnPastePointsClicked"
                      ToolTip.Tip="{x:Static res:Strings.CurveEdPasteAtTheSelectedPoint}" />
            </WrapPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.CurveEdTime}">
            <TextBox Text="{Binding PointTime}" IsEnabled="{Binding HasSelection}"
                     ToolTip.Tip="{x:Static res:Strings.CurveEdClockTimeWhenTheDuration}" />
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.CurveEdValue}">
            <TextBox Text="{Binding PointValue}" IsEnabled="{Binding HasSelection}"
                     ToolTip.Tip="{x:Static res:Strings.CurveEdEnterDbInDbScale}" />
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.CurveEdScale}">
            <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding Scales}"
                     SelectedItem="{Binding Scale, Mode=TwoWay}" />
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.CurveEdSegment}"
                                  IsEnabled="{Binding HasSelection}">
            <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding Segments}"
                     SelectedItem="{Binding Segment, Mode=TwoWay}" />
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.CurveEdSaveAs}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
              <TextBox Grid.Column="0" Text="{Binding PresetName}" />
              <Button Grid.Column="1" Classes="tight" Content="{x:Static res:Strings.CurveEdSave}" Click="OnSavePreset" />
            </Grid>
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="{x:Static res:Strings.CurveEdPresetLibrary}">
            <StackPanel Spacing="4">
              <ComboBox ItemsSource="{Binding Presets}"
                        SelectedIndex="{Binding SelectedPresetIndex, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CurvePresetRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="mono dim3 micro" Text="{Binding ReferenceLabel}" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Text="{Binding ManagedPresetName}" IsEnabled="{Binding HasManagedPreset}" />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="tight" Content="{x:Static res:Strings.AudRename}" IsEnabled="{Binding HasManagedPreset}"
                        Click="OnRenamePreset" />
                <Button Classes="tight" Content="{x:Static res:Strings.CurveEdDelete}" IsEnabled="{Binding HasManagedPreset}"
                        Click="OnDeletePreset"
                        ToolTip.Tip="{x:Static res:Strings.CurveEdReferencedCurvesArePreservedInline}" />
                <Button Classes="tight" Content="{x:Static res:Strings.CurveEdImport}" Click="OnImportPresets" />
              </WrapPanel>
            </StackPanel>
          </HeaderedContentControl>
          <TextBlock Margin="10,0" Classes="mono dim2 micro" TextWrapping="Wrap"
                     Text="{Binding PresetStatus}" />
          <TextBlock Margin="10,4" Classes="mono dim3 micro" TextWrapping="Wrap"
                     Text="{Binding EditHint}" />
          <ContentControl Theme="{StaticResource FieldWide}">
            <Button Classes="primary block" Content="{x:Static res:Strings.AutoEdDone}" Click="OnDone" />
          </ContentControl>
        </StackPanel>
      </Grid>
    </DockPanel>
  </c:PanelBox>
</Window>
