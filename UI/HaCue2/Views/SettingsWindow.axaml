<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:HaCue2.Resources"
        xmlns:c="using:HaCue2.Controls"
        xmlns:vm="using:HaCue2.ViewModels"
        x:Class="HaCue2.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        x:CompileBindings="True"
        Title="{x:Static res:Strings.SetHacue2Settings}"
        Width="1000" Height="680"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BoothBg}"
        Foreground="{DynamicResource BoothInk}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- Screens 12 and 13, in one window with one nav, because the split that matters is a SCOPE split
       and it is easier to understand when both scopes are visible at once:
         · application - this machine, app-settings.json, saves immediately, no undo
         · project     - travels in the file, journaled, ⌘Z works
       A project override always wins AND is always visible in both scopes (register item 26). -->

  <DockPanel>

    <Border Classes="titlebar" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="mono" FontWeight="SemiBold" FontSize="11"
                   LetterSpacing="0.45" Text="{x:Static res:Strings.DiagBrand}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="mono dim2" FontSize="11" Margin="14,0,0,0"
                   Text="{x:Static res:Strings.SetSettings}" VerticalAlignment="Center" />
        <Button Grid.Column="3" Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.TlClose}" Click="OnClose" />
      </Grid>
    </Border>

    <Border Classes="statusbar" DockPanel.Dock="Bottom">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="mono dim3 small" Text="{Binding ScopeNote}" />
        <TextBlock Grid.Column="1" Classes="mono err small" HorizontalAlignment="Center"
                   IsVisible="{Binding HasSettingsProblem}" Text="{Binding SettingsProblem}" />
        <TextBlock Grid.Column="2" Classes="mono dim3 small" Text="{Binding ScopeFile}" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="214,*" Margin="7" ColumnSpacing="7">

      <c:PanelBox Grid.Column="0">
        <StackPanel Margin="0,6">
          <TextBlock Classes="caps" Margin="12,9,12,4" Text="{x:Static res:Strings.SetApplicationThisMachine}" />
          <!-- Each nav binds its OWN selection. Both bound the one shared property, and a ListBox
               whose SelectedItem is not among its items clears itself and writes that null back - so
               picking any project pane blanked the window (every Is*Pane read null.Name). -->
          <ListBox Theme="{StaticResource NavList}"
                   ItemsSource="{Binding ApplicationPanes}"
                   SelectedItem="{Binding SelectedApplicationPane}"
                   ItemTemplate="{StaticResource ScopeItemTemplate}" />
          <TextBlock Classes="caps" Margin="12,12,12,4" Text="{Binding ProjectScopeHeading}" />
          <ListBox Theme="{StaticResource NavList}"
                   ItemsSource="{Binding ProjectPanes}"
                   SelectedItem="{Binding SelectedProjectPane}"
                   ItemTemplate="{StaticResource ScopeItemTemplate}" />
        </StackPanel>
      </c:PanelBox>

      <ScrollViewer Grid.Column="1">
        <Panel>

          <!-- ══ Appearance & layout ═════════════════════════════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsAppearancePane}" Spacing="7">
            <c:PanelBox Header="{x:Static res:Strings.SetAppearanceLayout}" Hint="app-settings.json · not journaled">
              <StackPanel Margin="0,6,0,8">
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetTheme}">
                  <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding Themes}"
                           SelectedItem="{Binding Theme}" />
                </HeaderedContentControl>
                <ContentControl Theme="{StaticResource FieldWide}">
                  <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding ThemeNote}" />
                </ContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetDensity}">
                  <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding Densities}"
                           SelectedItem="{Binding Density}" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetCueRowSize}">
                  <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding RowSizes}"
                           SelectedItem="{Binding RowSize}" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetFontScale}">
                  <TextBox Classes="short" Text="{Binding FontScale}" />
                </HeaderedContentControl>

                <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.ShellMainViewName}" />
                <CheckBox Margin="10,3" IsChecked="{Binding RememberInspectorTab}"
                          Content="{x:Static res:Strings.SetRememberInspectorTabPerCue}" />
                <CheckBox Margin="10,3" IsChecked="{Binding FlatActiveList}"
                          Content="{x:Static res:Strings.SetFlatActiveListDefaultGrouped}" />
                <CheckBox Margin="10,3" IsChecked="{Binding OpenDrawerOnLaunch}"
                          Content="{x:Static res:Strings.SetOpenOutputInfoDrawerOn}" />

                <ContentControl Theme="{StaticResource Subhead}" Content="{x:Static res:Strings.SetMeters}" />
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetBallistics}">
                  <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding Ballistics}"
                           SelectedItem="{Binding Ballistic}" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetPeakHold}">
                  <TextBox Classes="short" Text="{Binding PeakHold}" />
                </HeaderedContentControl>
                <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetClipResets}">
                  <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding ClipResets}"
                           SelectedItem="{Binding ClipReset}" />
                </HeaderedContentControl>
              </StackPanel>
            </c:PanelBox>
          </StackPanel>

          <!-- ══ Transport defaults ══════════════════════════════════════════════════════════ -->
          <c:PanelBox IsVisible="{Binding IsTransportPane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetTransportDefaults}" Hint="app-settings.json · not journaled">
            <StackPanel Margin="0,6,0,8">
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetNewProjectStopFade}">
                <TextBox Classes="short" Text="{Binding AppStopFade}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetPanicFade}">
                <TextBox Classes="short" Text="{Binding AppPanicFade}" />
              </HeaderedContentControl>
              <!-- Two GOs inside the guard window are one GO. The alternative - trusting the operator's
                   finger under pressure - fires the next cue early, which is unrecoverable live. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetDoubleGoGuard}">
                <TextBox Classes="short" Text="{Binding DoubleGoGuard}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetSpaceIsGo}">
                <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding SpaceRules}"
                         SelectedItem="{Binding SpaceRule}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetConfirmStopAll}">
                <TextBox Classes="short" Text="{Binding ConfirmStopAll}" />
              </HeaderedContentControl>
              <CheckBox Margin="10,4" IsChecked="{Binding StandbyFollowsClickDefault}"
                        Content="{x:Static res:Strings.SetNewProjectsStartWithClicking}" />
            </StackPanel>
          </c:PanelBox>

          <!-- ══ Hotkeys ═════════════════════════════════════════════════════════════════════ -->
          <c:PanelBox IsVisible="{Binding IsHotkeysPane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetHotkeys}" Hint="command × gesture">
            <c:PanelBox.Footer>
              <Border Classes="chain">
                <TextBlock Classes="mono dim3 small" TextWrapping="Wrap"
                           Text="{Binding HotkeyCollisionNote}" />
              </Border>
            </c:PanelBox.Footer>

            <StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="8,6">
                <ComboBox Grid.Column="0" ItemsSource="{Binding HotkeyProfiles}"
                          SelectedItem="{Binding HotkeyProfile}" />
                <Button Grid.Column="1" Classes="tight" Content="{x:Static res:Strings.SetResetProfile}" Click="OnResetHotkeys" />
              </Grid>
              <Border DockPanel.Dock="Top" Background="{DynamicResource BoothPanel2}"
                      BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1" Padding="8,4">
                <Grid ColumnDefinitions="*,160,110" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.SetCommand}" />
                  <TextBlock Grid.Column="1" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.SetGesture}" />
                  <TextBlock Grid.Column="2" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.AudGroup}" />
                </Grid>
              </Border>
              <ListBox Theme="{StaticResource TableRows}" ItemsSource="{Binding Hotkeys}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HotkeyRow">
                    <Grid ColumnDefinitions="*,160,110" ColumnSpacing="8" Margin="8,4">
                      <TextBlock Grid.Column="0" FontSize="{DynamicResource FontSizeSmall}" Text="{Binding Command}" />
                      <TextBox Grid.Column="1" Classes="mono small" Text="{Binding Gesture}" />
                      <TextBlock Grid.Column="2" Classes="mono dim3 small" Text="{Binding Group}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </c:PanelBox>

          <!-- ══ Remote API (app default) ════════════════════════════════════════════════════ -->
          <c:PanelBox IsVisible="{Binding IsRemoteApiPane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetRemoteApi}" Hint="the machine default · a project may override it">
            <c:PanelBox.Footer>
              <Border Classes="chain">
                <DockPanel LastChildFill="True">
                  <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge">
                    <TextBlock Text="{x:Static res:Strings.SetElsewhere}" />
                  </Border>
                  <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{x:Static res:Strings.SetTheRunningServerAndIts}" />
                </DockPanel>
              </Border>
            </c:PanelBox.Footer>

            <StackPanel Margin="0,6,0,8">
              <!-- Default OFF: a cue player that answers the network the moment it launches is a
                   surprise on a venue LAN, and this is a machine-wide default. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspDefault}">
                <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding RemoteDefaults}"
                         SelectedItem="{Binding RemoteDefault}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetPort}">
                <TextBox Classes="short" Text="{Binding RemotePort}" />
              </HeaderedContentControl>
              <CheckBox Margin="10,4" IsChecked="{Binding RemoteLanAllowed}"
                        Content="{x:Static res:Strings.SetAllowCallsFromTheLan}" />
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetToken}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Classes="ro" Text="{Binding RemoteTokenMask}" />
                  <Button Grid.Column="1" Classes="tight" Content="{x:Static res:Strings.SetRotate}" Click="OnRotateToken" />
                </Grid>
              </HeaderedContentControl>
            </StackPanel>
          </c:PanelBox>

          <!-- ══ Media cache ═════════════════════════════════════════════════════════════════ -->
          <c:PanelBox IsVisible="{Binding IsCachePane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetMediaCache}" Hint="derived data only - never show content">
            <StackPanel Margin="0,6,0,8">
              <!-- Advanced, and grouped with the cache because both are about how this MACHINE is set
                   up rather than about the show. The two backends see different devices, so this
                   changes what the whole app thinks the rig is - hence the note about restarting. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetLocalAudioBackend}">
                <ComboBox ItemsSource="{Binding AudioBackends}" SelectedItem="{Binding AudioBackend}" />
              </HeaderedContentControl>
              <ContentControl Theme="{StaticResource FieldWide}">
                <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap"
                           Text="{Binding AudioBackendNote}" />
              </ContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetLocation}">
                <TextBox Text="{Binding CacheRoot}" />
              </HeaderedContentControl>
              <ContentControl Theme="{StaticResource FieldWide}">
                <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding CacheRootNote}" />
              </ContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetWaveforms}">
                <TextBox Classes="short" Text="{Binding WaveformBudget}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetYoutubeMedia}">
                <TextBox Classes="short" Text="{Binding YouTubeBudget}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetInUse}">
                <TextBox Classes="ro" Text="{Binding CacheInUse}" />
              </HeaderedContentControl>
              <ContentControl Theme="{StaticResource FieldWide}">
                <Button Classes="block" Content="{x:Static res:Strings.SetClearWaveformCache}" Click="OnClearCache" Tag="waveforms" />
              </ContentControl>
              <ContentControl Theme="{StaticResource FieldWide}">
                <Button Classes="block" Content="{x:Static res:Strings.SetClearYoutubeCache}" Click="OnClearCache" Tag="youtube" />
              </ContentControl>
              <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                         Text="{x:Static res:Strings.SetEverythingHereIsReDerivable}" />
            </StackPanel>
          </c:PanelBox>

          <!-- ══ Logging & crash reports ═════════════════════════════════════════════════════ -->
          <c:PanelBox IsVisible="{Binding IsLoggingPane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetLoggingCrashReports}">
            <StackPanel Margin="0,6,0,8">
              <!-- The same pipeline the Diagnostics log tail reads. This sets what reaches the FILE;
                   the tail has its own live level picker, because the archive and the reader answer
                   different questions. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetFileLogLevel}">
                <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding FileLogLevel}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudDirectory}">
                <TextBox Text="{Binding LogDirectory}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetRetention}">
                <TextBox Classes="short" Text="{Binding LogRetention}" />
              </HeaderedContentControl>
              <CheckBox Margin="10,4" IsChecked="{Binding CrashDumps}"
                        Content="{x:Static res:Strings.SetWriteACrashReportWhen}" />
              <ContentControl Theme="{StaticResource FieldWide}">
                <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap" Text="{Binding LoggingActivationNote}" />
              </ContentControl>
              <ContentControl Theme="{StaticResource FieldWide}">
                <StackPanel>
                  <Button Classes="block" Content="{x:Static res:Strings.SetOpenLogsFolder}" Click="OnOpenLogs" />
                  <TextBlock Classes="mono dim3 micro" Margin="10,4" TextWrapping="Wrap"
                             Text="{Binding CacheNote}" />
                </StackPanel>
              </ContentControl>
            </StackPanel>
          </c:PanelBox>

          <!-- ══ Save, autosave & recovery (project scope) ═══════════════════════════════════ -->
          <c:PanelBox IsVisible="{Binding IsSavePane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetSaveAutosaveRecovery}" Hint="journaled · undoable">
            <StackPanel Margin="0,6,0,8" IsEnabled="{Binding CanEditProject}">
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetAutosaveEvery}">
                <TextBox Classes="short" Text="{Binding AutosaveCadence}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetKeep}">
                <TextBox Classes="short" Text="{Binding RecoveryCopies}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetRecoveryIn}">
                <TextBox Classes="ro" IsReadOnly="True" Text="{Binding RecoveryLocation}" />
              </HeaderedContentControl>
              <!-- Off by default: a GO is a performance action and a disk write on it is a stall. -->
              <CheckBox Margin="10,4" IsChecked="{Binding SaveOnGo}" Content="{x:Static res:Strings.SetSaveOnEveryGo}" />
              <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                         Text="{x:Static res:Strings.SetAnAutosaveNewerThanThe}" />
            </StackPanel>
          </c:PanelBox>

          <!-- ══ New project defaults ════════════════════════════════════════════════════════ -->
          <c:PanelBox IsVisible="{Binding IsNewProjectPane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetNewProjectDefaults}" Hint="applied when a project is created">
            <StackPanel Margin="0,6,0,8">
              <!-- Auto-renumber is ON by default and seeded from here (register item 20). -->
              <CheckBox Margin="10,3" IsChecked="{Binding AutoRenumberDefault}"
                        Content="{x:Static res:Strings.SetAutoRenumberOnInsert}" />
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetSeedAudio}">
                <!-- What LibrarySeeder actually does, so this is a description rather than a value:
                     a TextBox would invite an edit that goes nowhere. -->
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                           Text="{x:Static res:Strings.SetSystemDefaultDeviceMainL}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudMixRate}">
                <TextBox Classes="short" Text="{Binding NewProjectMixRate}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetDefaultFades}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Text="{Binding NewProjectFadeIn}" />
                  <TextBox Grid.Column="1" Text="{Binding NewProjectFadeOut}" />
                </Grid>
              </HeaderedContentControl>
              <TextBlock Margin="10,6" Classes="mono dim3 small" TextWrapping="Wrap"
                         Text="{x:Static res:Strings.SetANewProjectIsSeeded}" />
            </StackPanel>
          </c:PanelBox>

          <!-- ══ Show behaviour (project scope) ══════════════════════════════════════════════ -->
          <c:PanelBox IsVisible="{Binding IsShowBehaviourPane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetShowBehaviour}" Hint="journaled · undoable">
            <StackPanel Margin="0,6,0,8" IsEnabled="{Binding CanEditProject}">
              <!-- Editing is the default everywhere; this row exists only for the show that wants to
                   boot locked (register item 2). -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetOpenIn}">
                <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding OpenModes}"
                         SelectedItem="{Binding OpenMode}" />
              </HeaderedContentControl>
              <CheckBox Margin="10,3" IsChecked="{Binding RunChecksOnOpen}"
                        Content="{x:Static res:Strings.SetRunStatusChecksOnOpen}" />
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetAtListEnd}">
                <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding ListEndPolicies}"
                         SelectedItem="{Binding ListEndPolicy}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetStopFade}">
                <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Classes="short" Text="{Binding ProjectStopFade}" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding StopFadeCurveChoices}"
                            SelectedIndex="{Binding StopFadeCurveIndex, Mode=TwoWay}"
                            ItemTemplate="{StaticResource CurveItemTemplate}"
                            SelectionBoxItemTemplate="{StaticResource CurveNameTemplate}" />
                  <Button Grid.Column="2" Classes="icon" Content="✎" Click="OnEditStopFade"
                          ToolTip.Tip="{x:Static res:Strings.SetEditExactPointsShapedSegments}" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetPanicFade}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Classes="override" Text="{Binding ProjectPanicFade}"
                           PlaceholderText="{x:Static res:Strings.SetFollowsThisMachine}" />
                  <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                             Text="{Binding PanicFadeNote}" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetAVOffset}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Classes="short" Text="{Binding AvOffset}" />
                  <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                             Text="{x:Static res:Strings.SetPositiveShowsThePictureEarlier}" />
                </Grid>
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetFollowLead}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Classes="short" Text="{Binding FollowLead}" />
                  <TextBlock Grid.Column="1" Classes="mono dim3 micro" VerticalAlignment="Center"
                             Text="{x:Static res:Strings.SetOpensAFollowCueS}" />
                </Grid>
              </HeaderedContentControl>
              <CheckBox Margin="10,3" IsChecked="{Binding ExternalInputOffOnOpen}"
                        Content="{x:Static res:Strings.SetExternalInputOffWhenThe}" />
              <CheckBox Margin="10,3" IsChecked="{Binding ClickMovesStandby}"
                        Content="{x:Static res:Strings.SetClickingACueRowMoves}"
                        ToolTip.Tip="{x:Static res:Strings.SetOnByDefaultTurnIt}" />
            </StackPanel>
          </c:PanelBox>

          <!-- ══ Authoring defaults ══════════════════════════════════════════════════════════ -->
          <c:PanelBox IsVisible="{Binding IsAuthoringPane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetAuthoringDefaults}">
            <StackPanel Margin="0,6,0,8" IsEnabled="{Binding CanEditProject}">
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetNewCueTrigger}">
                <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding TriggerModes}"
                         SelectedItem="{Binding TriggerMode}" />
              </HeaderedContentControl>
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetDefaultFades}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <TextBox Grid.Column="0" Text="{Binding ProjectFadeIn}" />
                  <TextBox Grid.Column="1" Text="{Binding ProjectFadeOut}" />
                </Grid>
              </HeaderedContentControl>
              <CheckBox Margin="10,3" IsChecked="{Binding AutoRenumber}"
                        Content="{x:Static res:Strings.SetAutoRenumberOnInsertStep}" />
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetMediaRoot}">
                <TextBox Text="{Binding ProjectMediaRoot}" PlaceholderText="{x:Static res:Strings.SetRelativePathsResolveAgainstThis}" />
              </HeaderedContentControl>
              <!-- Media outside the root is ALLOWED (register item 26): adding one warns and offers
                   move/copy, and this picks the default answer. -->
              <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.SetOutsideMedia}">
                <ListBox Theme="{StaticResource Segment}" ItemsSource="{Binding OutsideMediaPolicies}"
                         SelectedItem="{Binding OutsideMediaPolicy}" />
              </HeaderedContentControl>
              <ContentControl Theme="{StaticResource FieldWide}">
                <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap"
                           Text="{x:Static res:Strings.SetAddingAFileFromOutside}" />
              </ContentControl>
            </StackPanel>
          </c:PanelBox>

          <!-- ══ Overrides ledger ════════════════════════════════════════════════════════════ -->
          <c:PanelBox IsVisible="{Binding IsOverridesPane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetOverrides}" Hint="app settings this project defeats">
            <c:PanelBox.Footer>
              <Border Classes="chain">
                <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Margin="0,0,7,0" Classes="badge"><TextBlock Text="{x:Static res:Strings.SetRule}" /></Border>
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding OverrideNote}" />
              </DockPanel>
              </Border>
            </c:PanelBox.Footer>

            <DockPanel>
              <Border DockPanel.Dock="Top" Background="{DynamicResource BoothPanel2}"
                      BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1" Padding="8,4">
                <Grid ColumnDefinitions="200,180,*,80" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.SetSetting}" />
                  <TextBlock Grid.Column="1" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.SetAppValue}" />
                  <TextBlock Grid.Column="2" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.SetProjectValue}" />
                  <TextBlock Grid.Column="3" Theme="{StaticResource ColumnHeadText}" Text="" />
                </Grid>
              </Border>
              <c:EmptyState IsVisible="{Binding !HasOverrides}"
                            Headline="This project overrides nothing"
                            Detail="Every setting on the application pages is the one in force." />
              <ListBox Theme="{StaticResource TableRows}" IsVisible="{Binding HasOverrides}"
                       ItemsSource="{Binding Overrides}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OverrideRow">
                    <Grid ColumnDefinitions="200,180,*,80" ColumnSpacing="8" Margin="8,4">
                      <TextBlock Grid.Column="0" Classes="mono small" Text="{Binding Setting}" />
                      <TextBlock Grid.Column="1" Classes="mono dim3 small" Text="{Binding AppValue}" />
                      <TextBlock Grid.Column="2" Classes="mono dim2 small" Text="{Binding ProjectValue}" />
                      <Button Grid.Column="3" Theme="{StaticResource LinkButton}" Content="{x:Static res:Strings.SetRevert}"
                              Click="OnRevertOverride" Tag="{Binding Setting}"
                              ToolTip.Tip="{x:Static res:Strings.SetInheritTheMachineSValue}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </c:PanelBox>

          <!-- ══ Project status ══════════════════════════════════════════════════════════════
               The nav has listed this pane since the screen was drawn and nothing was behind it,
               so selecting it emptied the right-hand side. The report is a page of checks rather
               than a settings form, so this is the door to the window that already renders it. -->
          <c:PanelBox IsVisible="{Binding IsProjectStatusPane}" VerticalAlignment="Top"
                      Header="{x:Static res:Strings.SetProjectStatus}" Hint="checks this show against this machine">
            <StackPanel Margin="0,6,0,8" Spacing="8">
              <ContentControl Theme="{StaticResource FieldWide}">
                <TextBlock Classes="mono dim3 micro" TextWrapping="Wrap"
                           Text="{x:Static res:Strings.SetMediaThatCannotBeFound}" />
              </ContentControl>
              <StackPanel Orientation="Horizontal" Margin="10,0" Spacing="8">
                <Button Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.SetOpenProjectStatus}"
                        IsVisible="{Binding CanOpenProjectStatus}" Click="OnOpenProjectStatus" />
                <TextBlock Classes="mono dim3 small" VerticalAlignment="Center"
                           IsVisible="{Binding !CanOpenProjectStatus}"
                           Text="{x:Static res:Strings.SetOpenAProjectFirstThere}" />
              </StackPanel>
            </StackPanel>
          </c:PanelBox>

        </Panel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
