<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HaCue2.Controls"
             xmlns:v="using:HaCue2.Views"
             xmlns:vm="using:HaCue2.ViewModels"
             x:Class="HaCue2.Views.CuesView"
             x:DataType="vm:CuesViewModel">

  <!-- Screens 02, 03, 05. The launch state: editing, unlocked, everything live. -->

  <DockPanel>

    <!-- ══ transport ═══════════════════════════════════════════════════════════════════════
         GO always works. There are no arming gates on playback (register item 3) — the only arm
         left is External input, which covers MIDI/OSC/hotkey triggers, schedules and MTC chase, and
         never gates GO. -->
    <Border Classes="transport" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="7">
        <Button Grid.Column="0" Classes="go" Content="GO" Click="OnGo"
                AutomationProperties.Name="Go current cue list" />
        <Button Grid.Column="1" Content="{Binding PauseLabel}" Click="OnPause"
                AutomationProperties.Name="Pause or resume all active cues" />
        <!-- Bare STOP takes down the selected active cue; stop-all is the split menu, because a
             single button that sometimes stops one cue and sometimes stops the show is a button
             nobody can press with confidence during a performance. -->
        <Button Grid.Column="2" Content="STOP ▾" Click="OnStop"
                AutomationProperties.Name="Stop selected active cue"
                ToolTip.Tip="Stops the selected active cue. Right-click, or the arrow, for stop-all.">
          <Button.ContextFlyout>
            <MenuFlyout>
              <MenuItem Header="Stop all" Click="OnStopAll" />
            </MenuFlyout>
          </Button.ContextFlyout>
        </Button>
        <!-- Held, not clicked (register decision: ~400 ms). The one button an operator hits without
             reading is the one that must not fire on a mis-click. -->
        <!-- The hold gesture is wired in code-behind, NOT here: Button marks PointerPressed and
             PointerReleased handled in its own class handler, so a handler declared in markup is
             never called and PANIC did nothing at all. See CuesView's constructor. -->
        <Button Grid.Column="3" Classes="panic" Name="PanicButton" Content="{Binding PanicLabel}"
                AutomationProperties.Name="Panic; hold to stop everything"
                ToolTip.Tip="Hold to stop everything." />
        <Button Grid.Column="4" Classes="icon" Content="↑ STBY" Click="OnStandbyUp"
                AutomationProperties.Name="Move standby up" />
        <Button Grid.Column="5" Classes="icon" Content="↓ STBY" Click="OnStandbyDown"
                AutomationProperties.Name="Move standby down" />
        <!-- Multi-list transport is v1 (register item 5): the transport acts on the selected list and
             every list keeps its own standby. -->
        <Button Grid.Column="6" Content="{Binding ListSelector}" Click="OnSelectList"
                AutomationProperties.Name="Choose current cue list"
                ToolTip.Tip="Choose which cue list GO and standby control." />

        <ToggleButton Grid.Column="8" Theme="{StaticResource ChipToggle}"
                      AutomationProperties.Name="External input master enable"
                      IsChecked="{Binding $parent[v:ShellWindow].((vm:ShellViewModel)DataContext).IsExternalInputEnabled}"
                      ToolTip.Tip="MIDI/OSC/hotkey triggers, wall-clock schedules and MTC chase. Off when a project opens; never gates GO.">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Classes="led"
                     Classes.ok="{Binding $parent[v:ShellWindow].((vm:ShellViewModel)DataContext).IsExternalInputEnabled}" />
            <TextBlock Text="EXTERNAL INPUT" />
          </StackPanel>
        </ToggleButton>

        <Border Grid.Column="9" Classes="chip"><TextBlock Text="{Binding ChaseReadout}" /></Border>
        <ToggleButton Grid.Column="7" HorizontalAlignment="Right" Classes="tight"
                      IsChecked="{Binding IsRightPanelOpen}" Click="OnToggleRightPanel"
                      Content="{Binding RightPanelToggleLabel}"
                      AutomationProperties.Name="Show or hide cue inspector" />
      </Grid>
    </Border>

    <Border Classes="transport second" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="7">
        <!-- Media first and separate: picking files IS how a show gets built, and burying it in a
             menu behind six cue kinds nobody adds by hand would be the wrong shape. -->
        <Button Grid.Column="0" Content="+ MEDIA…" Click="OnAddMedia"
                IsEnabled="{Binding CanEditDocument}" />
        <Button Grid.Column="1" Content="+ ADD ▾" IsEnabled="{Binding CanEditDocument}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Group" Click="OnAddCue" Tag="Group" />
              <MenuItem Header="Action" Click="OnAddCue" Tag="Action" />
              <MenuItem Header="Fade" Click="OnAddCue" Tag="Fade" />
              <MenuItem Header="Jump" Click="OnAddCue" Tag="Jump" />
              <MenuItem Header="Patch" Click="OnAddCue" Tag="Patch" />
              <MenuItem Header="Visualizer" Click="OnAddCue" Tag="Visualizer" />
              <MenuItem Header="Text" Click="OnAddCue" Tag="Text" />
              <Separator />
              <!-- Sources rather than files. Each is an ordinary media cue whose path is a URI the
                   registry knows how to open, so everything below it — level, sends, placements,
                   fades — means exactly what it means for a file on disk. -->
              <MenuItem Header="NDI input…" Click="OnAddNdi" />
              <MenuItem Header="Local input…" Click="OnAddCapture" />
              <MenuItem Header="YouTube…" Click="OnAddYouTube" />
              <Separator />
              <MenuItem Header="Comment" Click="OnAddCue" Tag="Comment" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="2" Content="DUPLICATE" Click="OnDuplicate"
                IsEnabled="{Binding CanModifySelection}" />
        <Button Grid.Column="3" Content="REMOVE" Click="OnRemove"
                IsEnabled="{Binding CanModifySelection}" />
        <Button Grid.Column="4" Classes="icon" Content="RENUMBER…" Click="OnRenumber"
                IsEnabled="{Binding CanEditDocument}" />
        <!-- An import that failed produced no cue and, until now, no word about why. Red, beside the
             button that started it, and trimmed rather than allowed to push the row wider. -->
        <TextBlock Grid.Column="5" Classes="mono small" VerticalAlignment="Center"
                   Foreground="{DynamicResource GelRed}" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding HasMediaImportProblem}"
                   Text="{Binding MediaImportProblem}"
                   ToolTip.Tip="{Binding MediaImportProblem}" />
        <TextBlock Grid.Column="6" Classes="mono dim3 small" VerticalAlignment="Center"
                   IsVisible="{Binding ShowsTransportHint}"
                   Text="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).TransportHint}" />
        <!-- An audition is inaudible in the room, so the only way an operator knows it is running is
             to be told. Shown in place of the hint, which is advice they have already read. -->
        <TextBlock Grid.Column="6" Classes="mono small" VerticalAlignment="Center"
                   IsVisible="{Binding ShowsPreviewHint}" Text="{Binding PreviewHint}" />
        <!-- A two-second network scan with nothing on screen reads as a click that missed. -->
        <TextBlock Grid.Column="6" Classes="mono small" VerticalAlignment="Center"
                   IsVisible="{Binding IsScanningSources}"
                   Text="looking for NDI senders on the network…" />
      </Grid>
    </Border>

    <!-- ══ timeline sheet (screen 05) ═══════════════════════════════════════════════════════
         In a Grid rather than docked, so the split above it can be dragged: how much of the screen
         the sheet takes against the cue list is the same kind of per-show decision as the other two
         splits. Both the sheet and the splitter disappear together when it is closed or undocked. -->
    <Grid DockPanel.Dock="Bottom"
          RowDefinitions="4,Auto"
          IsVisible="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).IsTimelineOpen}">
      <GridSplitter Grid.Row="0" Height="4" HorizontalAlignment="Stretch"
                    Background="Transparent" ResizeDirection="Rows" />
      <v:TimelineSheet Grid.Row="1" MinHeight="140" DataContext="{Binding Timeline}" />
    </Grid>

    <!-- ══ tree · active · right column ════════════════════════════════════════════════════ -->
    <!-- Both splits are draggable: how much of the screen the cue list gets against the Active panel,
         and how wide the right column is, are decisions that change per show and per operator. The
         minimums stop either side being dragged to nothing, which is the one way a splitter can lose
         a panel for good. -->
    <Grid Margin="7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="{Binding RightSplitterWidth}" />
        <ColumnDefinition Width="{Binding RightPanelWidth}" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" RowDefinitions="2*,4,Auto" MinWidth="420">

        <!-- ── the cue tree ─────────────────────────────────────────────────────────────── -->
        <c:PanelBox Grid.Row="0" MinHeight="240"
                    Header="{Binding Breadcrumb}" Hint="{Binding TreeHint}">
          <Panel>
          <!-- A list nobody has put a cue in yet says so and names the way out. -->
          <c:EmptyState IsVisible="{Binding IsEmpty}"
                        Headline="No cues in this list"
                        Detail="Use + ADD above to make one. GO still works — it simply has nothing to fire." />

          <!-- The tree proper. A TreeDataGrid rather than an indented flat list because a group
               has to LOOK like a group: it carries a chevron, it opens and closes, and its cues are
               visibly inside it. An indent margin alone could not tell a group apart from a cue that
               happened to be nested — which is what this replaced. -->
          <TreeDataGrid IsVisible="{Binding !IsEmpty}" Source="{Binding CueSource}"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="False"
                        AutomationProperties.Name="Cue list tree">
            <TreeDataGrid.ContextMenu>
              <ContextMenu>
                <!-- Not edits, so they stay live under Lock — but they need a selected cue, and with
                     none they used to sit enabled and do nothing. -->
                <MenuItem Header="Fire this cue now" Click="OnFireSelected"
                          IsEnabled="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).HasSelection}" />
                <MenuItem Header="Preview on audition outputs" InputGesture="Ctrl+P" Click="OnPreview"
                          IsEnabled="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).HasSelection}" />
                <MenuItem Header="Move standby here" Click="OnStandbyHere"
                          IsEnabled="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).HasSelection}" />
                <Separator />
                <MenuItem Header="Edit source…" Click="OnEditSource"
                          IsVisible="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).CanEditSource}"
                          IsEnabled="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).CanEditDocument}" />
                <MenuItem Header="Open timeline" Click="OnOpenTimeline"
                          IsEnabled="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).CanOpenTimeline}" />
                <MenuItem Header="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).ToggleEnabledLabel}"
                          Click="OnToggleEnabled"
                          IsEnabled="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).CanModifySelection}" />
                <MenuItem Header="Renumber from here…" Click="OnRenumber"
                          IsEnabled="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).CanEditDocument}" />
              </ContextMenu>
            </TreeDataGrid.ContextMenu>

            <TreeDataGrid.Resources>
              <!-- One template per column, keyed by the name the source asks for. -->

              <DataTemplate x:Key="StripeCell" x:DataType="vm:CueRow">
                <Border Classes="stripe"
                        Classes.is-stby="{Binding IsStandby}"
                        Classes.is-go="{Binding IsRunning}"
                        Classes.is-broke="{Binding IsBroken}"
                        Classes.grp="{Binding IsGroup}" />
              </DataTemplate>

              <DataTemplate x:Key="NumberCell" x:DataType="vm:CueRow">
                <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,6,0" VerticalAlignment="Center">
                  <!-- The colour tag, beside the number and before the glyph. The fastest thing to
                       read in a list of six hundred rows: an operator finds "the blue block" before
                       they find Q412. Collapsed entirely when untagged, so an unused feature costs
                       the row no width. -->
                  <Border Width="4" VerticalAlignment="Stretch" CornerRadius="1"
                          IsVisible="{Binding HasColorTag}"
                          Background="{Binding ColorBrush}" />
                  <TextBlock Classes="qnum" Classes.off="{Binding IsDisabled}"
                             Width="46" TextAlignment="Right" Text="{Binding Number}" />
                  <TextBlock Classes="glyph"
                             Classes.is-go="{Binding IsRunning}"
                             Classes.is-stby="{Binding IsStandby}"
                             Text="{Binding Glyph}" />
                </StackPanel>
              </DataTemplate>

              <DataTemplate x:Key="LabelCell" x:DataType="vm:CueRow">
                <TextBlock Classes="cuelabel" Margin="2,0,8,0" VerticalAlignment="Center"
                           Classes.grp="{Binding IsGroup}"
                           Classes.is-go="{Binding IsRunning}"
                           Classes.is-stby="{Binding IsStandby}"
                           Classes.off="{Binding IsDisabled}"
                           Text="{Binding Label}" />
              </DataTemplate>

              <DataTemplate x:Key="SourceCell" x:DataType="vm:CueRow">
                <TextBlock Classes="src" Margin="0,0,8,0" VerticalAlignment="Center"
                           Classes.is-broke="{Binding IsBroken}" Text="{Binding Source}" />
              </DataTemplate>

              <DataTemplate x:Key="FadeCell" x:DataType="vm:CueRow">
                <TextBlock Classes="num" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding Fade}" />
              </DataTemplate>

              <DataTemplate x:Key="LengthCell" x:DataType="vm:CueRow">
                <TextBlock Classes="num" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding Length}" />
              </DataTemplate>

              <DataTemplate x:Key="LevelCell" x:DataType="vm:CueRow">
                <TextBlock Classes="num" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding Level}" />
              </DataTemplate>

              <DataTemplate x:Key="BadgeCell" x:DataType="vm:CueRow">
                <ItemsControl ItemsSource="{Binding Badges}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,8,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Badge">
                      <Border Classes="badge"
                              Classes.midi="{Binding IsMidi}"
                              Classes.osc="{Binding IsOsc}"
                              Classes.clock="{Binding IsClock}"
                              Classes.bad="{Binding IsBad}"
                              Classes.good="{Binding IsGood}">
                        <TextBlock Text="{Binding Text}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </TreeDataGrid.Resources>
          </TreeDataGrid>
          </Panel>
        </c:PanelBox>

        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeDirection="Rows" />

        <!-- ── the Active panel ─────────────────────────────────────────────────────────────
             Nothing about the current scope can hide a sounding cue: groups aggregate their sounding
             children and cues from another list carry that list's name. -->
        <c:PanelBox Grid.Row="2" MinHeight="120"
                    Header="Active" Subhead="{Binding ActiveCues.Count}"
                    Hint="{Binding ActivePanelHint}">
          <!-- The seek latch. LOCKED by default: these bars sit under the pointer for the whole show,
               a drag on one is instantly audible in the room, and there is no undo for it. -->
          <c:PanelBox.Footer>
            <Border Classes="chain">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                <ToggleButton Grid.Column="0" Theme="{StaticResource ChipToggle}"
                              IsChecked="{Binding SeekUnlocked}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse Classes="led" Classes.warn="{Binding SeekUnlocked}" />
                    <TextBlock Text="{Binding SeekLockLabel}" />
                  </StackPanel>
                </ToggleButton>
                <TextBlock Grid.Column="1" Classes="mono dim3 small" VerticalAlignment="Center"
                           TextWrapping="Wrap" Text="{Binding SeekLockHint}" />
              </Grid>
            </Border>
          </c:PanelBox.Footer>
          <!-- Two row shapes, templated by TYPE: a lone sounding cue, and a GROUP that owns the ones
               inside it. A playlist of twelve used to fill this panel with twelve equal rows and
               nothing saying they were one thing. -->
          <ListBox ItemsSource="{Binding ActivePanelRows}"
                   ItemContainerTheme="{StaticResource ReadonlyRowItem}">
            <ListBox.DataTemplates>

              <DataTemplate DataType="vm:ActiveGroupRow">
                <Border Classes="actrow grp" Classes.near="{Binding IsNearEnd}">
                  <StackPanel Margin="0,0,10,0">
                    <Grid ColumnDefinitions="3,22,46,*,52,120,150,22" ColumnSpacing="7">
                      <Border Grid.Column="0" Classes="stripe is-go grp" />
                      <!-- Expanded by default: a group that hid its children would show LESS than the
                           flat list it replaced. -->
                      <ToggleButton Grid.Column="1" Classes="tight" MinWidth="20" Padding="3,0"
                                    IsChecked="{Binding IsExpanded}" Content="▾"
                                    AutomationProperties.Name="Expand active group"
                                    ToolTip.Tip="Show the cues inside this group" />
                      <TextBlock Grid.Column="2" Classes="qnum" Text="{Binding Number}" />
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                  VerticalAlignment="Center">
                        <TextBlock Classes="cuelabel" Text="{Binding Label}" />
                        <TextBlock Classes="mono dim3" FontSize="{DynamicResource FontSizeMonoSmall}"
                                   Text="{Binding Mode}" />
                      </StackPanel>
                      <TextBlock Grid.Column="4" Classes="mono dim3 small" VerticalAlignment="Center"
                                 Text="{Binding Position}" ToolTip.Tip="where the group is in its chain" />
                      <TextBlock Grid.Column="5" Classes="clock" Text="{Binding Clock}"
                                 ToolTip.Tip="the WHOLE group's remaining and total" />
                      <ProgressBar Grid.Column="6" Maximum="1" Value="{Binding Progress}"
                                   VerticalAlignment="Center"
                                   Classes.near="{Binding IsNearEnd}" />
                      <Button Grid.Column="7" Classes="icon" Content="×" Click="OnStopGroup"
                              Tag="{Binding GroupId}"
                              AutomationProperties.Name="Stop active group"
                              ToolTip.Tip="Stop everything in this group." />
                    </Grid>

                    <StackPanel Margin="24,2,0,0" IsVisible="{Binding IsExpanded}">
                      <ItemsControl ItemsSource="{Binding Children}" />
                      <!-- The rest of the chain, each with a countdown. What the group has committed
                           the show to next, which is the other half of "what is happening". -->
                      <ItemsControl ItemsSource="{Binding Upcoming}" IsVisible="{Binding HasUpcoming}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:UpcomingCueRow">
                            <Grid ColumnDefinitions="46,*,66,90" ColumnSpacing="7" Margin="0,1">
                              <TextBlock Grid.Column="0" Classes="qnum dim3" Text="{Binding Number}" />
                              <TextBlock Grid.Column="1" Classes="mono dim3 small ellipsis"
                                         VerticalAlignment="Center" Text="{Binding Label}" />
                              <TextBlock Grid.Column="2" Classes="clock dim3" Text="{Binding Length}" />
                              <TextBlock Grid.Column="3" Classes="clock dim3" Text="{Binding Countdown}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>

              <DataTemplate DataType="vm:ActiveCueRow">
                <Border Classes="actrow"
                        Classes.grp="{Binding IsGroup}"
                        Classes.near="{Binding IsNearEnd}">
                  <!-- Elapsed · remaining · length, which is the set HaPlay's Now Playing shows and the
                       set somebody driving a show actually reads: where it is, how long they have, and
                       what the whole thing runs for. -->
                  <Grid ColumnDefinitions="3,46,*,66,66,52,150,78,22" ColumnSpacing="7" Margin="0,0,10,0">
                    <Border Grid.Column="0" Classes="stripe is-go"
                            Classes.fading="{Binding IsFading}"
                            Classes.grp="{Binding IsGroup}" />
                    <TextBlock Grid.Column="1" Classes="qnum" Margin="{Binding NumberIndent}"
                               Text="{Binding Number}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                      <TextBlock Classes="cuelabel" Text="{Binding Label}" />
                      <TextBlock Classes="mono dim3" FontSize="{DynamicResource FontSizeMonoSmall}"
                                 IsVisible="{Binding HasQualifier}" Text="{Binding Qualifier}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Classes="clock" Text="{Binding Clock}" />
                    <TextBlock Grid.Column="4" Classes="clock" Text="{Binding Remaining}"
                               ToolTip.Tip="remaining" />
                    <TextBlock Grid.Column="5" Classes="clock dim3" Text="{Binding Length}"
                               ToolTip.Tip="whole clip" />
                    <!-- Draggable. The bar follows the finger during a gesture and the show follows on
                         release — a seek per pointer-move would re-buffer the clip on every pixel. -->
                    <c:SeekBar Grid.Column="6" Maximum="1" Value="{Binding Progress}"
                               AutomationProperties.Name="Seek active cue"
                               IsSeekable="{Binding CanSeek}"
                               IsEnabled="{Binding $parent[v:CuesView].((vm:CuesViewModel)DataContext).SeekUnlocked}"
                               VerticalAlignment="Center"
                               Seeked="OnSeekActive"
                               Tag="{Binding CueId}"
                               Classes.fading="{Binding IsFading}"
                               Classes.near="{Binding IsNearEnd}"
                               ToolTip.Tip="Drag to seek this cue." />
                    <TextBlock Grid.Column="7" Classes="dest" Text="{Binding Destination}" />
                    <!-- A real button. It was a TextBlock, so the one obvious way to stop a single
                         sounding cue did nothing at all. -->
                    <Button Grid.Column="8" Classes="icon" Content="×" Click="OnStopActive"
                            Tag="{Binding CueId}"
                            AutomationProperties.Name="Stop active cue"
                            ToolTip.Tip="Stop this cue." />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
        </c:PanelBox>
      </Grid>

      <GridSplitter Grid.Column="1" Width="4" VerticalAlignment="Stretch"
                    IsVisible="{Binding IsRightPanelOpen}"
                    AutomationProperties.Name="Resize cue inspector"
                    Background="Transparent" ResizeDirection="Columns" />

      <!-- ── right column: Cue properties | Lists & groups, tabs on the BOTTOM edge ───────── -->
      <c:PanelBox Grid.Column="2" MinWidth="240"
                  IsVisible="{Binding IsRightPanelOpen}"
                  Header="{Binding RightPanelHeader}" Hint="{Binding RightPanelHint}">
        <c:PanelBox.Footer>
          <ListBox Theme="{StaticResource BottomTabs}"
                   ItemsSource="{Binding RightTabs}"
                   SelectedItem="{Binding SelectedRightTab}" />
        </c:PanelBox.Footer>

        <Panel>
          <v:InspectorPane DataContext="{Binding Inspector}"
                           IsVisible="{Binding $parent[c:PanelBox].((vm:CuesViewModel)DataContext).IsPropertiesTab}" />
          <v:ScopePane IsVisible="{Binding !IsPropertiesTab}" />
        </Panel>
      </c:PanelBox>
    </Grid>
  </DockPanel>
</UserControl>
