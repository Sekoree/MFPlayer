<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:HaCue2.Resources"
        xmlns:c="using:HaCue2.Controls"
        xmlns:vm="using:HaCue2.ViewModels"
        x:Class="HaCue2.Views.YouTubeCueWindow"
        x:DataType="vm:YouTubeCueViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BoothBg}"
        Foreground="{DynamicResource BoothInk}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- Its own window rather than a prompt: a network round trip and two real stream choices do not
       fit a box with two fields and a verb. The long download continues after this window closes. -->

  <c:PanelBox Header="{Binding Title}"
              Hint="adding queues an offline copy; Project status verifies it before show time"
              Margin="7">
    <DockPanel>

      <Border DockPanel.Dock="Bottom" Classes="chain">
        <DockPanel LastChildFill="False">
          <Button DockPanel.Dock="Right" Classes="primary" Content="{x:Static res:Strings.YtAddDownloadInBackground}"
                  IsEnabled="{Binding CanPrepare}" Command="{Binding PrepareCommand}" />
          <Button DockPanel.Dock="Right" Classes="tight" Margin="0,0,6,0"
                  Content="{x:Static res:Strings.PromptCancel}" Click="OnCancel" />
        </DockPanel>
      </Border>

      <StackPanel Margin="0,6,0,8">

        <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.YtLink}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" Text="{Binding Url}"
                     PlaceholderText="{x:Static res:Strings.YtHttpsWwwYoutubeComWatch}" />
            <Button Grid.Column="1" Classes="tight" Content="{x:Static res:Strings.YtFetch}"
                    IsEnabled="{Binding IsIdle}" Command="{Binding ResolveCommand}" />
          </Grid>
        </HeaderedContentControl>

        <TextBlock Classes="mono bad small" Margin="115,0,10,4" TextWrapping="Wrap"
                   IsVisible="{Binding Problem.Length}" Text="{Binding Problem}" />

        <StackPanel IsVisible="{Binding HasManifest}">

          <ContentControl Theme="{StaticResource FieldWide}">
            <Border Classes="chain">
              <TextBlock Classes="mono dim2 small" TextWrapping="Wrap" Text="{Binding VideoNote}" />
            </Border>
          </ContentControl>

          <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.AudName2}">
            <TextBox Text="{Binding Name}" />
          </HeaderedContentControl>

          <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.YtVideo}">
            <ComboBox HorizontalAlignment="Stretch" IsEnabled="{Binding !AudioOnly}"
                      ItemsSource="{Binding VideoStreams}" SelectedIndex="{Binding VideoIndex}" />
          </HeaderedContentControl>

          <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.YtAudio}">
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AudioStreams}" SelectedIndex="{Binding AudioIndex}" />
          </HeaderedContentControl>

          <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.InspSubtitles}">
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding SubtitleTracks}" SelectedIndex="{Binding SubtitleIndex}" />
          </HeaderedContentControl>

          <CheckBox Margin="10,6,10,0" IsChecked="{Binding AudioOnly}"
                    Content="{x:Static res:Strings.YtSoundOnlyDoNotDownload}" />
          <!-- The thumbnail rides along as an attached picture, exactly like MP3 cover art, so an
               audio-only cue still has something to put on a screen. -->
          <CheckBox Margin="10,2,10,0" IsChecked="{Binding IncludeThumbnail}"
                    Content="{x:Static res:Strings.YtIncludeTheThumbnailAsA}" />

          <TextBlock Classes="mono dim3 micro" Margin="12,7,10,0" TextWrapping="Wrap"
                     Text="{Binding CacheNote}" />

        </StackPanel>

      </StackPanel>
    </DockPanel>
  </c:PanelBox>
</Window>
