<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HaCue2.Controls"
             xmlns:vm="using:HaCue2.ViewModels"
             x:Class="HaCue2.Views.TimelineSheet"
             x:DataType="vm:TimelineViewModel"
             x:CompileBindings="True">

  <!-- Screen 05. A bottom sheet by default, undockable to its own window (mode remembered per
       machine). Envelopes are not a fixed overlay: volume, opacity and outbound OSC/MIDI ramps are
       effect LANES added per cue or per group and hidden until added (register item 18). -->

  <!-- No fixed height: docked, the host row (and its splitter) decide; floating, the window does.
       A hard Height here was why the undocked editor ignored its window being resized and why the
       docked splitter moved nothing. -->
  <c:PanelBox Header="{Binding Title}" Hint="{Binding Hint}" Margin="7,0,7,7">

    <c:PanelBox.Footer>
      <Border Classes="chain">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
          <Button Grid.Column="0" Classes="icon" Content="+ EFFECT LANE ▾">
            <Button.Flyout>
              <!-- Tags are enum NAMES, not ordinals: a reordered EffectLaneKind would silently make
                   these add the wrong kind. Each item is disabled rather than hidden when the
                   selected cue cannot carry it (volume needs audio, opacity needs placeable video,
                   and one lane per kind), so the rule is visible instead of arriving as a refusal
                   after the click. -->
              <MenuFlyout>
                <MenuItem Header="Volume" Click="OnAddLane" Tag="Volume"
                          IsEnabled="{Binding CanAddVolumeLane}" />
                <MenuItem Header="Opacity" Click="OnAddLane" Tag="Opacity"
                          IsEnabled="{Binding CanAddOpacityLane}" />
                <Separator />
                <MenuItem Header="OSC ramp" Click="OnAddLane" Tag="OscRamp"
                          IsEnabled="{Binding CanAddOscLane}" />
                <MenuItem Header="MIDI ramp" Click="OnAddLane" Tag="MidiRamp"
                          IsEnabled="{Binding CanAddMidiLane}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <TextBlock Grid.Column="1" Classes="mono dim3 small" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding KeyframeStatus}" />
          <Border Grid.Column="2" Classes="badge"><TextBlock Text="LIVE" /></Border>
          <TextBlock Grid.Column="3" Classes="mono dim3 small" VerticalAlignment="Center"
                     Text="edits while running apply on the next pass" />
        </Grid>
      </Border>
    </c:PanelBox.Footer>

    <DockPanel>

      <Border Classes="transport" DockPanel.Dock="Top">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="7">
          <Button Grid.Column="0" Classes="icon" Content="▶ FROM PLAYHEAD" Click="OnPlayFrom" />
          <Button Grid.Column="1" Classes="icon" Content="⏹" Click="OnStopTimeline" />
          <Button Grid.Column="2" Classes="icon" Content="ZOOM −" Click="OnZoomOut" />
          <Button Grid.Column="3" Classes="icon" Content="ZOOM +" Click="OnZoomIn" />
          <Button Grid.Column="4" Classes="icon" Content="FIT" Click="OnZoomFit" />
          <ListBox Grid.Column="5" Theme="{StaticResource Segment}"
                   ItemsSource="{Binding SnapModes}" SelectedItem="{Binding SnapMode}" />
          <Button Grid.Column="6" Content="DUCK UNDER…" Click="OnDuck" />
          <TextBlock Grid.Column="7" Classes="mono dim3 small" VerticalAlignment="Center"
                     Margin="8,0" Text="{Binding PlayheadLabel, StringFormat='▮ {0}'}" />
          <!-- The refusal sits beside the buttons: "the show is not running" is the usual answer on a
               laptop, and a modal for it is one nobody reads. -->
          <TextBlock Grid.Column="7" Classes="mono small warn" HorizontalAlignment="Right"
                     VerticalAlignment="Center" Margin="8,0" Text="{Binding TransportProblem}" />
          <Button Grid.Column="8" Classes="icon" Content="{Binding DockLabel}" Click="OnUndock" />
          <Button Grid.Column="9" Classes="icon" Content="CLOSE ⎋" Click="OnClose" />
        </Grid>
      </Border>

      <Panel Background="{DynamicResource BoothBg}">
        <DockPanel>

          <!-- ruler: the label column is skipped so 0:00 lines up with the start of the tracks -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="168,*"
                Background="{DynamicResource BoothBg}">
            <Border Grid.Column="0" BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,1,1" />
            <!-- Clicking the ruler places the playhead: the ruler IS the time axis, so it is where
                 somebody reaches to say "start here". -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Ruler}" Background="Transparent"
                          PointerPressed="OnRulerPressed"
                          PointerMoved="OnRulerMoved"
                          PointerReleased="OnRulerReleased"
                          PointerCaptureLost="OnRulerCaptureLost"
                          BorderBrush="{DynamicResource BoothRule}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BoothRule}" BorderThickness="1,0,0,1" Padding="4,2">
                    <TextBlock Classes="mono dim3" FontSize="{DynamicResource FontSizeNano}"
                               Text="{Binding}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- The window onto the group: drag to pan; the thumb's size is the zoom. Shift+wheel pans
               and Ctrl+wheel zooms anywhere over the sheet (see OnWheel). -->
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="168,*">
            <Border Grid.Column="0" BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,1,1,0" />
            <ScrollBar Grid.Column="1" Orientation="Horizontal" AllowAutoHide="False"
                       Minimum="0"
                       Maximum="{Binding ViewMaxStartMs}"
                       ViewportSize="{Binding ViewLengthMs}"
                       Value="{Binding ViewStartMs, Mode=TwoWay}" />
          </Grid>

          <ScrollViewer>
            <Panel>
              <ItemsControl ItemsSource="{Binding Lanes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimelineLane">
                    <Border Classes="tllane"
                            Classes.fx="{Binding IsEffect}"
                            Classes.grp="{Binding IsGroup}"
                            Classes.sel="{Binding IsSelected}"
                            Height="{Binding Height}">
                      <Grid ColumnDefinitions="168,*">
                        <!-- Clicking a lane's label selects its cue, the same selection the tree and
                             the inspector act on — how "+ EFFECT LANE" and DUCK know which cue. -->
                        <Border Grid.Column="0" BorderBrush="{DynamicResource BoothRule}"
                                BorderThickness="0,0,1,0" Padding="8,8,8,0"
                                Background="Transparent"
                                PointerPressed="OnLaneLabelPressed">
                          <Grid RowDefinitions="Auto,*" RowSpacing="5">
                            <TextBlock Grid.Row="0" Classes="mono dim2 small ellipsis"
                                       VerticalAlignment="Center" Text="{Binding Name}" />
                            <WrapPanel Grid.Row="1" Orientation="Horizontal"
                                       IsVisible="{Binding IsEffect}">
                              <Button Classes="icon" Content="{Binding ExpandLabel}"
                                      Click="OnToggleEffectLane"
                                      ToolTip.Tip="Expand this lane into an inline point editor" />
                              <Button Classes="icon" Content="CURVE…" Click="OnOpenLaneEditor"
                                      ToolTip.Tip="Edit exact time/value fields and segment curves" />
                              <Button Classes="icon" Content="ALL" Click="OnSelectAllKeyframes"
                                      IsVisible="{Binding IsExpanded}"
                                      ToolTip.Tip="Select every keyframe (Ctrl+A)" />
                              <Button Classes="icon" Content="COPY" Click="OnCopyKeyframes"
                                      IsVisible="{Binding IsExpanded}"
                                      ToolTip.Tip="Copy selected keyframes (Ctrl+C)" />
                              <Button Classes="icon" Content="PASTE" Click="OnPasteKeyframes"
                                      IsVisible="{Binding IsExpanded}"
                                      ToolTip.Tip="Paste at the playhead (Ctrl+V)" />
                              <Button Classes="icon" Content="DEL" Click="OnDeleteKeyframes"
                                      IsVisible="{Binding IsExpanded}"
                                      IsEnabled="{Binding HasSelectedPoints}"
                                      ToolTip.Tip="Delete selected keyframes" />
                            </WrapPanel>
                          </Grid>
                        </Border>

                        <Panel Grid.Column="1" ClipToBounds="True">
                          <c:ClipLane Clips="{Binding Clips}"
                                      IsEditable="{Binding IsEditable}"
                                      IsVisible="{Binding !IsEffect}"
                                      Gesture="OnClipGesture"
                                      GestureCompleted="OnClipGestureCompleted" />

                          <!-- The editor is arranged over the owning cue's exact span, so its local
                               0..1 X remains cue-relative while the surrounding ruler stays group-time. -->
                          <c:FractionPanel IsVisible="{Binding IsEffect}" ClipToBounds="True">
                            <Grid c:Fraction.Left="{Binding EffectLeft}"
                                  c:Fraction.Width="{Binding EffectWidth}"
                                  c:Fraction.Height="1">
                              <c:WaveformGraph Peaks="{Binding Peaks}"
                                               IsVisible="{Binding HasWaveform}"
                                               IsHitTestVisible="False"
                                               ShowMarkers="False"
                                               Opacity="0.28"
                                               WaveBrush="{DynamicResource BoothInk2}" />
                              <c:EnvelopeGraph Points="{Binding Shape}"
                                               IsVisible="{Binding !IsExpanded}"
                                               IsHitTestVisible="False"
                                               Stroke="{DynamicResource GelAmber}"
                                               StrokeThickness="1.4" Margin="0,4" />
                              <c:CurveCanvas Points="{Binding Points}" Shape="{Binding Shape}"
                                             Tangents="{Binding Tangents}"
                                             IsVisible="{Binding IsExpanded}"
                                             Gesture="OnLaneGesture"
                                             GestureCompleted="OnLaneGestureCompleted"
                                             SelectAllRequested="OnCanvasSelectAllKeyframes"
                                             CopyRequested="OnCanvasCopyKeyframes"
                                             PasteRequested="OnCanvasPasteKeyframes" />
                            </Grid>
                          </c:FractionPanel>
                        </Panel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- the playhead sits above the lanes and starts after the label column -->
              <Grid ColumnDefinitions="168,*" IsHitTestVisible="False">
                <c:FractionPanel Grid.Column="1">
                  <Border Width="1" Background="{DynamicResource GelAmber}"
                          c:Fraction.Left="{Binding Playhead}"
                          c:Fraction.Height="1" />
                </c:FractionPanel>
              </Grid>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Panel>
    </DockPanel>
  </c:PanelBox>
</UserControl>
