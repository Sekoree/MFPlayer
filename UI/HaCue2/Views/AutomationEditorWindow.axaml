<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:HaCue2.Controls"
        xmlns:vm="using:HaCue2.ViewModels"
        x:Class="HaCue2.Views.AutomationEditorWindow"
        x:DataType="vm:AutomationEditorViewModel"
        x:CompileBindings="True"
        Title="Automation"
        Width="1040" Height="590" MinWidth="720" MinHeight="420"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BoothBg}" Foreground="{DynamicResource BoothInk}"
        FontSize="{DynamicResource FontSizeBase}">

  <c:PanelBox Header="{Binding Title}" Hint="{Binding Hint}" Margin="7">
    <c:PanelBox.Footer>
      <Border Classes="chain">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
          <CheckBox Grid.Column="0" Content="enabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                    IsEnabled="{Binding CanEdit}" />
          <TextBlock Grid.Column="1" Classes="mono dim3 small" VerticalAlignment="Center"
                     Text="{Binding ViewLabel}" />
          <TextBlock Grid.Column="2" Classes="mono warn small" HorizontalAlignment="Right"
                     VerticalAlignment="Center" Text="{Binding Problem}" />
          <Button Grid.Column="3" Classes="primary tight" Content="DONE" Click="OnDone" />
        </Grid>
      </Border>
    </c:PanelBox.Footer>

    <DockPanel Margin="10,6,10,10">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto"
            ColumnSpacing="5" Margin="0,0,0,7">
        <Button Grid.Column="0" Classes="tight" Content="|◀ KEY" Click="OnPreviousKey" AutomationProperties.Name="Previous keyframe" />
        <Button Grid.Column="1" Classes="tight" Content="KEY ▶|" Click="OnNextKey" AutomationProperties.Name="Next keyframe" />
        <Button Grid.Column="2" Classes="tight primary" Content="＋ KEY" Click="OnAddKey" AutomationProperties.Name="Add keyframe at cursor"
                IsEnabled="{Binding CanEdit}"
                ToolTip.Tip="Add a keyframe at the cursor" />
        <Button Grid.Column="3" Classes="tight" Content="−" Click="OnZoomOut" AutomationProperties.Name="Zoom out" ToolTip.Tip="Zoom out" />
        <Button Grid.Column="4" Classes="tight" Content="+" Click="OnZoomIn" AutomationProperties.Name="Zoom in" ToolTip.Tip="Zoom in" />
        <ComboBox Grid.Column="5" Width="78" ItemsSource="{Binding SnapTimeOptions}"
                  AutomationProperties.Name="Time snap in milliseconds"
                  SelectedItem="{Binding SnapTimeMs, Mode=TwoWay}"
                  ToolTip.Tip="Time snap in milliseconds; Alt bypasses snap while dragging" />
        <Slider Grid.Column="6" AutomationProperties.Name="Playhead position"
                Minimum="0" Maximum="{Binding DurationMs}"
                Value="{Binding CursorMs, Mode=TwoWay}" />
        <TextBlock Grid.Column="7" Classes="mono small" VerticalAlignment="Center"
                   MinWidth="82" Text="{Binding CursorLabel}" />
        <Button Grid.Column="8" Classes="tight" Content="SEEK" Click="OnSeek" AutomationProperties.Name="Seek this cue to the cursor"
                ToolTip.Tip="Seek this cue when it is currently sounding" />
        <Button Grid.Column="9" Classes="tight" Content="FIT" Click="OnFit" AutomationProperties.Name="Fit the whole cue in view" />
      </Grid>

      <Grid DockPanel.Dock="Bottom" RowDefinitions="Auto,Auto" Margin="0,7,0,0">
        <ScrollBar Grid.Row="0" Orientation="Horizontal"
                   Minimum="0" Maximum="{Binding ViewMaxStartMs}"
                   ViewportSize="{Binding ViewLengthMs}"
                   Value="{Binding ViewStartMs, Mode=TwoWay}" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5" Margin="0,4,0,0">
          <Button Grid.Column="0" Classes="tight" Content="◀ PAGE" Click="OnPanLeft" AutomationProperties.Name="Page left" />
          <TextBlock Grid.Column="1" Classes="mono dim3 micro" HorizontalAlignment="Center"
                     Text="scroll through the cue; zoom keeps the cursor in place" />
          <Button Grid.Column="2" Classes="tight" Content="PAGE ▶" Click="OnPanRight" AutomationProperties.Name="Page right" />
          <Button Grid.Column="3" Classes="tight" Content="+30 MIN" Click="OnExtend" AutomationProperties.Name="Extend the authoring ruler by 30 minutes"
                  IsVisible="{Binding CanExtend}" ToolTip.Tip="Extend an open-ended cue's authoring ruler" />
        </Grid>
      </Grid>

      <Grid ColumnDefinitions="*,230" RowDefinitions="Auto,*" ColumnSpacing="8">
        <!-- Margin matches the plot surface's insets exactly (1 px border + 5 px padding + the canvas's
             own 6 px margin), so a tick's left border sits over the time it names. Each tick owns one
             quarter of the viewport and is labelled with the time at its LEFT edge - see RulerTicks. -->
        <ItemsControl Grid.Column="0" Grid.Row="0" ItemsSource="{Binding RulerTicks}"
                      IsHitTestVisible="False" Margin="12,0,12,2">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BoothRule}" BorderThickness="1,0,0,0">
                <TextBlock Classes="mono dim3 micro" Text="{Binding .}" Margin="3,0" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Column="0" Grid.Row="1" Background="{DynamicResource BoothPit}"
                BorderBrush="{DynamicResource BoothRule}" BorderThickness="1" Padding="5">
          <c:CurveCanvas AutomationProperties.Name="Absolute-time automation editor"
                         AutomationProperties.HelpText="Click and drag empty space to add a key. Drag keys to edit. Alt bypasses snap, Shift constrains an axis, and Escape cancels a drag."
                         AddOnEmptyPointerPress="True"
                         LogicalNudges="True"
                         RemoveWhenDraggedOffCanvas="False"
                         IsEnabled="{Binding CanEdit}"
                         WaveformPeaks="{Binding WaveformPeaks}"
                         Points="{Binding Points}" Shape="{Binding Shape}" Tangents="{Binding Tangents}"
                         Gesture="OnGesture" GestureCompleted="OnGestureCompleted"
                         GestureCancelled="OnGestureCancelled"
                         CopyRequested="OnCopyPoints" PasteRequested="OnPastePoints"
                         SelectAllRequested="OnSelectAllPoints" />
        </Border>

        <StackPanel Grid.Column="1" Grid.RowSpan="2" Spacing="5">
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Key time">
            <TextBox Text="{Binding PointTime}" IsEnabled="{Binding CanEditSelection}"
                     LostFocus="OnPointTimeCommitted" />
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Property value">
            <TextBox Text="{Binding PointValue}" IsEnabled="{Binding CanEditSelection}"
                     LostFocus="OnPointValueCommitted" />
          </HeaderedContentControl>
          <TextBlock Classes="mono dim3 micro" Margin="10,0" Text="{Binding Unit, StringFormat='unit · {0}'}" />
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Segment after key">
            <ComboBox ItemsSource="{Binding Segments}" SelectedItem="{Binding Segment, Mode=TwoWay}"
                      IsEnabled="{Binding CanEditSelection}" />
          </HeaderedContentControl>
          <Button Classes="block" Content="EDIT CURVE SHAPE…" Click="OnEditSegmentCurve"
                  IsEnabled="{Binding CanEditSelection}"
                  ToolTip.Tip="Edit only the normalized easing between this key and the next" />
          <CheckBox Margin="10,4" Content="hold until next key"
                    IsChecked="{Binding IsHold, Mode=TwoWay}" IsEnabled="{Binding CanEditSelection}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
            <Button Grid.Column="0" Classes="block" Content="COPY" Click="OnCopyPointsClicked" AutomationProperties.Name="Copy selected keyframes" />
            <Button Grid.Column="1" Classes="block" Content="PASTE" Click="OnPastePointsClicked" AutomationProperties.Name="Paste keyframes at cursor"
                    IsEnabled="{Binding CanEdit}" />
          </Grid>
          <!-- Only shown when there is something past the out-point. Absolute time never rescales keys
               when a cue is shortened, so this is the explicit route to the ones the ruler cannot reach. -->
          <TextBlock Classes="mono warn micro" Margin="10,6,10,0" TextWrapping="Wrap"
                     IsVisible="{Binding HasOutOfRangeKeys}" Text="{Binding OutOfRangeLabel}" />
          <Button Classes="block" Content="DELETE KEYS PAST THE END" Click="OnDeleteOutOfRange"
                  AutomationProperties.Name="Delete keyframes past the end of the cue"
                  IsVisible="{Binding HasOutOfRangeKeys}" IsEnabled="{Binding CanEdit}" />
          <Button Classes="block" Content="DELETE SELECTED KEY(S)" Click="OnDelete" AutomationProperties.Name="Delete selected keyframes"
                  IsEnabled="{Binding CanEditSelection}" />
          <TextBlock Classes="mono dim3 small" Margin="10,8" TextWrapping="Wrap"
                     Text="Values before the first key and after the last key hold. A disabled track falls back to the cue's authored property." />
          <TextBlock Classes="mono dim3 micro" Margin="10,0" Text="{Binding WaveformStatus}" />
        </StackPanel>
      </Grid>
    </DockPanel>
  </c:PanelBox>
</Window>
