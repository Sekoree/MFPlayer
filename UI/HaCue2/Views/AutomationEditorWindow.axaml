<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:HaCue2.Controls"
        xmlns:vm="using:HaCue2.ViewModels"
        x:Class="HaCue2.Views.AutomationEditorWindow"
        x:DataType="vm:AutomationEditorViewModel"
        x:CompileBindings="True"
        Title="Automation"
        Width="1040" Height="590" MinWidth="720" MinHeight="420"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BoothBg}" Foreground="{DynamicResource BoothInk}"
        FontSize="{DynamicResource FontSizeBase}">

  <c:PanelBox Header="{Binding Title}" Hint="{Binding Hint}" Margin="7">
    <c:PanelBox.Footer>
      <Border Classes="chain">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
          <CheckBox Grid.Column="0" Content="enabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
          <TextBlock Grid.Column="1" Classes="mono dim3 small" VerticalAlignment="Center"
                     Text="{Binding ViewLabel}" />
          <TextBlock Grid.Column="2" Classes="mono warn small" HorizontalAlignment="Right"
                     VerticalAlignment="Center" Text="{Binding Problem}" />
          <Button Grid.Column="3" Classes="primary tight" Content="DONE" Click="OnDone" />
        </Grid>
      </Border>
    </c:PanelBox.Footer>

    <DockPanel Margin="10,6,10,10">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto"
            ColumnSpacing="5" Margin="0,0,0,7">
        <Button Grid.Column="0" Classes="tight" Content="|◀ KEY" Click="OnPreviousKey" />
        <Button Grid.Column="1" Classes="tight" Content="KEY ▶|" Click="OnNextKey" />
        <Button Grid.Column="2" Classes="tight primary" Content="＋ KEY" Click="OnAddKey"
                ToolTip.Tip="Add a keyframe at the cursor" />
        <Button Grid.Column="3" Classes="tight" Content="−" Click="OnZoomOut" ToolTip.Tip="Zoom out" />
        <Button Grid.Column="4" Classes="tight" Content="+" Click="OnZoomIn" ToolTip.Tip="Zoom in" />
        <Slider Grid.Column="5" Minimum="0" Maximum="{Binding DurationMs}"
                Value="{Binding CursorMs, Mode=TwoWay}" />
        <TextBlock Grid.Column="6" Classes="mono small" VerticalAlignment="Center"
                   MinWidth="82" Text="{Binding CursorLabel}" />
        <Button Grid.Column="7" Classes="tight" Content="SEEK" Click="OnSeek"
                ToolTip.Tip="Seek this cue when it is currently sounding" />
        <Button Grid.Column="8" Classes="tight" Content="FIT" Click="OnFit" />
      </Grid>

      <Grid DockPanel.Dock="Bottom" RowDefinitions="Auto,Auto" Margin="0,7,0,0">
        <ScrollBar Grid.Row="0" Orientation="Horizontal"
                   Minimum="0" Maximum="{Binding ViewMaxStartMs}"
                   ViewportSize="{Binding ViewLengthMs}"
                   Value="{Binding ViewStartMs, Mode=TwoWay}" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5" Margin="0,4,0,0">
          <Button Grid.Column="0" Classes="tight" Content="◀ PAGE" Click="OnPanLeft" />
          <TextBlock Grid.Column="1" Classes="mono dim3 micro" HorizontalAlignment="Center"
                     Text="scroll through the cue; zoom keeps the cursor in place" />
          <Button Grid.Column="2" Classes="tight" Content="PAGE ▶" Click="OnPanRight" />
          <Button Grid.Column="3" Classes="tight" Content="+30 MIN" Click="OnExtend"
                  IsVisible="{Binding CanExtend}" ToolTip.Tip="Extend an open-ended cue's authoring ruler" />
        </Grid>
      </Grid>

      <Grid ColumnDefinitions="*,230" ColumnSpacing="8">
        <Border Grid.Column="0" Background="{DynamicResource BoothPit}"
                BorderBrush="{DynamicResource BoothRule}" BorderThickness="1" Padding="5">
          <c:CurveCanvas AutomationProperties.Name="Absolute-time automation editor"
                         AutomationProperties.HelpText="Double-click to add. Drag a key to change its cue time and property value."
                         RemoveWhenDraggedOffCanvas="False"
                         Points="{Binding Points}" Shape="{Binding Shape}" Tangents="{Binding Tangents}"
                         Gesture="OnGesture" GestureCompleted="OnGestureCompleted"
                         CopyRequested="OnCopyPoints" PasteRequested="OnPastePoints"
                         SelectAllRequested="OnSelectAllPoints" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="5">
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Key time">
            <TextBox Text="{Binding PointTime}" IsEnabled="{Binding HasSelection}"
                     LostFocus="OnPointTimeCommitted" />
          </HeaderedContentControl>
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Property value">
            <TextBox Text="{Binding PointValue}" IsEnabled="{Binding HasSelection}"
                     LostFocus="OnPointValueCommitted" />
          </HeaderedContentControl>
          <TextBlock Classes="mono dim3 micro" Margin="10,0" Text="{Binding Unit, StringFormat='unit · {0}'}" />
          <HeaderedContentControl Theme="{StaticResource FieldTight}" Header="Segment after key">
            <ComboBox ItemsSource="{Binding Segments}" SelectedItem="{Binding Segment, Mode=TwoWay}"
                      IsEnabled="{Binding HasSelection}" />
          </HeaderedContentControl>
          <CheckBox Margin="10,4" Content="hold until next key"
                    IsChecked="{Binding IsHold, Mode=TwoWay}" IsEnabled="{Binding HasSelection}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
            <Button Grid.Column="0" Classes="block" Content="COPY" Click="OnCopyPointsClicked" />
            <Button Grid.Column="1" Classes="block" Content="PASTE" Click="OnPastePointsClicked" />
          </Grid>
          <Button Classes="block" Content="DELETE SELECTED KEY(S)" Click="OnDelete"
                  IsEnabled="{Binding HasSelection}" />
          <TextBlock Classes="mono dim3 small" Margin="10,8" TextWrapping="Wrap"
                     Text="Values before the first key and after the last key hold. A disabled track falls back to the cue's authored property." />
        </StackPanel>
      </Grid>
    </DockPanel>
  </c:PanelBox>
</Window>
