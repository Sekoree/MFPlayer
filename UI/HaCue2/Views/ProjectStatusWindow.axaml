<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:HaCue2.Resources"
        xmlns:c="using:HaCue2.Controls"
        xmlns:vm="using:HaCue2.ViewModels"
        x:Class="HaCue2.Views.ProjectStatusWindow"
        x:DataType="vm:ProjectStatusViewModel"
        x:CompileBindings="True"
        Title="{x:Static res:Strings.StatusHacue2ProjectStatus}"
        Width="1060" Height="560"
        MinWidth="900" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BoothBg}"
        Foreground="{DynamicResource BoothInk}"
        FontSize="{DynamicResource FontSizeBase}">

  <!-- Screen 14, the renamed Preflight. It is a COLLECTOR of the project's errors and warnings, each
       with the fix action attached - missing media, unfed or unpatched logical outputs, absent
       devices, dead jump targets, past schedules. Relink and consolidate live here because they are
       what fixing usually means.

       Severity (register item 25): unpatched-but-fed = error; patched-but-unfed and absent devices =
       warnings, except an output flagged REQUIRED, whose absence is an error. -->

  <DockPanel>

    <Border Classes="titlebar" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Classes="mono" FontWeight="SemiBold" FontSize="11"
                   LetterSpacing="0.45" Text="{x:Static res:Strings.DiagBrand}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="mono dim2" FontSize="11" Margin="14,0,0,0"
                   Text="{Binding Title}" VerticalAlignment="Center" />
        <Button Grid.Column="3" Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.StatusReRunAll}" Click="OnRerun" />
        <Button Grid.Column="4" Theme="{StaticResource ChipButton}" Content="{Binding CopyLabel}"
                Click="OnCopyReport" />
        <Button Grid.Column="5" Theme="{StaticResource ChipButton}" Content="{x:Static res:Strings.TlClose}" Click="OnClose" />
      </Grid>
    </Border>

    <Border Classes="statusbar" DockPanel.Dock="Bottom">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="mono small" Text="{Binding ErrorNote}"
                   Classes.ok="{Binding IsClean}" Classes.err="{Binding !IsClean}" />
        <TextBlock Grid.Column="1" Classes="mono dim2 small" HorizontalAlignment="Center"
                   Text="{Binding DownloadRepairNote}" />
        <TextBlock Grid.Column="2" Classes="mono dim3 small" Text="{Binding HeadlessNote}" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,300" Margin="7" ColumnSpacing="7">

      <c:PanelBox Grid.Column="0" Header="{x:Static res:Strings.StatusChecks}" Hint="{Binding Summary}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource BoothPanel2}"
                  BorderBrush="{DynamicResource BoothRule}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid ColumnDefinitions="180,110,*,80" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.StatusCheck}" />
              <TextBlock Grid.Column="1" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.StatusResult}" />
              <TextBlock Grid.Column="2" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.StatusDetail}" />
              <TextBlock Grid.Column="3" Theme="{StaticResource ColumnHeadText}" Text="{x:Static res:Strings.StatusFix}" />
            </Grid>
          </Border>

          <ListBox Theme="{StaticResource TableRows}" ItemsSource="{Binding Checks}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CheckRow">
                <Grid ColumnDefinitions="180,110,*,80" ColumnSpacing="8" Margin="8,5">
                  <TextBlock Grid.Column="0" Classes="mono small" Text="{Binding Check}" />
                  <TextBlock Grid.Column="1" Classes="mono small" Text="{Binding Result.Text}"
                             Classes.ok="{Binding Result.IsGood}"
                             Classes.warn="{Binding Result.IsWarn}"
                             Classes.err="{Binding Result.IsBad}" />
                  <TextBlock Grid.Column="2" Classes="mono dim3 small ellipsis" Text="{Binding Detail}" />
                  <!-- Every failing row carries its own fix; a status list that only reports is a list
                       the operator has to translate into actions under time pressure. The click takes
                       the operator to the screen that owns the thing - without it the button was
                       decoration, which is worse than no button. -->
                  <Button Grid.Column="3" Theme="{StaticResource LinkButton}"
                          Foreground="{DynamicResource GelCongo}"
                          IsVisible="{Binding CanFix}" Content="{Binding Fix}"
                          Tag="{Binding Destination}" Click="OnFix" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </c:PanelBox>

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="7">

        <c:PanelBox Grid.Row="0" Header="{x:Static res:Strings.StatusRelink}" Hint="for the missing file">
          <StackPanel Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.StatusMissing}">
              <TextBox Classes="ro" Text="{Binding MissingFile}" />
            </HeaderedContentControl>
            <ContentControl Theme="{StaticResource FieldWide}">
              <Button Classes="block" Content="{x:Static res:Strings.StatusSearchByFilenameUnderMedia}" Click="OnRelinkRoot" />
            </ContentControl>
            <ContentControl Theme="{StaticResource FieldWide}">
              <Button Classes="block" Content="{x:Static res:Strings.StatusPickFileManually}" Click="OnRelinkOne" />
            </ContentControl>
            <TextBlock Margin="10,4,10,0" FontSize="10.5" Classes="dim3" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.StatusMatchesByNameDurationA}" />
          </StackPanel>
        </c:PanelBox>

        <c:PanelBox Grid.Row="1" Header="{x:Static res:Strings.StatusConsolidate}">
          <StackPanel Margin="0,6,0,8">
            <HeaderedContentControl Theme="{StaticResource Field}" Header="{x:Static res:Strings.StatusInto}">
              <TextBox Text="{Binding ConsolidateInto}" />
            </HeaderedContentControl>
            <CheckBox Margin="10,3" IsChecked="{Binding CopyMedia}"
                      Content="{x:Static res:Strings.StatusCopyMediaRewriteToRelative}" />
            <CheckBox Margin="10,3" IsChecked="{Binding IncludeReport}"
                      Content="{x:Static res:Strings.StatusIncludeProjectThisReport}" />
            <CheckBox Margin="10,3" IsChecked="{Binding ZipWhenDone}" Content="{x:Static res:Strings.StatusZipWhenDone}" />
            <ContentControl Theme="{StaticResource FieldWide}">
              <Button Classes="primary block" Content="{x:Static res:Strings.StatusConsolidate2}" Click="OnConsolidate"
                      IsEnabled="{Binding CanEdit}" />
            </ContentControl>
            <!-- Consolidate must report what it could NOT copy rather than quietly producing a
                 project that half-works at the venue. -->
            <TextBlock Margin="10,4,10,0" FontSize="10.5" Classes="dim3" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.StatusAnythingThatCannotBeCopied}" />
            <TextBlock Margin="10,4,10,0" FontSize="10.5" Classes="mono dim2" TextWrapping="Wrap"
                       Text="{Binding ConsolidateNote}" />
          </StackPanel>
        </c:PanelBox>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
