<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HaCue2.Controls"
             xmlns:vm="using:HaCue2.ViewModels"
             x:Class="HaCue2.Controls.PlacementCanvas"
             x:DataType="c:PlacementCanvas"
             x:CompileBindings="True">

  <!-- The canvas every fraction-positioned box is drawn on: composition layers (screen 09), the
       inspector's placement preview, and both halves of the mapping editor (screen 10). One control so
       the drag, the resize handles and the arrow-key nudge behave identically wherever a box appears —
       an operator who learns the gesture on a composition must find it true on a mapping section. -->

  <!-- The transparent outer border owns the work-area hit test. When overflow is enabled the real
       composition is inset inside it, leaving somewhere visible to drag a box beyond the frame. -->
  <Border Background="Transparent" ClipToBounds="True">
    <c:PlacementWorkArea IsExpanded="{Binding AllowOutside, RelativeSource={RelativeSource AncestorType=c:PlacementCanvas}}">
      <Border Classes="vidcanvas"
              ClipToBounds="{Binding !AllowOutside, RelativeSource={RelativeSource AncestorType=c:PlacementCanvas}}">
        <Panel>
          <c:CanvasGrid IsVisible="{Binding ShowGrid, RelativeSource={RelativeSource AncestorType=c:PlacementCanvas}}" />

          <ItemsControl ItemsSource="{Binding Boxes, RelativeSource={RelativeSource AncestorType=c:PlacementCanvas}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><c:FractionPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerTheme>
          <ControlTheme TargetType="ContentPresenter" x:DataType="vm:PlacementBox">
            <Setter Property="(c:Fraction.Left)" Value="{Binding Left}" />
            <Setter Property="(c:Fraction.Top)" Value="{Binding Top}" />
            <Setter Property="(c:Fraction.Width)" Value="{Binding Width}" />
            <Setter Property="(c:Fraction.Height)" Value="{Binding Height}" />
          </ControlTheme>
        </ItemsControl.ItemContainerTheme>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlacementBox">
            <Border Classes="placement"
                    Classes.a="{Binding !IsSecondary}"
                    Classes.b="{Binding IsSecondary}"
                    Classes.sel="{Binding IsSelected}">
              <Panel>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />

                <!-- The eight grips, on the SELECTED box only. The drag already worked by edge
                     proximity; nothing said so, and a resize an operator cannot see is a resize they
                     find by accident while trying to move the layer. -->
                <Panel IsVisible="{Binding IsSelected}">
                  <Rectangle Classes="grip" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <Rectangle Classes="grip" HorizontalAlignment="Center" VerticalAlignment="Top" />
                  <Rectangle Classes="grip" HorizontalAlignment="Right" VerticalAlignment="Top" />
                  <Rectangle Classes="grip" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  <Rectangle Classes="grip" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <Rectangle Classes="grip" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                  <Rectangle Classes="grip" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                  <Rectangle Classes="grip" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Panel>
              </Panel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Populated only while a snapped drag is active. Last in paint order so a guide remains
               legible through overlapping translucent placement boxes. -->
          <Canvas x:Name="GuideLayer" IsHitTestVisible="False" />
        </Panel>
      </Border>
    </c:PlacementWorkArea>
  </Border>
</UserControl>
