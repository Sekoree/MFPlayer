<Project Sdk="Microsoft.NET.Sdk">

    <!-- HaCue2 - the cue player leaving HaPlay and becoming its own application.
         Design source of truth: Plans/MockUps/HaCue2/HaCue2 - UI design, all screens.html (rev 3)
         and the 30-item decision register in Plans/HaCue-Extraction-And-Project-Audio-Patch-Plan.md.

         STATUS: the shell binds to the PROJECT MODEL (HaCue2.Core), to MACHINE FACTS
         (HaCue2.Machine - device enumeration, media probing) and to the ENGINE (HaCue2.Engine). Views are
         projected from a real HaCueProject and edited through the undo journal; anything that is a
         runtime fact rather than a document one - which cues are sounding, meters, bay counters -
         comes from `Session/ShowRuntime`, the explicit stand-in for what ShowSession will supply.
         Phase 5 replaces that seam; until then a framework ProjectReference here would be premature,
         and the arch-test UiAllowed map records the allow-list to keep it that way. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RootNamespace>HaCue2</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <!-- Infrastructure base ONLY. The visible controls all carry a from-scratch HaCue2 ControlTheme
             (Themes/Controls/*.axaml) that overrides whatever Simple would have supplied; Simple is kept
             underneath for the non-visual plumbing a theme must provide - PopupRoot, OverlayPopupHost,
             AdornerLayer, EmbeddableControlRoot, WindowNotificationManager - which have no design in the
             mockup and would leave popups/flyouts unrendered if absent. It also means a control added
             later without a HaCue2 theme degrades to "plain" rather than to "invisible", which is the
             failure mode that cost a day in the first extraction attempt. -->
        <PackageReference Include="Avalonia.Themes.Simple"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <!-- The cue tree. Neither of the package's own theme files is included: Fluent.axaml resolves
             Fluent-only palette colours through StaticResource on SolidColorBrush, which THROWS rather
             than deferring under SimpleTheme (see HaPlay.Tests/SimpleThemeTreeDataGridResourceTests).
             Themes/Controls/Tree.axaml restates the templates on the booth-dark palette instead. -->
        <PackageReference Include="TreeDataGrid.Avalonia"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <!-- Register item 27: the Diagnostics tail is a reader over the MEL pipeline, not a second
             event-collection system. The app installs one factory and the framework logs into it. -->
        <PackageReference Include="Microsoft.Extensions.Logging"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HaCue2.Core\HaCue2.Core.csproj"/>
        <!-- Machine facts: audio-device enumeration and media probing. Still NO engine - the shell
             projects a document and asks the machine what it has; it does not run a show yet. -->
        <ProjectReference Include="..\HaCue2.Machine\HaCue2.Machine.csproj"/>
        <!-- Phase 5: the running show. The views still see it only through Session/ShowRuntime - the
             seam does not change, its contents stop being invented. -->
        <ProjectReference Include="..\HaCue2.Engine\HaCue2.Engine.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HaCue2.Tests" />
        <Compile Include="../Shared/PseudoLocalization.cs" Link="Resources/PseudoLocalization.cs" />
    </ItemGroup>

</Project>
