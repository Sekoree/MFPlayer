<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- FFmpeg.AutoGen 9.0.0 is built from the vendored source in External/FFmpeg.AutoGen; upstream has
         not published an FFmpeg 9 release yet. Refresh with:
             dotnet pack External/FFmpeg.AutoGen/FFmpeg.AutoGen/FFmpeg.AutoGen.csproj -c Release -o packages
         Drop this source and bump the version in Directory.Packages.props once 9.x lands on nuget.org. -->
    <add key="local" value="./packages" />
  </packageSources>
</configuration>
